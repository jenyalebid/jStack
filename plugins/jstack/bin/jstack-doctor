#!/usr/bin/env python3
"""jstack-doctor — does this machine have a working jStack, and if not, which part?

A fresh install is six steps across two surfaces: a marketplace install, plugin
config, an agent workspace, `/jstack:install-rules`, a scheduler daemon (the
Hub's own service where there is a Hub, `jstack-scheduler install` where there
is not), and a python that can import what the daemon needs. Every one of them fails in a
way that is invisible from inside a session — a PATH that resolves no `claude`,
an `agent_root` holding nothing the resolver accepts (so every seat resolves to
nobody and the timeline writes nothing), rules symlinked into a plugin version
that was reaped seven days later. Each is observable in well under a second, and
without this tool the only way to find one is to hit it.

Three grades, because two would collapse the distinction that matters most on a
fresh install. **fail** is something jStack cannot work without. **warn** is a
capability that will be honestly absent until the thing arrives — no rules
installed yet, no scheduler daemon, no timeline rows. **ok** is ok. The exit
status is the worst grade: 0 / 1 / 2, so a script can gate on it and a person can
read it.

    jstack-doctor            the table
    jstack-doctor --json     the same results as JSON, for a test harness

Every check reads the SAME seam the tools read at runtime — `root.py` for paths,
`scheduler.spawn` for the binary search path, `hooks.json` for the hooks — so a
green doctor and a working install are the same fact rather than two things that
usually agree. A check that cannot observe its subject says so; it never reports
a state it had to guess. A check that raises is a check that FAILS: a validator
that hides a broken machine is worse than no validator.

Self-contained python3 stdlib. Imports two siblings out of the plugin root, both
stdlib-only, for the same reason `jstack-scheduler` does: asking the module that
owns an answer beats restating it here and being wrong the day it changes.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import sqlite3
import subprocess
import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT))

_BOOTSTRAP_ERROR = None
try:
    import root  # noqa: E402
    from scheduler import config as sched_config  # noqa: E402
    from scheduler import spawn  # noqa: E402
except (ImportError, OSError, RuntimeError, ValueError) as error:
    # Bad root/config must still produce the documented failed JSON report.
    _BOOTSTRAP_ERROR = f"{type(error).__name__}: {error}"

OK, WARN, FAIL = "ok", "warn", "fail"
_RANK = {OK: 0, WARN: 1, FAIL: 2}

# Where the two things a plugin cannot ship have to land, because Claude Code
# loads them from user scope only. `/jstack:install-rules` puts them there.
USER_CLAUDE = Path.home() / ".claude"


def _check(name: str, grade: str, detail: str, hint: str = "") -> dict:
    return {"name": name, "grade": grade, "detail": detail, "hint": hint}


def _which(binary: str) -> "str|None":
    """Resolved against the SPAWN path, not this shell's.

    A binary only the interactive shell can see is precisely the failure this
    tool exists to catch: launchd hands a daemon a stripped PATH, so the
    scheduler's children reach `claude` through `spawn_dirs` or not at all.
    """
    return shutil.which(binary, path=spawn.spawn_path())


def _version(argv: list) -> str:
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=15)
        out = r.stdout or r.stderr
        return out.strip().splitlines()[0] if out.strip() else ""
    except (OSError, subprocess.SubprocessError, IndexError):
        return ""


def _writable(d: Path) -> bool:
    """Can this path be written when the tools first need it?

    Writability by TRYING it, because os.access lies under ACLs and on read-only
    mounts — but never by creating the directory being asked about. A doctor
    that mkdir's its subject reports on the machine it just changed: the first
    run of this check created three empty dirs at the root and then called them
    healthy. So an absent dir is answered by probing the nearest ancestor that
    does exist, which is the real question anyway — every one of these dirs is
    created on first use, and absent-but-creatable is a normal fresh install.
    """
    probe_dir = d
    while not probe_dir.exists() and probe_dir != probe_dir.parent:
        probe_dir = probe_dir.parent
    if not probe_dir.is_dir():
        return False
    probe = probe_dir / ".jstack-doctor-probe"
    try:
        probe.write_text("")
        probe.unlink()
        return True
    except OSError:
        return False


# ── the checks ──


def check_python() -> dict:
    """3.9 is the floor: `zoneinfo` (the scheduler's whole notion of wall-clock
    time) and `str.removeprefix` both arrive there."""
    v = sys.version_info
    if v < (3, 9):
        return _check("python", FAIL,
                      f"{v.major}.{v.minor} at {sys.executable} — needs 3.9 or newer",
                      "install a newer python3 and re-run; zoneinfo (3.9) is not optional "
                      "for the scheduler")
    return _check("python", OK, f"{v.major}.{v.minor}.{v.micro} ({sys.executable})")


def check_claude() -> dict:
    path = spawn.claude_resolvable()
    native = shutil.which("codex", path=spawn.spawn_path())
    if not path and native:
        # Even --version initializes Codex's home/cache. Discovery alone
        # preserves the doctor's read-only contract.
        return _check("claude", OK, f"Codex-only install: {native}")
    if not path:
        return _check("claude", FAIL, "not on the spawn path",
                      f"install Claude Code or Codex, or add its dir to `spawn_dirs` in "
                      f"{sched_config.INSTALL_FILE} — the search path is: "
                      f"{spawn.spawn_path()}")
    return _check("claude", OK,
                  f"{path} — {_version([path, '--version']) or 'version unknown'}")


def check_git() -> dict:
    """A warning, not a failure: the timeline, the scheduler and the hooks all
    work without git. Only the delivery skills (push, day-audit, session-files)
    need it, and an install that never commits is a legitimate install."""
    path = _which("git")
    if not path:
        return _check("git", WARN, "not on the spawn path",
                      "install git — /jstack:push, /jstack:day-audit and session-files "
                      "cannot run without it; everything else can")
    return _check("git", OK, f"{path} — {_version([path, '--version']) or 'version unknown'}")


def check_dateutil() -> dict:
    """The package's one third-party dependency, needed by RECURRING jobs and
    nothing else — so its absence is a warning for the same reason
    `jstack-scheduler install` refuses to treat it as fatal."""
    try:
        import dateutil  # noqa: F401
    except ImportError:
        return _check("dateutil", WARN, f"{sys.executable} cannot import dateutil",
                      f"{sys.executable} -m pip install python-dateutil — recurring "
                      f"jobs will not book without it; one-shot wakes work fine")
    return _check("dateutil", OK, "importable")


def check_root() -> dict:
    """The one declaration everything else derives from.

    Reports where each of the six dirs actually lands, and fails on the two
    states that are silently wrong rather than loudly broken: a root that
    resolves inside the shipping checkout (root.py raises — caught here so the
    message arrives now instead of at the first write), and a root nobody can
    write to.
    """
    declared = os.environ.get("JSTACK_ROOT")
    r = root.root()
    source = "$JSTACK_ROOT" if declared else "$HOME (no root declared)"
    dirs = {
        "Agents": root.agents_dir(),
        "Systems": root.systems_dir(),
        "Config": root.config_dir(),
        "State": root.state_dir(),
        "Logs": root.logs_dir(),
        "Credentials": root.credentials_dir(),
    }
    unwritable = [n for n, d in dirs.items() if not _writable(d)]
    if unwritable:
        return _check("root", FAIL, f"{r} (from {source}) — cannot write: "
                                    f"{', '.join(unwritable)}",
                      "check ownership and permissions, or declare a JSTACK_ROOT "
                      "somewhere writable")
    # Absent is not a problem — every one of these is created on first use — but
    # it IS the difference between a stack that has run and one that has not, so
    # it gets said rather than flattened into a list of six paths.
    listing = ", ".join(f"{n}={d}" + ("" if d.is_dir() else " (not yet created)")
                        for n, d in dirs.items())
    return _check("root", OK, f"{r} (from {source}) — {listing}")


def check_agents() -> dict:
    """0 agents is the failure that reads as the tools being broken.

    Every seat-aware tool resolves through `root.agents()`; with an empty
    agents dir they all succeed against nobody — log_event writes an entry for
    an agent that does not exist, the session-end engine reviews nothing. So
    the names get printed: "found 3: …" is the only form of this answer that
    lets a reader tell a working install from a plausible one.
    """
    d = root.agents_dir()
    if not d.is_dir():
        return _check("agents", FAIL, f"no agents dir at {d}",
                      f"create {d}/<Name>/CLAUDE.md, or point `agent_root` at the "
                      f"directory that already holds your workspaces")
    found = root.agents()
    if not found:
        return _check("agents", FAIL, f"{d} exists but holds no agents",
                      "an agent is a directory here with a CLAUDE.md, or with one "
                      "immediate subdirectory that has one (Agents/<id>/<seat>/CLAUDE.md)")
    return _check("agents", OK, f"{len(found)} in {d}: {', '.join(sorted(found))}")


def check_timeline() -> dict:
    d = root.timeline_dir()
    db = d / "timeline.db"
    if not _writable(d):
        return _check("timeline", FAIL, f"cannot write {d}",
                      "log_event, msg and the session-end engine all write here")
    if not db.exists():
        # OK, not WARN. The directory is writable — checked above — so the only
        # thing missing is a file `log_event` creates on first use, and nothing
        # is broken until it cannot. A check that grades the state it calls
        # expected as a warning teaches the reader to skim warnings, which is
        # the one habit that makes the real ones invisible: a fresh install
        # ended on three warnings, and this one had no action behind it.
        return _check("timeline", OK, f"{db} — not created yet",
                      "normal until the first `log_event`, which creates it")
    try:
        with sqlite3.connect(f"file:{db}?mode=ro", uri=True) as conn:
            rows = conn.execute("SELECT count(*) FROM entries").fetchone()[0]
    except sqlite3.Error as e:
        return _check("timeline", FAIL, f"{db} is not a readable timeline: {e}",
                      "move it aside and let log_event recreate it")
    return _check("timeline", OK, f"{db} — {rows} entr{'y' if rows == 1 else 'ies'}")


def _stage_report(stage: str, dest: Path) -> "tuple[int, int, list, list]":
    """(installed, staged, missing names, broken link names) for one stage dir.

    A broken link is the version-cache rot: `/jstack:install-rules` run against
    a versioned plugin-cache path instead of a checkout leaves links that work
    until the old version is reaped, then point at nothing. The file still
    appears in `ls`; only following it shows the failure.
    """
    staged = sorted(p.name for p in (PLUGIN_ROOT / stage).glob("*.md"))
    installed, missing, broken = 0, [], []
    for name in staged:
        target = dest / name
        if target.is_symlink() and not target.exists():
            broken.append(name)
        elif target.exists():
            installed += 1
        else:
            missing.append(name)
    return installed, len(staged), missing, broken


def _stage_check(name: str, stage: str, dest: Path, what: str) -> dict:
    installed, staged, missing, broken = _stage_report(stage, dest)
    if broken:
        return _check(name, FAIL,
                      f"{len(broken)} dead symlink(s) in {dest}: {', '.join(broken)}",
                      "these point at a plugin version that no longer exists — re-run "
                      "/jstack:install-rules --force, and link to the CHECKOUT, not a "
                      "versioned cache path")
    if installed == 0:
        return _check(name, WARN, f"none of {staged} {what} installed in {dest}",
                      "run /jstack:install-rules — a plugin cannot deliver these, "
                      f"Claude Code loads {what} from user scope only")
    if missing:
        return _check(name, WARN, f"{installed}/{staged} in {dest} — "
                                  f"missing: {', '.join(missing)}",
                      "run /jstack:install-rules to link the rest")
    return _check(name, OK, f"{installed}/{staged} {what} in {dest}")


def check_rules() -> dict:
    return _stage_check("rules", "rules-stage", USER_CLAUDE / "rules", "rules")


def check_commands() -> dict:
    return _stage_check("commands", "commands-stage", USER_CLAUDE / "commands",
                        "bare commands")


def check_hooks() -> dict:
    """Every command in hooks.json resolves to a file that exists and can run.

    A hook whose script is missing is not a quiet degradation: Claude Code
    reports the failure per event, so a single bad entry turns every session
    start, every edit and every stop into an error the user cannot place.
    """
    manifest = PLUGIN_ROOT / "hooks" / "hooks.json"
    try:
        spec = json.loads(manifest.read_text())
    except (OSError, json.JSONDecodeError) as e:
        return _check("hooks", FAIL, f"{manifest} unreadable: {e}",
                      "the plugin install is incomplete — reinstall it")
    commands = [h.get("command", "")
                for group in (spec.get("hooks") or {}).values()
                for entry in group
                for h in (entry.get("hooks") or [])]
    bad = []
    for cmd in commands:
        # A hook command is a command line, not a path: seven of these carry a
        # subcommand, and testing the whole string as a filename reported every
        # one of them missing on a machine where the file was present and
        # executable. Split the template before substituting, so a plugin root
        # with a space in it stays one token.
        argv = shlex.split(cmd) or [cmd]
        p = Path(argv[0].replace("${CLAUDE_PLUGIN_ROOT}", str(PLUGIN_ROOT)))
        if not p.is_file():
            bad.append(f"{p.name} (missing)")
        elif not os.access(p, os.X_OK):
            bad.append(f"{p.name} (not executable)")
    if bad:
        return _check("hooks", FAIL, f"{len(bad)}/{len(commands)} broken: {', '.join(bad)}",
                      f"chmod +x the scripts in {PLUGIN_ROOT}/hooks, or reinstall the plugin")
    return _check("hooks", OK, f"{len(commands)} hook commands, all present and executable")


def _host_resolver():
    """`hooks/_host.py`, by path — the resolver the hooks themselves import."""
    import importlib.util  # noqa: PLC0415
    spec = importlib.util.spec_from_file_location(
        "_jstack_doctor_host", PLUGIN_ROOT / "hooks" / "_host.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def check_host() -> dict:
    """Can the INSTALLED plugin's hooks reach the host, and run it?

    `hooks` proves the scripts are there; this proves they can do anything.
    Nine hooks import the host package and exit 0 when they cannot, so a
    machine whose installed copy finds no host has its plan, environment,
    attention, context-ceiling and codex-carry hooks silently switched off —
    which is every installed machine before `_host.py` existed, since the
    cache copy has no `host/` beside it. Resolved from the ledger's
    `installPath` with the resolver the hooks import, so this grades the copy
    Claude Code runs, not the copy the doctor happens to be.
    """
    marketplace, record = _installed_jstack()
    if not marketplace:
        return _check("host", OK, "jstack is not installed from a marketplace — "
                      "no installed copy whose hooks need a host")
    resolver = _host_resolver()
    install = Path(record.get("installPath") or PLUGIN_ROOT)
    checkout = resolver.find_checkout(install)
    try:
        recorded = resolver.reason_path().read_text().strip()
    except OSError:
        recorded = ""
    last = f"; last failed load: {recorded}" if recorded else ""
    if checkout is None:
        return _check("host", FAIL,
                      f"the installed plugin at {install} reaches no host checkout — "
                      "every host-importing hook exits silently" + last,
                      f"register the marketplace at a checkout: `claude plugin "
                      f"marketplace add <checkout>` (the `{marketplace}` entry in "
                      "~/.claude/plugins/known_marketplaces.json)")
    floor = resolver.requires_python(checkout)
    venv = checkout / resolver.VENV_PYTHON
    if not venv.is_file():
        # The hooks run `python3` off the spawn PATH, and without the venv
        # there is nothing to re-exec under when that one is too old.
        py = _which("python3")
        raw = _version([py, "--version"]).split()[-1] if py else ""
        have = tuple(int(p) for p in raw.split(".")[:len(floor)] if p.isdigit())
        if floor and (not have or have < floor):
            return _check("host", FAIL,
                          f"host at {checkout / 'host'}, but python3 on the spawn "
                          f"path is {raw or 'absent'} and the host needs "
                          f">={'.'.join(map(str, floor))}, with no {venv} to "
                          "re-exec under" + last,
                          f"create the venv: python3.11+ -m venv {venv.parent.parent}")
    if recorded:
        return _check("host", WARN, f"host at {checkout / 'host'}{last}",
                      "the line clears on the next successful load; if it "
                      "persists, run the named hook by hand")
    return _check("host", OK, f"installed hooks reach the host at {checkout / 'host'}")


def _load_engine(path: Path):
    """Import an extensionless bin/ script as a module.

    Loaded rather than shelled out to because the question is what the engine's
    OWN config resolution answers — re-deriving it here would be a second copy
    that can agree while the engine disagrees.
    """
    import importlib.util
    from importlib.machinery import SourceFileLoader
    name = f"_doctor_{path.name.replace('-', '_')}"
    spec = importlib.util.spec_from_loader(name, SourceFileLoader(name, str(path)))
    mod = importlib.util.module_from_spec(spec)
    # A doctor reports; it does not write. Executing the engine imports its
    # dependencies, and a __pycache__ left behind is a path this run created.
    prior, sys.dont_write_bytecode = sys.dont_write_bytecode, True
    try:
        spec.loader.exec_module(mod)
    finally:
        sys.dont_write_bytecode = prior
    return mod


def check_review() -> dict:
    """The session-end engine resolves THIS machine's sessions to an agent.

    `hooks` already proves the SessionEnd hook exists and runs; it cannot prove
    the engine behind it does anything. The engine skips a session it cannot
    attribute, and "no agent match" is also the correct log line for a genuinely
    unowned session — so an install whose agent_root pointed nowhere skipped
    every session in a row and looked, from every other check here, healthy.
    That is the failure this check exists for: reviews stop, nothing says so.
    """
    engine = PLUGIN_ROOT / "bin" / "session-review-spawn"
    if not engine.is_file():
        return _check("review", FAIL, f"no engine at {engine}",
                      "reinstall the plugin — SessionEnd has nothing to call")
    try:
        mod = _load_engine(engine)
    except Exception as e:  # noqa: BLE001 — a doctor never dies on a check
        return _check("review", FAIL, f"engine will not load: {e}",
                      f"run {engine} by hand to see the traceback")

    action = mod.CFG.get("session_end_action")
    if action == "off":
        return _check("review", OK, "session_end_action: off — reviews disabled by config")
    if os.environ.get("JSTACK_REVIEW_DISABLED") == "1":
        return _check("review", WARN, "JSTACK_REVIEW_DISABLED=1 — every session end is a no-op",
                      "unset it to let sessions write their own timeline entry")

    agent_root = mod.CFG["agent_root"]
    agents = mod.reviewable_agents(agent_root)
    if not agents:
        return _check("review", FAIL,
                      f"engine resolves agent_root to {agent_root} — no agents there",
                      "set `agent_root` in ~/.claude/jstack/review.json, or let it "
                      "derive from $JSTACK_ROOT; until then every session end is skipped")
    if agent_root != root.agents_dir():
        return _check("review", WARN,
                      f"engine reads {agent_root}, the rest of the stack reads "
                      f"{root.agents_dir()}",
                      "drop `agent_root` from review.json unless the split is deliberate")
    return _check("review", OK,
                  f"{action}: {len(agents)} agent(s) resolvable from {agent_root}")


def check_bin() -> dict:
    """The adapters are only reachable if their dir is on PATH.

    This one asks the SHELL's PATH rather than the spawn path, and deliberately:
    these are the tools an agent invokes by bare name from inside a session, so
    the shell's answer is the one that decides whether `log_event` works.
    """
    bin_dir = PLUGIN_ROOT / "bin"
    adapters = sorted(p.name for p in bin_dir.iterdir()
                      if p.is_file() and os.access(p, os.X_OK))
    on_path = shutil.which("log_event")
    if not on_path:
        return _check("bin", WARN, f"{bin_dir} is not on PATH ({len(adapters)} adapters)",
                      f"add it to PATH — without it `log_event`, `msg`, `schedule-self` "
                      f"and {len(adapters) - 3} others are unreachable by name")
    resolved = Path(on_path).resolve()
    if resolved != (bin_dir / "log_event").resolve():
        return _check("bin", WARN, f"`log_event` on PATH resolves to {resolved}, "
                                   f"not {bin_dir}/log_event",
                      "another install owns these names — put this plugin's bin dir "
                      "earlier in PATH if that is not what you want")
    return _check("bin", OK, f"{bin_dir} on PATH — {len(adapters)} adapters")


def check_config() -> dict:
    """Both config files are optional; being present-but-unparseable is not.

    A JSONDecodeError here is the worst kind of silent failure: `install()` and
    `load_defaults()` both swallow it and fall back to built-ins, so a typo in
    scheduler.json costs the machine its whole config with no message anywhere.
    """
    broken = []
    for label, path in (("scheduler.json", sched_config.INSTALL_FILE),
                        ("schedule.json", sched_config.SCHEDULE_FILE)):
        if not path.exists():
            continue
        try:
            json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as e:
            broken.append(f"{label}: {e}")
    if broken:
        return _check("config", FAIL, "; ".join(broken),
                      "both readers fall back to built-ins on a parse error and say "
                      "nothing — fix the file, the defaults are not what you configured")
    present = [label for label, path in (("scheduler.json", sched_config.INSTALL_FILE),
                                         ("schedule.json", sched_config.SCHEDULE_FILE))
               if path.exists()]
    where = sched_config.CONFIG_DIR
    if not present:
        return _check("config", OK, f"none in {where} — built-in defaults, "
                                    f"timezone {sched_config.DEFAULT_TZ}")
    return _check("config", OK, f"{', '.join(present)} in {where}, valid — "
                                f"timezone {sched_config.DEFAULT_TZ}")


#: The two markers `jstack-scheduler status` prints, which is how this check
#: learns which of the daemon's two shapes the machine runs without owning a
#: second copy of the answer. `host/tests/test_hub_scheduler.py` reads both
#: files and fails if either side renames its half.
HUB_SERVICE = "live.jstack.hub.scheduler"
LEGACY_LINE = "legacy:"


def check_scheduler() -> dict:
    """Booking a job and running one are different facts.

    On a fresh install the registry accepts a job, `list` shows it, and the hour
    passes in silence because nothing is running to fire it. So this reports the
    daemon, not the CLI — and separates "no daemon installed" (a warning: wakes
    are the only thing that stop working) from "installed but not answering" (a
    failure: something that was supposed to be running is not).

    Which daemon depends on the machine, and `jstack-scheduler status` is what
    knows: on a Hub the sealed service the Hub registers, otherwise the
    LaunchAgent or unit the tool wrote. A pre-Hub LaunchAgent surviving beside a
    Hub is the one case graded harder than the tool's own exit status — see
    below.
    """
    tool = PLUGIN_ROOT / "bin" / "jstack-scheduler"
    try:
        p = subprocess.run([sys.executable, str(tool), "status"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        return _check("scheduler", FAIL, f"cannot run jstack-scheduler status: {e}")
    summary = "; ".join(line.strip() for line in p.stdout.splitlines() if line.strip())
    hub = HUB_SERVICE in p.stdout
    if hub and any(line.startswith(LEGACY_LINE) for line in p.stdout.splitlines()):
        # Not a warning. Two definitions for one daemon is two rows in Login
        # Items — the Hub's, and one named after whatever interpreter the old
        # plist points at — and two processes binding the daemon's single port,
        # where the loser dies with EADDRINUSE and stays dead. An upgraded Mac
        # is exactly where this is found, and nothing self-corrects it.
        return _check("scheduler", FAIL,
                      f"a pre-Hub scheduler LaunchAgent survives beside the Hub's own "
                      f"service — {summary}",
                      "jstack-scheduler uninstall — it boots the legacy job out and "
                      "removes its plist; the Hub's own service is untouched")
    if p.returncode == 3:
        if hub:
            return _check("scheduler", WARN,
                          f"the Hub registers no scheduler service on this machine — {summary}",
                          "re-run install.sh without --no-scheduler; the Hub's installer "
                          "takes --scheduler-root and registers the service")
        # `status` prints a note here when something IS serving the API port
        # under a label this tool did not write — a machine running its own
        # hand-rolled daemon is a working machine, and dropping that line would
        # turn the one fact that distinguishes it from a dead install into
        # "jobs never fire", which would simply be false.
        return _check("scheduler", WARN,
                      f"no daemon under the default label — {summary}",
                      "jstack-scheduler install, unless another label already owns it")
    if p.returncode == 2:
        return _check("scheduler", WARN, f"unsupported platform for the service manager: "
                                         f"{(p.stderr or '').strip().splitlines()[0]}",
                      "run the daemon in the foreground — `jstack-scheduler install "
                      "--dry-run` prints the exact command")
    if p.returncode != 0:
        return _check("scheduler", FAIL, summary or "status reported unhealthy",
                      "jstack-scheduler logs — the daemon has a definition but is not "
                      "both running and answering")
    return _check("scheduler", OK, summary)


def _git(cwd, *args: str) -> str:
    try:
        r = subprocess.run(["git", "-C", str(cwd), *args],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def _installed_jstack() -> "tuple[str, dict]":
    """(marketplace name, install record) for this plugin, or ('', {}).

    Read from Claude Code's own ledger rather than guessed from paths: the
    record is what the CLI will actually load next session, which is the only
    sense of "installed version" that matters.
    """
    ledger = USER_CLAUDE / "plugins" / "installed_plugins.json"
    try:
        plugins = json.loads(ledger.read_text()).get("plugins") or {}
    except (OSError, json.JSONDecodeError):
        return "", {}
    for key, records in plugins.items():
        if key.split("@")[0] == "jstack" and isinstance(records, list) and records:
            return key.split("@", 1)[1], dict(records[0])
    return "", {}


def _marketplace_checkout(marketplace: str) -> "Path|None":
    """The local checkout a directory-sourced marketplace serves from."""
    try:
        known = json.loads(
            (USER_CLAUDE / "plugins" / "known_marketplaces.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    source = (known.get(marketplace) or {}).get("source") or {}
    if source.get("source") == "directory" and source.get("path"):
        return Path(source["path"])
    return None


def _release_stage(source: "Path") -> bool:
    """Is this path inside a release staging tree?

    A managed release unpacks each build to `…/releases/<release>/stage-<tok>/`
    and points every jStack reference at the `stack/` inside it. That copy is
    one commit, frozen at unpack time, and nothing will ever move it — which
    is the property that matters here, whatever the machine.

    Matched on shape rather than on a fixed prefix: the state dir is
    configurable, so the only portable signal is the layout the release writer
    itself produces.
    """
    parts = source.parts
    return any(part.startswith("stage-") and "releases" in parts[max(0, i - 2):i]
               for i, part in enumerate(parts))


def check_marketplace_source() -> dict:
    """Where is the marketplace pointed, and could an update ever move it?

    The second opinion `check_versions` cannot be. That check resolves "the
    checkout" from the registration and then compares it against the cache —
    so when the registration is wrong, it compares a frozen copy against a
    cache taken from that copy and reports agreement. A check that reads its
    own ground truth from the thing under test cannot grade it, so this one
    grades the registered path itself and asks nothing of it.

    Caught on a hub 2026-09-17 → 2026-09-21: a release repointed the
    marketplace at its own stage, and four nights of `claude plugin update`
    re-read a directory that cannot change — correctly concluding, every
    time, that there was nothing to do.
    """
    marketplace, _ = _installed_jstack()
    if not marketplace:
        return _check("marketplace", OK, "jstack is not installed from a "
                      "marketplace — nothing registered to grade")
    try:
        known = json.loads(
            (USER_CLAUDE / "plugins" / "known_marketplaces.json").read_text())
    except FileNotFoundError:
        return _check("marketplace", OK, f"{marketplace} has no local "
                      "registration — nothing on this machine points anywhere")
    except (OSError, json.JSONDecodeError) as exc:
        return _check("marketplace", WARN, f"the marketplace registry is "
                      f"unreadable ({exc}) — where jstack is served from "
                      "cannot be established", "repair known_marketplaces.json")
    registered = (known.get(marketplace) or {}).get("source") or {}
    if registered.get("source") != "directory":
        return _check("marketplace", OK, f"{marketplace} is a "
                      f"{registered.get('source') or 'unregistered'} marketplace "
                      "— its source is not a local path to grade")
    source = Path(registered["path"])
    if _release_stage(source):
        return _check("marketplace", FAIL,
                      f"{marketplace} is served from a release stage — {source}. "
                      "That copy is frozen at one commit, so `plugin update` "
                      "re-reads it and correctly finds nothing to do; the "
                      "install cannot move and no restart changes that",
                      f"re-register against the checkout — `claude plugin "
                      f"marketplace remove {marketplace}` then `marketplace add "
                      f"<checkout>`, then `claude plugin update jstack@{marketplace}`")
    if not source.exists():
        return _check("marketplace", FAIL,
                      f"{marketplace} is served from {source}, which is not "
                      "there — every update and every version comparison below "
                      "is reading a path that does not resolve",
                      "re-register the marketplace against a directory that exists")
    if (source / ".git").exists():
        return _check("marketplace", OK, f"{marketplace} serves from the "
                      f"checkout at {source}")
    return _check("marketplace", OK, f"{marketplace} serves from {source} — a "
                  "shipped copy, not a checkout, so the cache is exactly as "
                  "current as whatever put that copy there")


def check_versions() -> dict:
    """Do the copies of jStack on this machine agree about what runs?

    A machine holds up to four — the checkout, the installed plugin cache,
    the running host, the app build. The host and the app grade themselves in
    `jstack-host doctor`; this check owns the two the plugin can see: the
    checkout and the cache. They drift silently and under the SAME version
    label, because the cache is a copy pinned to one commit at install time
    while the checkout moves on — so the version string is decoration and the
    commit shas are the identity. Everything here is a local read: origin is
    compared against the last-fetched ref, never the network, and the fetch
    age is reported so a clean bill from a stale ref reads as exactly that.
    """
    marketplace, record = _installed_jstack()
    pin = str(record.get("gitCommitSha") or "")
    repo = _git(PLUGIN_ROOT, "rev-parse", "--show-toplevel")
    checkout = Path(repo) if repo else _marketplace_checkout(marketplace)

    if checkout and _release_stage(checkout):
        # The one place `_marketplace_checkout` gets trusted as "the checkout".
        # A stage is not one: it is a snapshot, and the cache below was taken
        # from it, so every comparison this check makes would agree by
        # construction. Refuse the comparison instead of passing it.
        return _check("versions", WARN,
                      f"the copy this would grade against is a release stage "
                      f"({checkout}) — the cache was taken from it, so agreement "
                      f"here would mean nothing", "see the marketplace check")
    if not pin and not checkout:
        return _check("versions", WARN, "no installed plugin record and no "
                      "checkout — this copy's identity is unknowable",
                      "install via the marketplace, or run from a git checkout")
    if not checkout:
        return _check("versions", OK, f"cache {record.get('version')} at "
                      f"{pin[:12]} — no local checkout on this machine, the "
                      "cache is the only copy")

    head = _git(checkout, "rev-parse", "HEAD")
    if not head:
        # A shipped release copy has no .git on purpose — its identity file
        # is the identity. Grading it as a broken checkout told people with
        # git installed to install git.
        try:
            identity = json.loads(
                (checkout / "host" / "release-identity.json").read_text())
        except (OSError, json.JSONDecodeError):
            identity = None
        if identity and identity.get("sha"):
            sha = str(identity["sha"])
            rel = identity.get("release") or identity.get("version") or "release"
            if pin and pin == sha:
                return _check("versions", OK, f"shipped copy {rel} at "
                              f"{sha[:12]} — cache in step with it")
            if pin:
                return _check("versions", WARN, f"shipped copy {rel} at "
                              f"{sha[:12]}, cache pinned {pin[:12]} — two "
                              "different snapshots",
                              "reinstall/update the plugin to re-pin the cache")
            return _check("versions", OK, f"shipped copy {rel} at {sha[:12]} "
                          "— not installed as a plugin")
        return _check("versions", WARN, f"checkout at {checkout}, but git "
                      "cannot read it — no identity to compare",
                      "repair the checkout, or reinstall from a release")

    dirty = len(_git(checkout, "status", "--porcelain").splitlines())
    facts, actions = [], []

    if not pin:
        facts.append(f"checkout {head[:12]}, not installed as a plugin")
    elif pin == head:
        facts.append(f"cache in step with the checkout ({head[:12]})")
    else:
        behind = _git(checkout, "rev-list", "--count", f"{pin}..{head}")
        gap = (f"{behind} commit(s) behind the checkout" if behind else
               "at a sha the checkout does not contain")
        facts.append(f"cache pinned {pin[:12]}, {gap}")
        actions.append("reinstall/update the plugin to re-pin the cache")
        try:
            manifest = json.loads(
                (checkout / "plugins" / "jstack" / ".claude-plugin" /
                 "plugin.json").read_text())
            if str(manifest.get("version")) == str(record.get("version")):
                # The trap this check exists for: two different trees both
                # answering to one version string.
                facts.append(f"BOTH call themselves {manifest.get('version')} "
                             "— the label distinguishes nothing")
        except (OSError, json.JSONDecodeError, KeyError):
            pass

    behind_origin = _git(checkout, "rev-list", "--count", "HEAD..origin/main")
    ahead_origin = _git(checkout, "rev-list", "--count", "origin/main..HEAD")
    if behind_origin == "" and ahead_origin == "":
        facts.append("no origin/main to compare")
    else:
        if int(behind_origin or 0):
            facts.append(f"{behind_origin} behind origin/main")
            actions.append("pull the checkout")
        if int(ahead_origin or 0):
            facts.append(f"{ahead_origin} ahead of origin/main (unpushed)")
            actions.append("push — finished work that never reaches origin "
                           "is invisible to every other machine")
        if not int(behind_origin or 0) and not int(ahead_origin or 0):
            facts.append("even with origin/main")
        fetch_head = checkout / ".git" / "FETCH_HEAD"
        try:
            import time
            age = int((time.time() - fetch_head.stat().st_mtime) / 3600)
            facts.append(f"last fetch {age}h ago" if age else "fetched <1h ago")
        except OSError:
            facts.append("never fetched here")

    if dirty:
        facts.append(f"{dirty} uncommitted file(s) in the checkout")
        actions.append("commit or drop them — an editable host restart would "
                       "ship them as-is")

    detail = f"{checkout} — " + "; ".join(facts)
    if actions:
        return _check("versions", WARN, detail, "; ".join(dict.fromkeys(actions)))
    return _check("versions", OK, detail)


CHECKS = (check_python, check_claude, check_git, check_dateutil, check_root,
          check_agents, check_timeline, check_rules, check_commands, check_hooks,
          check_host,
          check_bin, check_config, check_review, check_scheduler,
          check_marketplace_source, check_versions)


def checks() -> list:
    if _BOOTSTRAP_ERROR:
        return [_check("config", FAIL, f"bootstrap failed: {_BOOTSTRAP_ERROR}")]
    out = []
    for fn in CHECKS:
        name = fn.__name__[len("check_"):].replace("_", " ")
        try:
            out.append(fn())
        except Exception as e:                              # noqa: BLE001
            # A crashed check is a FAILED check. The alternative — skipping it —
            # is a doctor that goes green on the machine it was needed for.
            out.append(_check(name, FAIL, f"check crashed: {type(e).__name__}: {e}"))
    return out


def worst(results: list) -> str:
    return max((r["grade"] for r in results), key=lambda g: _RANK[g], default=OK)


def report(as_json: bool = False, out=None) -> int:
    out = out or sys.stdout
    results = checks()
    grade = worst(results)
    if as_json:
        json.dump({"grade": grade, "exit": _RANK[grade], "checks": results},
                  out, indent=2)
        out.write("\n")
        return _RANK[grade]
    mark = {OK: "ok  ", WARN: "warn", FAIL: "FAIL"}
    for r in results:
        print(f"{mark[r['grade']]}  {r['name']:<10} {r['detail']}", file=out)
        if r["hint"] and r["grade"] != OK:
            print(f"      → {r['hint']}", file=out)
    summary = {
        OK: "every check passed",
        WARN: "working; the warnings above are capabilities that stay absent until fixed",
        FAIL: "jStack will not work correctly until the failures above are fixed",
    }
    print(f"\n{summary[grade]}", file=out)
    return _RANK[grade]


def main() -> int:
    p = argparse.ArgumentParser(prog="jstack-doctor", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true",
                   help="emit the results as JSON instead of a table")
    args = p.parse_args()
    return report(as_json=args.json)


if __name__ == "__main__":
    raise SystemExit(main())
