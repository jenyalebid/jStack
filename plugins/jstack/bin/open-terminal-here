#!/usr/bin/env bash
# jStack adapter — open a new Claude Code terminal at a directory.
#
# Contract:  open-terminal-here <cwd> [adapter-opts...] [extra-claude-args...]
# Behavior:  opens a new terminal window at <cwd> and runs `claude <extra-args>`.
#
# Adapter-managed options (parsed before the pass-through claude args, so values
# with spaces survive — they are NOT subject to the `claude $ARGS` re-tokenize):
#   --prompt-file <path>   The new shell reads <path> into --append-system-prompt
#                          and deletes it before claude starts. Use this instead
#                          of `--append-system-prompt-file <path>` when the prompt
#                          is a throwaway briefing: nothing lingers on disk.
#   --name <title>         Passed to `claude --name <title>` (sets the session
#                          display name AND the terminal title).
#   --first-prompt <text>  Passed as claude's positional prompt, so the new
#                          session STARTS on it instead of waiting at an empty
#                          box. --prompt-file is standing context; this is the
#                          first turn. A spawn that is a task (a takeover, an
#                          audit) needs both: the mandate survives compaction in
#                          system-prompt space, the kick happens once.
#
# Shipped in the plugin's bin/ (auto-added to PATH while jstack is enabled), so
# skills call it as a bare command. Self-detects the terminal — no per-machine
# adapter to hand-write. Override by putting your own `open-terminal-here`
# earlier in PATH.
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: open-terminal-here <cwd> [--engine claude|codex] [--prompt-file <path>] [--name <title>] [--first-prompt <text>] [--resume <id>] [provider-args...]" >&2
  exit 64
fi

CWD="$1"; shift

# Adapter-managed options. Parsed while still proper argv elements (a --name with
# spaces stays one token here, unlike the flattened pass-through ARGS below).
PROMPT_FILE=""
NAME=""
MODEL=""
FIRST_PROMPT=""
ENGINE="claude"
[ -n "${CODEX_THREAD_ID:-}" ] && ENGINE="codex"
RESUME_ID=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --engine)       ENGINE="$2"; shift 2 ;;
    --model)        MODEL="$2"; shift 2 ;;
    --resume)       RESUME_ID="$2"; shift 2 ;;
    --prompt-file)  PROMPT_FILE="$2"; shift 2 ;;
    --name)         NAME="$2"; shift 2 ;;
    --first-prompt) FIRST_PROMPT="$2"; shift 2 ;;
    *)              break ;;
  esac
done

case "$ENGINE" in claude|codex) ;; *) echo "unknown engine: $ENGINE" >&2; exit 64 ;; esac

# A command driven through a managed terminal must stay drivable there. The host owns
# routing and board ids; the portable adapter only knows its public CLI.
if [[ -n "${JREMOTE_SID:-}" ]] && command -v jstack-host >/dev/null 2>&1; then
  spawn_args=(spawn --cwd "$CWD" --engine "$ENGINE" --name "$NAME"
              --prompt-file "$PROMPT_FILE" --first-prompt "$FIRST_PROMPT" --model "$MODEL")
  if [ -n "$RESUME_ID" ]; then
    if [ "$ENGINE" = codex ]; then
      spawn_args+=(--resume --resume-id "$RESUME_ID")
    else
      spawn_args+=(--resume --sid "$RESUME_ID")
    fi
  fi
  # Preserve each argument while crossing the host's legacy shell interface.
  extra_args="$(python3 -c 'import shlex,sys; print(shlex.join(sys.argv[1:]))' "$@")"
  rc=0
  jstack-host "${spawn_args[@]}" --claude-args "$extra_args" || rc=$?
  [ "$rc" = 75 ] || exit "$rc"
fi

ARGS="$*"  # remaining pass-through claude args (pre-tokenized by caller)
[ -n "$MODEL" ] && ARGS="--model $MODEL $ARGS"
[ -n "$RESUME_ID" ] && ARGS="--resume $RESUME_ID $ARGS"

# --name <title> rebuilt as a single quoted token for the embedded shell command.
name_arg=""
if [ -n "$NAME" ]; then
  name_arg=" --name \"$NAME\""
fi

# The positional prompt is user prose — it can hold quotes, $, backticks, the
# lot — and it is about to be pasted into a shell command inside an AppleScript
# string. Single-quoting (with the POSIX '\'' escape for embedded quotes) is the
# only form that stays inert through the shell layer; applescript_escape below
# then handles the AppleScript layer. The double-quoted --name above survives
# only because titles are ours and tame.
sh_quote() {
  local s="$1"
  printf "'%s'" "${s//\'/\'\\\'\'}"
}
first_arg=""
if [ -n "$FIRST_PROMPT" ]; then
  first_arg=" $(sh_quote "$FIRST_PROMPT")"
fi

# The claude invocation the new shell runs (the part after `cd`).
# With --prompt-file: read the briefing into a var, delete the file, then launch
# claude with the content inline. Only the PATH ever crosses into AppleScript /
# the terminal command — the (possibly multi-line) content is read at runtime in
# the new shell, so there is no escaping hazard and nothing is left to clean up.
if [ -n "$PROMPT_FILE" ]; then
  claude_invoke="__JSTACK_SP=\"\$(cat \"$PROMPT_FILE\")\" && rm -f \"$PROMPT_FILE\" && claude $ARGS$name_arg --append-system-prompt \"\$__JSTACK_SP\"$first_arg"
else
  claude_invoke="claude $ARGS$name_arg$first_arg"
fi

if [ "$ENGINE" = codex ]; then
  claude_invoke="$(python3 - "$PROMPT_FILE" "$FIRST_PROMPT" "$RESUME_ID" "$MODEL" "$@" <<'PY'
import json, pathlib, shlex, sys
brief, prompt, resume, model, *extra = sys.argv[1:]
cmd = ['codex'] + (['resume', resume] if resume else [])
cmd += ['--dangerously-bypass-hook-trust', '-c', 'bypass_hook_trust=true']
if model:
    cmd += ['-m', model]
prelude = ''
if brief:
    cmd += ['-c', 'developer_instructions=' + json.dumps(pathlib.Path(brief).read_text())]
    prelude = 'rm -f ' + shlex.quote(brief) + ' && '
cmd += extra
if prompt:
    cmd.append(prompt)
print(prelude + shlex.join(cmd))
PY
)"
fi

# Build the full command the new shell runs (cd then launch). Quote CWD.
launch_cmd="cd \"$CWD\" && $claude_invoke"

# macOS types this command into the new terminal's tty, and a terminal that has
# only just opened is still in CANONICAL mode — where the line discipline drops
# everything past MAX_CANON (1024 bytes) without a word. A long --first-prompt
# crossed that on its own: the line arrived cut mid-quote, the shell sat at a
# continuation prompt, and `claude` was never reached — a window with a briefing
# in it and no CLI.
#
# So nothing that scales with caller input is typed. The command goes to a file
# and the terminal is typed a `source` of fixed length. Not self-deleting: an
# `rm` inside the line would race the shell still reading it, which is the
# failure this avoids. Stale files are swept instead.
BOOT_FILE=""
if [ "$(uname -s)" = "Darwin" ]; then
  find /tmp -maxdepth 1 -name 'jstack-boot-*.sh' -mmin +60 -delete 2>/dev/null || true
  BOOT_FILE="$(mktemp /tmp/jstack-boot-XXXXXXXX.sh)"
  chmod 600 "$BOOT_FILE"
  printf '%s\n' "$launch_cmd" > "$BOOT_FILE"
  launch_cmd="source \"$BOOT_FILE\""
fi

# AppleScript strings are double-quoted, so any " inside the embedded shell
# command has to become \" before interpolation. Escape backslashes first,
# then quotes, so we don't double-escape the result.
applescript_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

case "$(uname -s)" in
  Darwin)
    as_cmd="$(applescript_escape "$launch_cmd")"
    if [ -d "/Applications/iTerm.app" ]; then
      osascript <<EOF
tell application "iTerm"
    activate
    create window with default profile
    tell current session of current window
        write text "$as_cmd"
    end tell
end tell
EOF
    else
      osascript <<EOF
tell application "Terminal"
    activate
    do script "$as_cmd"
end tell
EOF
    fi
    ;;
  Linux)
    if command -v gnome-terminal >/dev/null 2>&1; then
      gnome-terminal --working-directory="$CWD" -- bash -lc "$claude_invoke; exec bash"
    elif command -v konsole >/dev/null 2>&1; then
      konsole --workdir "$CWD" -e bash -lc "$claude_invoke; exec bash"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
      x-terminal-emulator -e bash -lc "$launch_cmd; exec bash"
    elif command -v xterm >/dev/null 2>&1; then
      xterm -e bash -lc "$launch_cmd; exec bash"
    else
      echo "open-terminal-here: no supported Linux terminal found (gnome-terminal/konsole/xterm)" >&2
      exit 69
    fi
    ;;
  *)
    # Windows / MSYS / Cygwin: try Windows Terminal, then plain cmd. The bash
    # read-and-delete idiom does not run under cmd, so fall back to passing the
    # prompt file directly (it will linger — acceptable on this best-effort path).
    win_args="$ARGS$name_arg"
    [ -n "$PROMPT_FILE" ] && win_args="$win_args --append-system-prompt-file \"$PROMPT_FILE\""
    # cmd does not read POSIX single quotes, so the prompt is re-quoted its way.
    # Best-effort like the rest of this branch: an embedded " will still break it.
    [ -n "$FIRST_PROMPT" ] && win_args="$win_args \"$FIRST_PROMPT\""
    if command -v wt.exe >/dev/null 2>&1; then
      wt.exe -d "$CWD" cmd /k "claude $win_args"
    else
      echo "open-terminal-here: unsupported platform $(uname -s); open a terminal at $CWD and run: claude $win_args" >&2
      exit 69
    fi
    ;;
esac
