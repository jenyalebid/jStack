#!/usr/bin/env python3
"""jStack session-end engine — resolve, gate, and write a session's running memory.

SessionEnd hook → this engine → (default) resume the just-ended session for ONE
turn to write its own seat-tagged timeline entry — the seat's running memory,
injected back on the next session start. The session that lived the conversation
already has it in context, so it is the cheapest, best-informed writer — no
fresh stranger re-ingesting a transcript digest, no ~50-turn review.

The action a session end triggers is `session_end_action`:
  - "selfwrite" (default) — resume a DISPOSABLE DUPLICATE of the ended session
    for 1 turn: one timeline entry (spawn_selfwrite). The transcript is dubbed
    (bin/dub-session), the dub is resumed for the write, then deleted — the
    primary session JSONL is never touched, so resuming the session later picks
    up exactly where the user left off, with no trailing self-write turn. On
    re-end after a resume, the engine computes the last-reviewed boundary from
    the recorded offset and the prompt scopes the entry to the delta after it.
    If the session COMPACTED, the resumed dub holds a summary of the earlier
    turns rather than the turns — the engine detects that and the prompt sends
    the writer to the transcript for the part its own context lost.
    Thread extraction / doc reconciliation are NOT done here — those live only
    in the manual deep review.
  - "review" — the legacy fresh-session multi-phase review: `claude
    --print` from {agent_root}/{Name}/ running the review skill →
    output parser-validated (required sections + timeline-grew) → retry → escalate
    (spawn_review). Still available for hosts that want the full stranger pass.
  - "off" — do nothing on session end.

Self-contained: python3 stdlib only. Behavior is configured by a single
optional JSON file (JSTACK_REVIEW_CONFIG, default ~/.claude/jstack/review.json);
with no config it runs portable defaults.

Stack requirements (conventions this engine assumes exist):
  - Agent workspaces under agent_root, one per {Name}/ — an agent is
    reviewable iff {agent_root}/{Name}/ is an agent by root.is_agent: a
    CLAUDE.md at its top, or in at least one of its seat subdirs.
  - The jstack `log_event` tool (self-write) and the review skill (default
    /jstack:post-session-review, "review" action) are installed. This engine
    puts its own bin/ on the spawned PATH.

Config keys (all optional):
  agent_root            default: derived from the root ({JSTACK_ROOT}/Agents)
  default_agent         agent owning $HOME-cwd sessions (default: none → skip)
  project_dir_map       {encoded-project-dir: agent} for non-workspace sessions
  session_end_action    "selfwrite" (default) | "review" | "off"
  selfwrite_model       default "sonnet"   (model for the 1-turn resume write)
  selfwrite_max_turns   default 12
  selfwrite_timeout_secs default 300
  skill_invocation      default "/jstack:post-session-review"  ("review" action)
  required_sections     default ["TRANSCRIPT_WALK","DOC_RECONCILE",
                                 "ACTIONS_TAKEN","TIMELINE","SUMMARY"]  ("review")
  model                 default "opus"   ("review" action)
  max_turns             default 50       ("review" action)
  timeout_secs          default 1200     ("review" action)
  max_attempts          default 2
  max_concurrent        default 2
  slot_wait_secs        default 1800
  min_session_bytes     default 1000
  recent_activity_secs  default 14400
  telegram_cooldown_seconds   default 300
  telegram_cooldown_file      JSON file holding telegram_cooldown_seconds
                              (wins over the inline key when readable)
  tg_classify_cmd       executable called with <session_id>; exit 0 = telegram
  escalate_cmd          executable called with <agent> <session_id> <reason>
                        on persistent failure (default: log only)
  extra_path            list of dirs prepended to the spawned review's PATH
  selfwrite_extra_prompt  text appended verbatim to the self-write prompt —
                        a host step the one turn also runs (default: none)
  post_selfwrite_cmd    command run after a self-write that filed its entry
                        (SELFWRITE_DONE) as <cmd> <session_id> <transcript>,
                        where <transcript> is the self-write's own transcript
                        (its last assistant turn is the self-write's reply).
                        Same PATH as the spawn, 120s timeout, logged as
                        POST_SELFWRITE ok|fail|timeout; never changes the
                        self-write's outcome (default: none)
  timeline_dir          default $JSTACK_TIMELINE_DIR, else root.timeline_dir()
                        — {root}/Logs/Timeline (also exported as
                        JSTACK_TIMELINE_DIR to the spawn)
  state_dir             default "~/.claude/jstack/review-state"
  log_file              default {state_dir}/session-review.log

Kill switch: JSTACK_REVIEW_DISABLED=1. Loop guard: SKIP_SESSION_HOOK=1 is
set on every spawn (the SessionEnd hook honors it).
"""

# PEP 604 annotations (str | None) evaluate at def time — without this the
# file crashes on the python3 a launchd/cron caller resolves (macOS system
# 3.9). The engine is spawned by plumbing, not only by interactive shells.
from __future__ import annotations

import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from session_runtime import metadata, user_text, transcripts, CodexRPC, codex_user_engaged
import repo_seat  # noqa: E402
try:
    import root as _root  # noqa: E402
except ImportError:
    # Older install without root.py — every use site below keeps the literal
    # default it shipped with, so the engine runs unchanged there.
    _root = None

CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
PLUGIN_BIN = Path(__file__).resolve().parent

REVIEW_MARKER = "[POST-SESSION-REVIEW]"
SELFWRITE_MARKER = "[SESSION-SELF-WRITE]"
# Containment prefix — matches the host filer's briefing text without pinning
# its persona-specific tail, so hosts can word the rest however they like.
FILER_BRIEFING_MARKER = "You are being briefed on a topic"

# The one turn the dubbed session runs to write the original's running memory.
# It ALREADY HAS the whole conversation in context — no file re-reading, no
# re-derivation. An entry, its tag, and a stamp, then stop. The tag belongs
# here and not to a later pass because this turn is the last thing that knows
# what the session was about — a tagger reading the entry back is guessing from
# a headline. Deliberately NOT a review:
# no thread extraction, no doc reconciliation, no code — those are the manual
# deep review. {delta_note} is filled only when the session was reviewed before
# (a resume that ended again) — it scopes the entry to the unreviewed delta.
# {compact_note} is filled only when the session was compacted — the one case
# where "what is already in your context" is NOT the whole conversation.
SELFWRITE_PROMPT = """{marker}

Your session has ended. Do ONLY the steps below from what is already in your
context above — do not re-read files, do not analyze, do not touch code, reminders,
or any docs. Then stop.
{delta_note}{compact_note}
1. TIMELINE — this is your seat's running memory: the next {agent}/{submode} session
   boots on the last entries under this exact source, so write the line that lets it
   build on this session instead of starting cold. If this session did something
   worth carrying forward (shipped code, made a decision, fixed a problem, learned
   something durable, or a user directive that drove real work), log exactly ONE entry:
       log_event {agent}/{submode} --date YYYY-MM-DD --at HH:MM --session {session_id} "headline, <=120 chars, present tense"
   Add up to 3 `--detail "..."` bullets only if they earn their place — an open thread,
   a decision and its why, a do-not-repeat. YYYY-MM-DD and HH:MM are the local date and
   time of the last REAL message — not now. A session can end days after its last real
   work (terminal left open), and without --date the entry files under the wrong day.
   If nothing this session is timeline-worthy, SKIP this step — never invent an entry.

2. TAG — the subject, so this work is findable across every seat that touched it.
   Only if you wrote an entry above; if you skipped it, skip this too. Run:
       log_event tag list --session {session_id}
   `●` marks what that session is ALREADY filed under — set by hand with /tag, or by
   an earlier end; if one is marked and it still fits, you are done, stop here. The
   --session is not optional: you are running inside a disposable duplicate, so a bare
   list marks the duplicate's tags, which are none, and you would file a second tag
   beside a right one. Otherwise pick the ONE tag that best describes what this
   session was ABOUT, then:
       log_event tag set <name> --session {session_id}
   The list is a small shared vocabulary and staying small is the point — a near
   match is the right answer far more often than a new tag. Only if nothing on the
   list plausibly covers the work, mint one and then set it:
       log_event tag new <name> --description "one line: what work belongs under this"
   A tag names a subject several sessions will share — never the seat, the date, or
   a restatement of your headline.
{stamp_step}
That is every step — then stop. Nothing else."""

# The dashboard stamp is a HOST-side tool, not part of jstack. Only hosts that
# actually have review_sessions.py on the spawn PATH get this step; everywhere
# else the prompt must not instruct a command that cannot exist there.
SELFWRITE_STAMP_STEP = """
3. STAMP — mark this session written so the dashboard reflects it:
       review_sessions.py stamp {session_id} assistant
"""

# Injected into SELFWRITE_PROMPT (and the review invocation) when the session
# was reviewed at a previous end — i.e. it was resumed and has now ended again.
# The boundary is COMPUTED by the engine from the recorded reviewed offset, so
# the delta scope is a mechanical fact handed to the writer, not its judgment.
SELFWRITE_DELTA_NOTE = """
RESUME DELTA — this session ended and was timeline-written before. Everything
through {boundary} (local time) is already covered by earlier entries. Scope
the entry below to ONLY what happened after that point; if nothing after it is
timeline-worthy, that IS the skip case.
"""

# Injected when the session was COMPACTED. The whole selfwrite design rests on
# the dub carrying the conversation — a compact breaks exactly that: it writes a
# new-root boundary line, so a resume rebuilds context from the summary forward
# and the earlier turns, though still on disk, are not in the writer's context.
# Left unsaid, the writer files an entry for the tail of the session while
# believing it saw all of it. So this note names the loss and lifts the
# no-re-read rule for ONE file — the session's own transcript.
SELFWRITE_COMPACT_NOTE = r"""
COMPACTED — this conversation was compacted {count_phrase}, last at {when}
(local). A compact starts a NEW ROOT in the transcript: what came before it is
still on disk but is NOT in the context you are reading — you have a summary of
it plus what followed. Write from context alone and your entry silently covers
only the tail of the session.

So for this write only, the no-re-read rule above is lifted for exactly ONE
file: your own transcript. Before step 1, read the user's side of the whole
session —
    jq -r 'if .type == "response_item" and .payload.type == "message" and .payload.role == "user"
      then .payload.content elif .type == "user" then .message.content else empty end
      | if type == "string" then . else map(select(.type == "text" or .type == "input_text") | .text) | join(" ") end
      | gsub("\\s+"; " ")' {jsonl_path} | head -200
Count only real user prose — skip <system-reminder>, <command-message>,
<command-name> and tool-result blobs. Then write ONE entry for the WHOLE
session, weighted by what the user actually asked for across all of it, not by
what happens to still be in your context. Read nothing else.
"""


# The claude CLI prints this and exits nonzero when the account's usage window is
# exhausted (e.g. "You've hit your session limit · resets 7am (America/Los_Angeles)").
# A review spawn that only hit this did no review — but it is transient and self-
# heals at the reset, so it must NOT be retried in a tight loop or escalated as a
# broken review — a limit-only spawn is not a failure worth paging anyone about.
SESSION_LIMIT_MARKER = "hit your session limit"


def is_session_limit(output: str) -> bool:
    return bool(output) and SESSION_LIMIT_MARKER in output

DEFAULTS = {
    # None → derived (root.agents_dir), the same answer every other tool gives.
    # A literal here is a second opinion about where the tree is: on a machine
    # whose root is not $HOME, this engine alone resolved into a directory that
    # did not exist, found no agents, and skipped every session — while mail,
    # injection and repo-seat all resolved correctly off the root. Silent,
    # because "no agent match" is also what a genuinely unowned session logs.
    "agent_root": None,
    "default_agent": None,
    "project_dir_map": {},
    "skill_invocation": "/jstack:post-session-review",
    "required_sections": [
        "TRANSCRIPT_WALK", "DOC_RECONCILE", "ACTIONS_TAKEN", "TIMELINE", "SUMMARY",
    ],
    # What a session's end triggers. The historical default spun up a fresh
    # `review/` session (a stranger) that re-ingested a transcript digest and ran
    # a ~50-turn multi-phase review — correct, but the transcript re-ingestion +
    # long agent run is the token cost. "selfwrite" (default) instead resumes a
    # DISPOSABLE DUB of the session that JUST ENDED for ONE turn to write its own
    # running memory (one seat-tagged timeline entry) — the conversation is
    # already its context, so it is the cheapest, best-informed writer. The dub
    # is deleted after the write, so the PRIMARY transcript never grows a
    # self-write turn (clean future resume, clean picker). Thread extraction /
    # doc reconciliation live only in the manual deep review now.
    #   "selfwrite" — dub the ended session, resume the dub 1 turn, delete it
    #   "review"    — the legacy fresh-stranger multi-phase review (spawn_review)
    #   "off"       — do nothing on session end
    "session_end_action": "selfwrite",
    "selfwrite_model": "sonnet",
    "codex_selfwrite_model": "gpt-5.6-luna",
    "codex_review_model": "gpt-5.6-sol",
    "selfwrite_max_turns": 12,
    "selfwrite_timeout_secs": 300,
    "model": "opus",
    "max_turns": 50,
    "timeout_secs": 1200,
    "max_attempts": 2,
    "max_concurrent": 2,
    # Seconds to wait before retrying when the child was killed by a signal
    # (negative returncode — e.g. SIGKILL/-9 from macOS jetsam under memory
    # pressure). Environmental kills recur instantly on immediate re-spawn;
    # a pause lets the transient condition clear. 0 disables the backoff.
    "signal_retry_backoff_secs": 45,
    "slot_wait_secs": 1800,
    "slot_poll_secs": 10,
    "min_session_bytes": 1000,
    # Optional allowlist of sub-modes to review, as ["agent/submode", ...] with a
    # "*/submode" wildcard for any agent (e.g. ["*/chat", "beta/pm"]). None = no
    # scoping, review every resolvable session (the historical default). The set is
    # HOST POLICY and lives in the machine's review.json — never hardcode it here.
    "reviewed_submodes": None,
    # Auto (non-user-driven) sessions normally get NO model review — reviewing the
    # high-frequency social/relay wake flood is token waste, and their timeline
    # line is written in-session by the Stop hook. EXCEPT the purpose-built
    # recurring crons named here (same "agent/submode" + "*/submode" form as
    # reviewed_submodes): they get the purpose-prompted engine self-write (a
    # seat-tagged timeline entry + the dashboard stamp) instead of relying on
    # the Stop-hook reminder alone. HOST POLICY — lives in review.json.
    # None/[] = nothing auto-reviewed (portable default; no behavior change on
    # machines without it).
    "auto_review_submodes": None,
    "recent_activity_secs": 14400,
    "telegram_cooldown_seconds": 300,
    "telegram_cooldown_file": None,
    "tg_classify_cmd": None,
    "escalate_cmd": None,
    "extra_path": [],
    # Host hooks around the self-write. The engine knows nothing of what a
    # host does with them: the prompt text rides the one turn verbatim, and
    # the command gets the ids it needs to read what that turn wrote.
    "selfwrite_extra_prompt": None,
    "post_selfwrite_cmd": None,
    # None → derived (root.timeline_dir): the ONE location bin/log_event and
    # bin/msg also resolve to. A literal here would be a third opinion about
    # where the single db lives, and this engine is the one that exports the
    # path to every spawn and then reads the row count back to prove the write
    # happened — pointing it at a different file makes a successful write look
    # like a silent no-op.
    "timeline_dir": None,
    "state_dir": "~/.claude/jstack/review-state",
    "log_file": None,
}


def _default_timeline_dir() -> Path:
    """Where the timeline lives when review.json does not say.

    Env first for the same reason log_event puts it first: a spawn is handed
    JSTACK_TIMELINE_DIR, and an engine that ignored it would watch a different
    file than the one its own children write.
    """
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    if _root is not None:
        return _root.timeline_dir()
    return Path.home() / "Logs" / "Timeline"


def _default_agent_root() -> Path:
    """Where agent workspaces live when review.json does not say.

    Asks root for the same reason bin/repo-seat does: the tree has one
    declaration and this engine is not entitled to a private one.
    """
    if _root is not None:
        return _root.agents_dir()
    return Path.home() / "Agents"


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    path = Path(os.environ.get(
        "JSTACK_REVIEW_CONFIG",
        str(Path.home() / ".claude" / "jstack" / "review.json"),
    )).expanduser()
    if path.exists():
        try:
            user = json.loads(path.read_text())
            if isinstance(user, dict):
                cfg.update({k: v for k, v in user.items() if k in DEFAULTS})
        except (json.JSONDecodeError, OSError) as e:
            print(f"session-review-spawn: bad config {path}: {e}", file=sys.stderr)
    cfg["agent_root"] = (
        Path(cfg["agent_root"]).expanduser() if cfg["agent_root"]
        else _default_agent_root()
    )
    cfg["timeline_dir"] = (
        Path(cfg["timeline_dir"]).expanduser() if cfg["timeline_dir"]
        else _default_timeline_dir()
    )
    cfg["state_dir"] = Path(cfg["state_dir"]).expanduser()
    cfg["log_file"] = (
        Path(cfg["log_file"]).expanduser() if cfg["log_file"]
        else cfg["state_dir"] / "session-review.log"
    )
    return cfg


CFG = load_config()


def _log(msg: str) -> None:
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    CFG["log_file"].parent.mkdir(parents=True, exist_ok=True)
    with CFG["log_file"].open("a") as f:
        f.write(f"{ts} {msg}\n")


# ---------------------------------------------------------------- resolution

def _encode(path: Path) -> str:
    """Claude Code project-dir encoding of an absolute path."""
    return str(path).replace("/", "-").replace(".", "-")


def reviewable_agents(agent_root: Path) -> dict[str, str]:
    """{lowercase-agent: Name} for every agent workspace under agent_root.

    The gate is root.is_agent — the same one bin/msg, the SessionStart injector
    and the Stop guard ask. It was a fourth private copy here, requiring a
    CLAUDE.md at the workspace top. On a layout of Agents/<id>/<seat>/CLAUDE.md
    with nothing at the top that copy found no agents at all, so every session
    on such a machine resolved to nobody and no seat ever got its running
    memory written — mail and injection worked, review silently did not.

    `is_agent` is asked directly about a directory named from the agent_root
    this function was handed, rather than through root.agents(cfg): the caller
    has already resolved that root, and routing back through a cfg lookup would
    let JSTACK_AGENTS_DIR answer about a different tree than the one being
    listed. Casing is preserved because the project-dir encoding is built from
    the on-disk name.
    """
    out: dict[str, str] = {}
    if not agent_root.is_dir():
        return out
    for d in sorted(agent_root.iterdir()):
        if not d.is_dir() or d.name.startswith("."):
            continue
        if _root.is_agent(d) if _root is not None else (d / "CLAUDE.md").is_file():
            out[d.name.lower()] = d.name
    return out


def resolve_agent(project_dir_name: str, agent_root: Path,
                  agents: dict[str, str],
                  project_dir_map: dict, default_agent: str | None) -> str | None:
    """Map an encoded project-dir name to a reviewable agent (lowercase)."""
    root_prefix = _encode(agent_root) + "-"
    if project_dir_name.startswith(root_prefix):
        remainder = project_dir_name[len(root_prefix):]
        for low, name in agents.items():
            enc = name.replace(".", "-")
            if remainder == enc or remainder.startswith(enc + "-"):
                return low
        return None
    mapped = project_dir_map.get(project_dir_name)
    if mapped and mapped.lower() in agents:
        return mapped.lower()
    if default_agent and project_dir_name == _encode(Path.home()):
        return default_agent.lower() if default_agent.lower() in agents else None
    return None


def find_session(session_id: str, transcript_hint: str | None = None) -> tuple[Path | None, str | None]:
    """Find session JSONL and owning agent. Returns (jsonl_path, agent) or (None, None)."""
    agents = reviewable_agents(CFG["agent_root"])

    def resolve(p: Path) -> tuple[Path, str | None]:
        agent = resolve_agent(_encode(Path(_session_cwd(p))) if metadata(p) and _session_cwd(p) else p.parent.name, CFG["agent_root"], agents,
                              CFG["project_dir_map"], CFG["default_agent"])
        if agent is None:
            agent = _repo_agent(_session_cwd(p), agents)
        return p, agent

    if transcript_hint:
        p = Path(transcript_hint)
        if p.exists() and (p.name == f"{session_id}.jsonl" or metadata(p).get("id") == session_id):
            return resolve(p)

    native = [p for p in transcripts(session_id) if metadata(p)]
    if len(native) == 1:
        return resolve(native[0])
    if not CLAUDE_PROJECTS.exists():
        return None, None
    for project_dir in CLAUDE_PROJECTS.iterdir():
        if not project_dir.is_dir():
            continue
        candidate = project_dir / f"{session_id}.jsonl"
        if candidate.exists():
            return resolve(candidate)
    return None, None


def report_blackhole(session_id: str) -> bool:
    """A session DIRECTORY with no transcript anywhere is not a benign
    non-agent session — it means the session ran but the CLI never persisted
    its JSONL (e.g. a leaked CLAUDE_CODE_CHILD_SESSION marker in the launching
    shell suppresses transcript writes). The session is unrecoverable: no
    resume, no review, no timeline entry. Scream so the gap is seen the day it
    happens, not discovered later from a missing record. True = black hole
    detected (logged + escalated)."""
    if not CLAUDE_PROJECTS.exists():
        return False
    orphan = next((d for d in CLAUDE_PROJECTS.glob(f"*/{session_id}")
                   if d.is_dir()), None)
    if orphan is None:
        return False
    reason = (f"session dir {orphan.parent.name}/{session_id[:8]} exists but "
              "no transcript was ever written — session unrecoverable; check "
              "the launching shell for a leaked CLAUDE_CODE_CHILD_SESSION")
    _log(f"BLACKHOLE {session_id[:8]}: {reason}")
    if CFG["escalate_cmd"]:
        try:
            subprocess.run(
                [str(Path(CFG["escalate_cmd"]).expanduser()),
                 orphan.parent.name, session_id,
                 f"Unpersisted session (black hole): {reason}"],
                timeout=60, check=False, capture_output=True,
            )
        except Exception as e:
            _log(f"ESCALATE_FAIL {session_id[:8]}: {e}")
    return True


def _session_cwd(jsonl_path: Path) -> str | None:
    """The real working dir the session ran in, read from the JSONL. Unlike the
    encoded project-dir name, this is unambiguous (hyphens in sub-mode names like
    'nightly-review' survive)."""
    try:
        with jsonl_path.open() as f:
            for line in f:
                try:
                    row = json.loads(line)
                    cwd = row.get("cwd") or ((row.get("payload") or {}).get("cwd") if row.get("type") in ("session_meta", "turn_context") else None)
                except json.JSONDecodeError:
                    continue
                if cwd:
                    return cwd
    except OSError:
        pass
    return None


def _repo_agent(cwd: str | None, agents: dict[str, str]) -> str | None:
    """The agent that owns the repo a non-workspace session ran in, if any.
    Gated on the agent being reviewable so a registry entry can never conjure
    an agent the workspace layout doesn't have."""
    if not cwd:
        return None
    agent, _ = repo_seat.seat_for(
        cwd, CFG["agent_root"],
        repo_seat.registry_path_for(CFG, CFG["agent_root"]))
    return agent if agent in agents else None


def resolve_submode(jsonl_path: Path, agent_root: Path, agent_title: str) -> str | None:
    """The seat the session ran in: the session dir's full path under
    {agent_root}/{agent_title}/, "/"-joined — seats are directories, each dir
    its own seat (chat ≠ social/chat ≠ social). A session at the agent root is
    the default cockpit mode "chat" (it doesn't cd into chat/ — that would
    move its project-dir key; "chat" is just the seat its timeline entries
    file under). None only if it ran outside the workspace (e.g. a mapped
    project dir)."""
    cwd = _session_cwd(jsonl_path)
    if not cwd:
        return None
    try:
        rel = Path(cwd).relative_to(agent_root / agent_title)
    except ValueError:
        # Outside the workspace. A session in a repo the agent owns still has a
        # seat — its cockpit one — so its entry files with the rest of that
        # agent's work instead of being dropped for having no seat.
        _, submode = repo_seat.seat_for(
            cwd, agent_root,
            repo_seat.registry_path_for(CFG, agent_root))
        return submode
    return "/".join(rel.parts) if rel.parts else "chat"


def _seat_listed(agent: str, submode: str, patterns) -> bool:
    """Per-dir allowlist match, nearest dir wins: at each depth exact
    "agent/seat" or wildcard "*/seat"; no hit → try the seat's parent dir
    ("alpha/social/chat" falls back to "*/social")."""
    seat = submode
    while True:
        if f"{agent}/{seat}" in patterns or f"*/{seat}" in patterns:
            return True
        if "/" not in seat:
            return False
        seat = seat.rsplit("/", 1)[0]


def submode_reviewed(agent: str, submode: str | None, reviewed) -> bool:
    """True iff this agent/seat is in the reviewed allowlist (per-dir match,
    ancestor dirs count). Absent list (None) means no scoping — everything is
    reviewed."""
    if reviewed is None:
        return True
    if submode is None:
        return False
    return _seat_listed(agent, submode, reviewed)


def auto_reviewed(agent: str, submode: str | None, auto_review) -> bool:
    """True iff this AUTO (non-user-driven) session's seat is a recurring
    cron carved in for the engine self-write — a purpose-prompted seat-tagged
    timeline entry + dashboard stamp, instead of the Stop-hook reminder alone.
    Everything else auto is skipped. Empty/None allowlist → False (nothing
    auto-reviewed). Same match form as submode_reviewed."""
    if not auto_review:
        return False
    if submode is None:
        return False
    return _seat_listed(agent, submode, auto_review)


# ------------------------------------------------------------------- guards

def claim_session(session_id: str) -> bool:
    """Atomically claim this session so parallel entry points (host hook +
    plugin hook) spawn exactly one review. A claim whose pid is dead is stale
    — resumed sessions ending again re-claim cleanly."""
    claims = CFG["state_dir"] / "claims"
    claims.mkdir(parents=True, exist_ok=True)
    marker = claims / session_id
    for _ in range(2):
        try:
            fd = os.open(str(marker), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
            with os.fdopen(fd, "w") as f:
                f.write(f"{os.getpid()}\n")
            return True
        except FileExistsError:
            try:
                pid = int(marker.read_text().strip().split()[0])
                os.kill(pid, 0)
                return False  # live holder
            except (ValueError, IndexError, ProcessLookupError, PermissionError, OSError):
                try:
                    marker.unlink()
                except FileNotFoundError:
                    pass
    return False


def _iter_user_texts(jsonl_path: Path):
    with jsonl_path.open() as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            text = user_text(e)
            if text:
                yield text


def is_review_session(jsonl_path: Path) -> bool:
    """First user message carries the review marker → loop prevention."""
    try:
        for text in _iter_user_texts(jsonl_path):
            return REVIEW_MARKER in text
    except Exception:
        pass
    return False


def is_unengaged_filer_briefing(jsonl_path: Path) -> bool:
    """Filer-briefing session with no subsequent user prose turns — closing
    the resumed terminal without typing fires SessionEnd; reviewing a
    briefing-only transcript wastes a full spawn."""
    saw_briefing_first = False
    seen_prose = 0
    try:
        for text in _iter_user_texts(jsonl_path):
            text = text.strip()
            if not text:
                continue
            seen_prose += 1
            if seen_prose == 1:
                if FILER_BRIEFING_MARKER not in text:
                    return False
                saw_briefing_first = True
            else:
                return False
    except Exception:
        return False
    return saw_briefing_first and seen_prose == 1


def is_user_engaged(jsonl_path: Path) -> bool:
    """True iff a human actually drove any part of this session — the defining
    factor for whether it gets a model review (auto work never does). Two
    harness signals, either sufficient:
      - a user prompt stamped promptSource="typed" (keyboard input), or
      - a `mode`/`permission-mode` entry — written ONLY when an interactive
        terminal is attached. Gateway/cron/--print sessions never write these
        (they do write `last-prompt`, which is NOT a human signal).
    Telegram conversations carry neither marker — callers must keep
    is_telegram_session() as the user-driven exception."""
    if codex_user_engaged(jsonl_path, CFG["state_dir"]):
        return True
    try:
        with jsonl_path.open() as f:
            for line in f:
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                t = e.get("type")
                if t == "session_meta" and (e.get("payload") or {}).get("source") == "cli":
                    return True
                if t in ("mode", "permission-mode"):
                    return True
                if (t == "user" and not e.get("isMeta")
                        and e.get("promptSource") == "typed"):
                    return True
    except OSError:
        return True   # unreadable → fail toward review, never silently drop
    return False


def has_recent_activity(jsonl_path: Path) -> bool:
    """True if the last message is from today (local) or within the window.
    Skips reopen-and-close of old sessions (metadata-only appends)."""
    newest_ts = None
    try:
        with jsonl_path.open() as f:
            for line in f:
                try:
                    e = json.loads(line)
                    if e.get("type") not in ("user", "assistant") and not (e.get("type") == "response_item" and (e.get("payload") or {}).get("type") == "message"):
                        continue
                    ts = e.get("timestamp")
                    if ts and (newest_ts is None or ts > newest_ts):
                        newest_ts = ts
                except (json.JSONDecodeError, KeyError):
                    continue
    except Exception:
        return True
    if newest_ts is None:
        return False
    try:
        msg_time = datetime.fromisoformat(newest_ts.replace("Z", "+00:00"))
        if msg_time.tzinfo is None:
            msg_time = msg_time.replace(tzinfo=timezone.utc)
        now = datetime.now(timezone.utc)
        local_now = now.astimezone()
        if msg_time.astimezone(local_now.tzinfo).date() == local_now.date():
            return True
        return (now - msg_time).total_seconds() <= CFG["recent_activity_secs"]
    except (ValueError, TypeError):
        return True


def _reviewed_offset_file(session_id: str) -> Path:
    d = CFG["state_dir"] / "reviewed-offset"
    d.mkdir(parents=True, exist_ok=True)
    return d / session_id


def reviewed_offset(session_id: str) -> int:
    try:
        return int(_reviewed_offset_file(session_id).read_text().strip())
    except (FileNotFoundError, ValueError, OSError):
        return 0


def record_reviewed_offset(session_id: str, size: int) -> None:
    try:
        _reviewed_offset_file(session_id).write_text(str(size))
    except OSError:
        pass


def _local_stamp(ts: str | None) -> str | None:
    """A transcript timestamp (UTC ISO) as local 'YYYY-MM-DD HH:MM'. Every
    time a prompt shows the user a moment from the JSONL it must be local —
    the raw values are UTC and would read hours ahead."""
    if not ts:
        return None
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        if t.tzinfo is None:
            t = t.replace(tzinfo=timezone.utc)
        return t.astimezone().strftime("%Y-%m-%d %H:%M")
    except (ValueError, TypeError):
        return None


def compact_scope(jsonl_path: Path, offset: int) -> tuple[int, str | None]:
    """(how many times this session was compacted past `offset`, local time of
    the last one).

    A compact writes a `system` / `compact_boundary` line whose parentUuid is
    None — a new root. Resuming walks the chain back to that root, so the turns
    above it are in the file but never in the resumed context. That makes the
    selfwrite dub something less than "the conversation it lived", and the
    writer cannot know it from the inside: its context looks complete. The
    engine can see it from the file, so the engine is what tells it.

    Scoped past `offset` for the same reason the delta boundary is: a compact
    the previous review already wrote up is not this write's problem."""
    count, newest = 0, None
    try:
        with jsonl_path.open() as f:
            if offset > 0:
                f.seek(offset)   # append-only file: recorded size = line boundary
            for line in f:
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not (e.get("type") == "compacted" or (e.get("type") == "system" and e.get("subtype") == "compact_boundary")):
                    continue
                count += 1
                ts = e.get("timestamp")
                if ts and (newest is None or ts > newest):
                    newest = ts
    except OSError:
        return 0, None
    return count, _local_stamp(newest)


def last_reviewed_boundary(jsonl_path: Path, offset: int) -> str | None:
    """Local 'YYYY-MM-DD HH:MM' of the last user/assistant message within the
    first `offset` bytes — the portion the previous review already covered.
    None when the session was never reviewed (offset 0) or no timestamp lands
    in that span. The JSONL is append-only, so the recorded size is a stable
    boundary into the same content it covered."""
    if offset <= 0:
        return None
    try:
        with jsonl_path.open("rb") as f:
            blob = f.read(offset)
    except OSError:
        return None
    newest = None
    for raw in blob.splitlines():
        try:
            e = json.loads(raw)
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue
        if e.get("type") not in ("user", "assistant") and not (e.get("type") == "response_item" and (e.get("payload") or {}).get("type") == "message"):
            continue
        ts = e.get("timestamp")
        if ts and (newest is None or ts > newest):
            newest = ts
    return _local_stamp(newest)


# ------------------------------------------------------------ selfwrite dubs

def _dubs_dir() -> Path:
    d = CFG["state_dir"] / "dubs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def sweep_stale_dubs() -> None:
    """Remove leftover selfwrite dubs whose owning engine died before its
    cleanup ran (SIGKILL/reboot mid-spawn). A leaked dub is a phantom duplicate
    in the resume picker — the exact pollution the dub flow exists to prevent —
    so every engine run sweeps the registry of dead-pid records."""
    d = CFG["state_dir"] / "dubs"
    if not d.is_dir():
        return
    for rec in d.iterdir():
        try:
            pid_s, _, dub_path = rec.read_text().strip().partition(" ")
        except OSError:
            continue
        try:
            os.kill(int(pid_s), 0)
            continue  # owner alive — its finally-cleanup owns this dub
        except (ProcessLookupError, ValueError):
            pass      # dead owner or garbage record — sweep
        except (PermissionError, OSError):
            continue  # can't tell — leave it
        try:
            if dub_path:
                if metadata(dub_path):
                    with CodexRPC() as rpc:
                        rpc.call("thread/delete", {"threadId": rec.name})
                else:
                    Path(dub_path).unlink(missing_ok=True)
            rec.unlink(missing_ok=True)
            _log(f"DUB_SWEPT {rec.name[:8]} (owner {pid_s} dead)")
        except (OSError, RuntimeError, TimeoutError):
            pass


def has_new_user_prose(jsonl_path: Path, offset: int) -> bool:
    """Real user input past `offset` (the transcript size at the last review).
    Resuming a session and closing it without typing appends no user prose —
    reviewing that again burns a full spawn on nothing. Injected content
    (system-reminders, command wrappers, task notifications, local-command
    caveats) is not user prose."""
    try:
        with jsonl_path.open() as f:
            if offset > 0:
                f.seek(offset)   # append-only file: recorded size = line boundary
            for line in f:
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                text = user_text(e).strip()
                if text and not text.startswith(("<", "Caveat:")):
                    return True
    except OSError:
        return True   # can't read → don't silently swallow a review
    return False


def is_telegram_session(session_id: str, jsonl_path: Path) -> bool:
    """TG sessions arrive as many short claude --print runs; they need the
    per-agent debounce. Detection: optional host classifier cmd, then
    transcript markers."""
    cmd = CFG["tg_classify_cmd"]
    if cmd:
        try:
            r = subprocess.run([str(Path(cmd).expanduser()), session_id],
                               capture_output=True, timeout=30)
            if r.returncode == 0:
                return True
        except Exception:
            pass
    try:
        for text in _iter_user_texts(jsonl_path):
            if not text:
                continue
            if "DM from" in text or "Group from" in text:
                return True
            if "channel=telegram" in text or '"channel": "telegram"' in text:
                return True
    except Exception:
        pass
    return False


def _telegram_cooldown() -> int:
    f = CFG["telegram_cooldown_file"]
    if f:
        try:
            return int(json.loads(Path(f).expanduser().read_text())
                       .get("telegram_cooldown_seconds",
                            CFG["telegram_cooldown_seconds"]))
        except Exception:
            pass
    return int(CFG["telegram_cooldown_seconds"])


def debounce_telegram(session_id: str, agent: str) -> bool:
    """Per-AGENT marker (TG turns land in many session UUIDs): sleep the
    cooldown; if a newer session_end overwrote the marker meanwhile, yield
    to that later checker."""
    cooldown = _telegram_cooldown()
    debounce_dir = CFG["state_dir"] / "debounce"
    debounce_dir.mkdir(parents=True, exist_ok=True)
    marker = debounce_dir / f"tg-{agent}"
    my_ts = f"{time.time():.6f}"
    marker.write_text(f"{my_ts}\n{session_id}\n")

    _log(f"DEBOUNCE tg-{agent} ({session_id[:8]}): sleeping {cooldown}s")
    time.sleep(cooldown)

    try:
        current = marker.read_text().strip().split("\n")
        if (current[0] if current else "") != my_ts:
            current_sid = current[1] if len(current) > 1 else "?"
            _log(f"DEBOUNCE tg-{agent} ({session_id[:8]}): superseded by {current_sid[:8]}")
            return False
    except FileNotFoundError:
        _log(f"DEBOUNCE tg-{agent} ({session_id[:8]}): marker gone, skipping")
        return False
    try:
        marker.unlink()
    except FileNotFoundError:
        pass
    return True


def acquire_review_slot(session_id: str, agent: str):
    """One of max_concurrent flock slots (review spawns are memory-heavy).
    Lock dies with the process — no stale-lock cleanup needed."""
    slot_dir = CFG["state_dir"] / "slots"
    slot_dir.mkdir(parents=True, exist_ok=True)
    slot_paths = [slot_dir / f"slot-{i}.lock" for i in range(int(CFG["max_concurrent"]))]
    deadline = time.time() + int(CFG["slot_wait_secs"])
    waited_logged = False

    while True:
        for i, path in enumerate(slot_paths):
            fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o644)
            fh = os.fdopen(fd, "r+")
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fh.seek(0)
                fh.truncate()
                fh.write(f"{os.getpid()} {session_id} {agent} {time.time():.0f}\n")
                fh.flush()
                if waited_logged:
                    _log(f"SLOT_ACQUIRED {session_id[:8]} → {agent} (slot {i})")
                return fh
            except (IOError, OSError):
                fh.close()
                continue
        if time.time() >= deadline:
            return None
        if not waited_logged:
            _log(f"SLOT_WAIT {session_id[:8]} → {agent}: all {len(slot_paths)} slots busy")
            waited_logged = True
        time.sleep(int(CFG["slot_poll_secs"]))


# -------------------------------------------------------------- spawn + gate

def _selfwrite_env(origin: str = "direct") -> dict:
    """PATH + tool env shared by the self-write resume (mirrors spawn_review).

    origin rides as JSTACK_TIMELINE_ORIGIN so the spawned turn's log_event
    stamps who drove the session being written about: a human (direct) or
    an auto_review_submodes cron (indirect)."""
    env = os.environ.copy()
    env.pop("CODEX_THREAD_ID", None)
    env.pop("CLAUDE_CODE_SESSION_ID", None)
    extra = [str(PLUGIN_BIN)] + [str(Path(p).expanduser()) for p in CFG["extra_path"]]
    env["PATH"] = ":".join(
        extra
        + ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
        + [env.get("PATH", "")]
    )
    env["SKIP_SESSION_HOOK"] = "1"           # the resume's own SessionEnd must not recurse
    env["CLAUDE_PLUGIN_ROOT"] = str(PLUGIN_BIN.parent)
    env["JSTACK_TIMELINE_DIR"] = str(CFG["timeline_dir"])
    env["JSTACK_TIMELINE_ORIGIN"] = origin
    return env


def spawn_selfwrite(session_id: str, agent: str, agent_title: str,
                    submode: str, jsonl_path: Path,
                    origin: str = "direct", boundary: str | None = None,
                    compacted: tuple[int, str | None] = (0, None)) -> bool | None:
    """Resume a disposable DUPLICATE of the just-ended session for ONE turn so
    it writes the original's running memory — one seat-tagged timeline entry —
    instead of paying a fresh stranger to re-derive what the session already
    knows.

    Cheap by construction: the dub carries the conversation (all of it, unless
    it compacted — see `compacted` below), so this is
    ~1 turn, not the ~50-turn multi-phase review. The write lands in the dub,
    which is DELETED afterwards — the primary session JSONL is never touched,
    so resuming it later starts exactly where the user left off, with no
    trailing self-write turn in context or the picker. The timeline entry and
    the dashboard stamp reference the ORIGINAL session id throughout.

    `boundary` (last-reviewed local time, computed by the caller from the
    recorded offset) is non-None only when this session was reviewed at a
    previous end — the prompt then scopes the entry to the delta after it.

    `compacted` (count, local time of the last compact) is non-zero only when
    the session compacted — the case where the dub does NOT carry the full
    conversation, so the prompt sends the writer to the transcript for the part
    the resume left behind.
    """
    env = _selfwrite_env(origin)
    stamp_step = (
        SELFWRITE_STAMP_STEP.format(session_id=session_id)
        if shutil.which("review_sessions.py", path=env["PATH"]) else ""
    )
    n_compacts, last_compact = compacted
    compact_note = ""
    if n_compacts and last_compact:
        compact_note = SELFWRITE_COMPACT_NOTE.format(
            count_phrase="once" if n_compacts == 1 else f"{n_compacts} times",
            when=last_compact, jsonl_path=jsonl_path,
        )
    prompt = SELFWRITE_PROMPT.format(
        marker=SELFWRITE_MARKER, agent=agent, agent_title=agent_title,
        submode=submode, session_id=session_id, stamp_step=stamp_step,
        delta_note=SELFWRITE_DELTA_NOTE.format(boundary=boundary) if boundary else "",
        compact_note=compact_note,
    )
    extra_prompt = CFG.get("selfwrite_extra_prompt")
    if isinstance(extra_prompt, str) and extra_prompt.strip():
        prompt += "\n\n" + extra_prompt
    stamp = last_reviewed_boundary(jsonl_path, jsonl_path.stat().st_size)
    if stamp:
        date, at = stamp.split(" ")
        prompt += (f"\nUse exactly --date {date} --at {at} for the timeline entry: "
                   "this is the source transcript's last-message local timestamp. "
                   "Do not substitute the current clock time.")

    # Dub the transcript — the write happens in this disposable duplicate so the
    # primary JSONL stays exactly as the user left it. The dub lives in the same
    # project dir (that's where --resume finds it) under a scratch title.
    native = bool(metadata(jsonl_path))
    dub_err = ""
    try:
        if native:
            with CodexRPC() as rpc:
                fork = rpc.call("thread/fork", {"threadId": session_id, "excludeTurns": True, "deferGoalContinuation": True})["thread"]
            dub_id, dub_path = fork["id"], Path(fork["path"])
        else:
            r = subprocess.run(
                [str(PLUGIN_BIN / "dub-session"), session_id, jsonl_path.parent.name,
                 " · selfwrite scratch"], capture_output=True, text=True, timeout=60)
            dub_id = (r.stdout or "").strip() if r.returncode == 0 else ""
            dub_err = (r.stderr or "")[:200]
            dub_path = jsonl_path.parent / f"{dub_id}.jsonl"
    except Exception as e:
        dub_id, dub_err = "", str(e)
    if not re.fullmatch(r"[0-9a-f-]{36}", dub_id or ""):
        _log(f"SELFWRITE_FAIL {session_id[:8]} → {agent}: dub failed: {dub_err}")
        return
    # Pid-stamped registry record: if this engine dies before the finally below
    # runs (SIGKILL/reboot), the next engine run's sweep_stale_dubs removes the
    # orphan instead of leaving a phantom duplicate in the resume picker.
    dub_rec = _dubs_dir() / dub_id
    try:
        dub_rec.write_text(f"{os.getpid()} {dub_path}\n")
    except OSError:
        pass

    cmd = [
        "claude", "--print",
        "--output-format", "text",
        "--model", str(CFG["selfwrite_model"]),
        "--permission-mode", "bypassPermissions",
        "--max-turns", str(CFG["selfwrite_max_turns"]),
        # NO --name: the dub is deleted after the write, a title would be wasted.
        "--resume", dub_id,
        "-p", prompt,
    ]
    if native:
        cmd = ["codex", "exec", "resume", dub_id,
               "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
               "--skip-git-repo-check", "-c", "bypass_hook_trust=true",
               "-m", str(CFG.get("codex_selfwrite_model", "gpt-5.6-luna")),
               "-c", "model_reasoning_effort=low", prompt]
    # Resume from the session's own cwd so tools + Claude project resolution behave
    # natively; fall back to the sub-mode workspace, then the agent root.
    cwd = _session_cwd(jsonl_path) or str(CFG["agent_root"] / agent_title / submode)
    if not Path(cwd).is_dir():
        cwd = str(CFG["agent_root"] / agent_title)

    notes = ""
    if boundary:
        notes += f", delta since {boundary}"
    if compact_note:
        notes += f", compacted x{n_compacts} (last {last_compact})"
    _log(f"SELFWRITE {session_id[:8]} → {agent}/{submode} (dub {dub_id[:8]}{notes})")
    # Snapshot the store before the spawn, exactly as spawn_review does: the
    # artifact of a self-write is a timeline row, and a clean exit is not
    # evidence that one appeared.
    pre_max_id = _timeline_max_id(CFG["timeline_dir"])
    try:
        return _selfwrite_outcome(cmd, cwd, env, session_id, agent, pre_max_id, dub_path)
    finally:
        # The timeline row is the artifact; the dub is scratch. Remove it on
        # every exit path so nothing ever accumulates in the resume picker —
        # after post_selfwrite_cmd, which reads the self-write's reply from it.
        try:
            if native:
                with CodexRPC() as rpc:
                    rpc.call("thread/delete", {"threadId": dub_id})
            else:
                dub_path.unlink(missing_ok=True)
            dub_rec.unlink(missing_ok=True)
        except (OSError, RuntimeError, TimeoutError):
            pass


def _selfwrite_outcome(cmd: list, cwd: str, env: dict, session_id: str,
                       agent: str, pre_max_id: int, dub_path: Path) -> bool | None:
    """Run the one-turn resume and settle what it did (spawn_selfwrite owns
    the dub's lifetime around this call)."""
    try:
        result = subprocess.run(
            cmd, cwd=cwd, capture_output=True, text=True,
            env=env, timeout=int(CFG["selfwrite_timeout_secs"]),
        )
    except subprocess.TimeoutExpired:
        _log(f"SELFWRITE_TIMEOUT {session_id[:8]} → {agent}")
        return
    except Exception as e:
        _log(f"SELFWRITE_ERR {session_id[:8]} → {agent}: {e}")
        return

    if result.returncode != 0:
        blob = (result.stdout or "") + (result.stderr or "")
        if is_session_limit(blob):
            _log(f"RATE_LIMITED {session_id[:8]} → {agent}: hit Claude session limit — skipping")
            return
        _log(f"SELFWRITE_FAIL {session_id[:8]} → {agent}: "
             f"exit {result.returncode}: {(result.stderr or '')[:200]}")
        return

    # Three outcomes, three log lines. SELFWRITE_DONE used to fire on exit 0
    # alone, so a dub that wrote nothing — or claimed a log_event that never
    # executed — was indistinguishable from one that filed an entry, and the
    # seat silently kept booting cold while the log read as success.
    #
    # Skipping IS legitimate here (the prompt says so: "if nothing this session
    # is timeline-worthy, SKIP this step"), which is why a missing row cannot
    # simply be an error the way it is on the review path. The claim in the
    # dub's own output is what separates a deliberate skip from a silent
    # failure — the same `log_event\b` heuristic validate_review_output uses.
    out = result.stdout or ""
    grew = _timeline_max_id(CFG["timeline_dir"]) > pre_max_id
    claimed = bool(re.search(r"log_event\b", out))
    # The dub is deleted on every exit path, so its output is the only surviving
    # record of why nothing was written. Carry a slice of it into the log.
    tail = " ".join(out.split())[-200:]

    if grew:
        _log(f"SELFWRITE_DONE {session_id[:8]} → {agent} ({len(out)} chars, +1 entry)")
        run_post_selfwrite(session_id, dub_path, env)
        return True
    elif claimed:
        _log(f"SELFWRITE_NOROW {session_id[:8]} → {agent}: claimed log_event but no "
             f"timeline row appeared (command never executed): {tail}")
    else:
        _log(f"SELFWRITE_NOENTRY {session_id[:8]} → {agent}: dub wrote no entry: {tail}")
        return True
    return False


POST_SELFWRITE_TIMEOUT_SECS = 120


def run_post_selfwrite(session_id: str, transcript: Path, env: dict) -> str | None:
    """Run the host's post_selfwrite_cmd as <cmd> <session_id> <transcript>.

    `transcript` is the self-write's own transcript, so the host can read what
    the turn wrote in answer to selfwrite_extra_prompt. The command is a
    string split like a shell would (so it may carry a subcommand), with `~`
    expanded, run with the spawn's PATH. Its result is logged and returned,
    never raised: the entry is already filed, and nothing a host hook does can
    un-write it. Returns "ok" | "fail" | "timeout", or None when unset."""
    raw = CFG.get("post_selfwrite_cmd")
    if not isinstance(raw, str) or not raw.strip():
        return None
    try:
        argv = [os.path.expanduser(a) for a in shlex.split(raw)]
    except ValueError as e:
        _log(f"POST_SELFWRITE fail {session_id[:8]}: bad command: {e}")
        return "fail"
    try:
        r = subprocess.run(argv + [session_id, str(transcript)],
                           capture_output=True, text=True, env=env,
                           timeout=POST_SELFWRITE_TIMEOUT_SECS)
    except subprocess.TimeoutExpired:
        _log(f"POST_SELFWRITE timeout {session_id[:8]}: after {POST_SELFWRITE_TIMEOUT_SECS}s")
        return "timeout"
    except Exception as e:
        _log(f"POST_SELFWRITE fail {session_id[:8]}: {e}")
        return "fail"
    tail = " ".join(((r.stdout or "") + " " + (r.stderr or "")).split())[-200:]
    if r.returncode != 0:
        _log(f"POST_SELFWRITE fail {session_id[:8]}: exit {r.returncode}: {tail}")
        return "fail"
    _log(f"POST_SELFWRITE ok {session_id[:8]}: {tail}")
    return "ok"


def spawn_review(session_id: str, agent: str, agent_title: str,
                 origin: str = "direct", boundary: str | None = None) -> bool | None:
    workspace = CFG["agent_root"] / agent_title
    if not workspace.exists():
        _log(f"SKIP {session_id[:8]}: workspace {workspace} not found")
        return

    base_invocation = f"{CFG['skill_invocation']} {session_id}"
    if boundary:
        base_invocation = (
            f"[RESUME DELTA: this session was already reviewed through {boundary} "
            f"local time — review ONLY the portion after that point; earlier "
            f"timeline entries cover the rest.]\n{base_invocation}"
        )
    max_attempts = int(CFG["max_attempts"])
    last_failure = ""

    for attempt in range(1, max_attempts + 1):
        if attempt == 1:
            prompt = f"{REVIEW_MARKER}\n\n{base_invocation}"
        else:
            prompt = (
                f"{REVIEW_MARKER}\n"
                f"[RETRY {attempt}/{max_attempts}: prior output rejected — {last_failure}]\n\n"
                f"{base_invocation}"
            )

        cmd = [
            "claude", "--print",
            "--output-format", "text",
            "--model", str(CFG["model"]),
            "--permission-mode", "bypassPermissions",
            "--max-turns", str(CFG["max_turns"]),
            "--name", f"Review: {agent} ({session_id[:8]}){'/retry' if attempt > 1 else ''}",
            "-p", prompt,
        ]
        jsonl_path, _ = find_session(session_id)
        if jsonl_path and metadata(jsonl_path):
            prompt = (
                f"{prompt}\nRead and follow {PLUGIN_BIN.parent}/skills/"
                f"post-session-review/SKILL.md. ARGUMENTS={session_id}. "
                f"CLAUDE_PLUGIN_ROOT={PLUGIN_BIN.parent}. This is a fresh "
                "review of the source transcript, not a resume of its thread."
            )
            cmd = ["codex", "exec", "--skip-git-repo-check",
                   "--dangerously-bypass-approvals-and-sandbox",
                   "--dangerously-bypass-hook-trust",
                   "-c", "bypass_hook_trust=true",
                   "-m", str(CFG["codex_review_model"]), prompt]

        env = _selfwrite_env(origin)
        extra = [str(PLUGIN_BIN)] + [str(Path(p).expanduser()) for p in CFG["extra_path"]]
        env["PATH"] = ":".join(
            extra
            + ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
            + [env.get("PATH", "")]
        )
        env["SKIP_SESSION_HOOK"] = "1"
        env["JSTACK_TIMELINE_DIR"] = str(CFG["timeline_dir"])
        env["JSTACK_TIMELINE_ORIGIN"] = origin

        # Snapshot the store before the spawn: a claimed log_event must show
        # up as a new row, whatever day it filed under (--date of the last
        # real message when a session ends days after its last real work).
        pre_max_id = _timeline_max_id(CFG["timeline_dir"])

        _log(f"SPAWN {session_id[:8]} → {agent} (attempt {attempt}, workspace: {workspace.name})")

        try:
            result = subprocess.run(
                cmd,
                cwd=str(workspace),
                capture_output=True,
                text=True,
                env=env,
                timeout=int(CFG["timeout_secs"]),
            )
        except subprocess.TimeoutExpired:
            last_failure = f"timeout after {CFG['timeout_secs']}s"
            _log(f"TIMEOUT {session_id[:8]} → {agent} (attempt {attempt})")
            continue

        if result.returncode != 0:
            # Usage-limit exhaustion is transient, not a review-content failure:
            # do not burn the retry or escalate — the next session end reviews fresh.
            if is_session_limit((result.stdout or "") + (result.stderr or "")):
                _log(f"RATE_LIMITED {session_id[:8]} → {agent} (attempt {attempt}): "
                     "hit Claude session limit — skipping, not escalating")
                return
            last_failure = f"exit {result.returncode}: {(result.stderr or '')[:200]}"
            _log(f"NONZERO {session_id[:8]} → {agent} (attempt {attempt}): {last_failure}")
            # A negative returncode means the child was killed by a signal (e.g.
            # SIGKILL/-9 from macOS jetsam under memory pressure), not a review-
            # content failure. Retrying immediately just gets killed again by the
            # same transient condition — burning every attempt in seconds and
            # escalating a blip into a page. Back off so the pressure can clear.
            backoff = int(CFG["signal_retry_backoff_secs"])
            if result.returncode < 0 and attempt < max_attempts and backoff > 0:
                _log(f"BACKOFF {session_id[:8]} → {agent}: killed by signal "
                     f"{-result.returncode}, waiting {backoff}s before retry")
                time.sleep(backoff)
            continue

        post_max_id = _timeline_max_id(CFG["timeline_dir"])
        ok, reason = validate_review_output(
            result.stdout,
            CFG["required_sections"],
            timeline_grew=(post_max_id > pre_max_id),
        )
        if ok:
            _log(f"DONE {session_id[:8]} → {agent} (attempt {attempt}, {len(result.stdout)} chars)")
            return True

        last_failure = reason
        _log(f"INVALID {session_id[:8]} → {agent} (attempt {attempt}): {reason}")

    _log(f"BLOCKED {session_id[:8]} → {agent}: {max_attempts} attempts failed — {last_failure}")
    if last_failure and last_failure.startswith("exit -"):
        # Died by signal every attempt: a deliberate kill (board Kill button,
        # operator pkill) or memory pressure — neither is a review-content
        # failure worth paging anyone about.
        _log(f"KILLED {session_id[:8]} → {agent}: signal death, not escalating")
        return
    if CFG["escalate_cmd"]:
        try:
            subprocess.run(
                [str(Path(CFG["escalate_cmd"]).expanduser()), agent, session_id,
                 f"Post-session review failed after {max_attempts} attempts: {last_failure}"],
                timeout=60, check=False, capture_output=True,
            )
            _log(f"ESCALATED {session_id[:8]} → {agent}")
        except Exception as e:
            _log(f"ESCALATE_FAIL {session_id[:8]} → {agent}: {e}")


def _extract_section(output: str, header: str) -> str:
    """Text between '## {header}' and the next '## ' header (or end)."""
    pattern = rf"## {re.escape(header)}\b(.*?)(?=\n## |\Z)"
    m = re.search(pattern, output, re.DOTALL)
    return m.group(1) if m else ""


def _timeline_max_id(timeline_dir: Path) -> int:
    """Highest entry id in the timeline db (0 if no db/rows yet).

    Store-wide because log_event may file under a prior day (--date of the
    last real message), so any new row — whatever its date — counts."""
    db = timeline_dir / "timeline.db"
    if not db.exists():
        return 0
    try:
        import sqlite3
        con = sqlite3.connect(db, timeout=10)
        try:
            row = con.execute("SELECT COALESCE(MAX(id), 0) FROM entries").fetchone()
            return int(row[0]) if row else 0
        finally:
            con.close()
    except Exception:
        return 0


def validate_review_output(output: str, required_sections: list[str],
                           timeline_grew: bool = True) -> tuple[bool, str]:
    """(ok, reason). Required-section presence + per-section evidence floors.

    timeline_grew: did the timeline db actually gain a row during the
    spawn — if the model claimed `log_event` but no row appeared, the
    call never executed (the silent-pass bug this gate exists for)."""
    missing = [s for s in required_sections if f"## {s}" not in output]
    if missing:
        return False, f"missing sections: {', '.join(missing)}"

    if "TRANSCRIPT_WALK" in required_sections:
        walk = _extract_section(output, "TRANSCRIPT_WALK")
        has_turns = bool(re.search(r"^\s*-\s+turn\b", walk, re.MULTILINE))
        has_no_turns_phrase = bool(re.search(
            r"no user turns|no\s+boss\s+(prose|turns|interaction|messages|input)|"
            r"cron[\s-]+triggered.*(no|zero).*\b(boss|user|interaction)|"
            r"openclaw bootstrap.*only|skill payload only|"
            r"zero\s+(boss|user)\s+(prose|turns)",
            walk, re.IGNORECASE,
        ))
        if not (has_turns or has_no_turns_phrase):
            return False, "TRANSCRIPT_WALK lacks turn entries and 'no user turns' note"

    if "DOC_RECONCILE" in required_sections:
        doc = _extract_section(output, "DOC_RECONCILE")
        has_doc_items = bool(re.search(r"^\s*-\s+", doc, re.MULTILINE))
        has_clean_citation = bool(re.search(r"clean\s*[-—–]\s*examined", doc, re.IGNORECASE))
        if not (has_doc_items or has_clean_citation):
            return False, "DOC_RECONCILE has no items and no 'clean — examined' citation"

    if "ACTIONS_TAKEN" in required_sections:
        actions = _extract_section(output, "ACTIONS_TAKEN")
        has_action_items = bool(re.search(r"^\s*-\s+", actions, re.MULTILINE))
        has_none_justified = bool(re.search(r"none\s*[-—–].*walked", actions,
                                            re.IGNORECASE | re.DOTALL))
        if not (has_action_items or has_none_justified):
            return False, "ACTIONS_TAKEN has no items and no 'none — N walked' justification"

    if "TIMELINE" in required_sections:
        timeline = _extract_section(output, "TIMELINE")
        has_log_event = bool(re.search(r"log_event\b", timeline))
        has_timeline_none = bool(re.search(r"none\s*[-—–]\s*\S", timeline, re.IGNORECASE))
        if not (has_log_event or has_timeline_none):
            return False, "TIMELINE has no log_event invocation and no 'none — {reason}' justification"
        # Silent-pass guard: only when the model affirmatively claims an
        # invocation. A 'none — {reason}' justification is a deliberate skip
        # (e.g. the entry already exists, re-logging would duplicate) and may
        # legitimately mention the word log_event in its reason — don't treat
        # that mention as a phantom invocation.
        if has_log_event and not has_timeline_none and not timeline_grew:
            return False, "TIMELINE claimed log_event but timeline file did not grow (command never executed)"

    return True, ""


# --------------------------------------------------------------------- main

def main():
    if os.environ.get("JSTACK_REVIEW_DISABLED") == "1":
        sys.exit(0)
    if len(sys.argv) < 2:
        print("Usage: session-review-spawn <session_id> [transcript_path]", file=sys.stderr)
        sys.exit(1)

    session_id = sys.argv[1]
    transcript_hint = sys.argv[2] if len(sys.argv) > 2 else None

    if not claim_session(session_id):
        sys.exit(0)

    # Orphan hygiene — reap selfwrite dubs leaked by an engine that died
    # mid-spawn, before this run possibly creates its own.
    sweep_stale_dubs()

    # Brief pause — session JSONL may still be finalizing
    time.sleep(2)

    jsonl_path, agent = find_session(session_id, transcript_hint)

    if not jsonl_path or not agent:
        if not jsonl_path and report_blackhole(session_id):
            sys.exit(0)
        _log(f"SKIP {session_id[:8]}: no agent match (path={jsonl_path})")
        sys.exit(0)

    agents = reviewable_agents(CFG["agent_root"])
    agent_title = agents.get(agent)
    if not agent_title:
        _log(f"SKIP {session_id[:8]}: agent '{agent}' not reviewable")
        sys.exit(0)

    if is_review_session(jsonl_path):
        _log(f"SKIP {session_id[:8]}: is a review session (loop prevention)")
        sys.exit(0)

    submode = resolve_submode(jsonl_path, CFG["agent_root"], agent_title)

    # Auto sessions — no human typed, no TUI attached, not a Telegram
    # conversation — normally get NO model review (reviewing the high-frequency
    # auto flood is token waste). Their timeline line is written IN-SESSION by
    # the Stop hook (hooks/stop-timeline-remind.py). EXCEPTION: the purpose-built
    # recurring crons in auto_review_submodes (e.g. a nightly PM cron, a meta
    # review) — they get the purpose-prompted engine self-write (seat-tagged
    # timeline entry + dashboard stamp) instead of the reminder-quality line.
    is_auto = (not is_user_engaged(jsonl_path)
               and not is_telegram_session(session_id, jsonl_path))
    if is_auto:
        if not auto_reviewed(agent, submode, CFG.get("auto_review_submodes")):
            _log(f"AUTO {session_id[:8]} → {agent}: no review (timeline owned by Stop hook)")
            sys.exit(0)
        _log(f"AUTO_REVIEW {session_id[:8]} → {agent}/{submode}: "
             "timeline-critical cron — engine self-write instead of Stop-hook line")
    origin = "indirect" if is_auto else "direct"

    if not submode_reviewed(agent, submode, CFG.get("reviewed_submodes")):
        _log(f"SKIP {session_id[:8]}: sub-mode '{agent}/{submode}' not in reviewed set")
        sys.exit(0)

    if is_unengaged_filer_briefing(jsonl_path):
        _log(f"SKIP {session_id[:8]}: filer briefing with no user interaction")
        sys.exit(0)

    try:
        if jsonl_path.stat().st_size < int(CFG["min_session_bytes"]):
            _log(f"SKIP {session_id[:8]}: too small ({jsonl_path.stat().st_size}B)")
            sys.exit(0)
    except OSError:
        pass

    if not has_recent_activity(jsonl_path):
        _log(f"SKIP {session_id[:8]}: no recent activity (reopen-and-close)")
        sys.exit(0)

    prior = reviewed_offset(session_id)
    if not has_new_user_prose(jsonl_path, prior):
        _log(f"SKIP {session_id[:8]}: no new user input since last review (offset {prior})")
        sys.exit(0)

    if is_telegram_session(session_id, jsonl_path):
        _log(f"TELEGRAM {session_id[:8]} → {agent}: entering debounce")
        if not debounce_telegram(session_id, agent):
            sys.exit(0)
        _log(f"TELEGRAM {session_id[:8]} → {agent}: conversation quiet, reviewing")

    action = CFG.get("session_end_action", "selfwrite")
    if action == "off":
        _log(f"OFF {session_id[:8]} → {agent}: session_end_action=off")
        sys.exit(0)

    slot = acquire_review_slot(session_id, agent)
    if slot is None:
        _log(f"SLOT_TIMEOUT {session_id[:8]} → {agent}: gave up after {CFG['slot_wait_secs']}s")
        sys.exit(0)

    # The delta boundary is computed from the PRIOR offset before it is
    # re-recorded below — non-None only when this session was reviewed at an
    # earlier end (a resume that ended again). Purely mechanical: recorded
    # byte offset → last covered timestamp → injected scope.
    boundary = last_reviewed_boundary(jsonl_path, prior)
    # Same scoping, different loss: a compact past the prior offset means the
    # selfwrite dub resumes into a summary, not the conversation. Only the
    # selfwrite path needs telling — `review` reads the JSONL line by line and
    # so already sees the turns a resume drops.
    compacted = compact_scope(jsonl_path, prior)

    try:
        source_size = jsonl_path.stat().st_size
        if action == "review":
            completed = spawn_review(session_id, agent, agent_title, origin, boundary)
        else:  # "selfwrite" (default) — a disposable dub writes the session's memory
            completed = spawn_selfwrite(session_id, agent, agent_title, submode, jsonl_path,
                                       origin, boundary, compacted)
        if completed:
            record_reviewed_offset(session_id, source_size)
    finally:
        slot.close()


if __name__ == "__main__":
    main()
