#!/usr/bin/env python3
"""seat — resolve a seat address the way every jStack command resolves it.

  seat @alice-social            the seat directory it names
  seat --id @alice-social       the canonical address, which round-trips
  seat --timeline @alice-social the log_event/timeline spelling
  seat --here [dir]             the address of the seat containing dir (cwd)
  seat --list                   every seat on this machine, one address a line

The grammar: an agent alone is its cockpit, hyphens walk down the seat tree,
and a seat holding its own `chat/` resolves to that operator seat. A leading
`@` is optional. Unknown names exit 2 with the seats or agents that do exist —
never a guessed path.

This exists so a skill, a shell, or a person can ask the same resolver the
hooks ask, instead of each re-deriving the grammar from a directory listing.
Three spellings of one seat were being hand-built at their use sites and they
drifted; every spelling here comes from a single resolution.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import root as _root  # noqa: E402

USAGE = __doc__.split("\n\n")[1].strip()


def _fail(msg: str, code: int = 2) -> "None":
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def _sender() -> "str|None":
    seat = _root.enclosing_seat(Path.cwd())
    return seat.timeline if seat else None


def main(argv: "list[str]") -> int:
    args = [a for a in argv if a not in ("-h", "--help")]
    if len(args) != len(argv) or not args:
        print(USAGE)
        return 0 if len(args) != len(argv) else 2

    mode, rest = "path", args
    if args[0].startswith("--"):
        mode, rest = args[0][2:], args[1:]

    if mode == "list":
        base = _root.agents_dir()
        out = []
        for name in _root.agents():
            agent_dir = base / name
            for p in sorted(agent_dir.rglob("CLAUDE.md")):
                seat = _root.seat_at(p.parent)
                # rglob reaches into pads, scratch dirs and checkouts; only a
                # directory the resolver itself calls a seat is listed.
                if seat is not None and _root.enclosing_seat(p.parent) == seat:
                    out.append(seat.id)
        print("\n".join(sorted(set(out))))
        return 0

    if mode == "here":
        where = Path(rest[0]).expanduser() if rest else Path.cwd()
        seat = _root.enclosing_seat(where)
        if seat is None:
            _fail(f"{where} is not inside an agent workspace "
                  f"({_root.agents_dir()})")
        print(seat.id)
        return 0

    if mode not in ("path", "id", "timeline"):
        _fail(f"unknown option --{mode}\n\n{USAGE}")
    if not rest:
        _fail(f"--{mode} needs an address\n\n{USAGE}")

    try:
        seat = _root.resolve_seat(rest[0], sender=_sender())
    except _root.AddressError as exc:
        _fail(str(exc))
    print({"path": seat.path, "id": seat.id, "timeline": seat.timeline}[mode])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
