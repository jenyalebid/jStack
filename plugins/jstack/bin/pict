#!/usr/bin/env python3
"""
pict — Prompt Injection Checking Tool
=====================================

Renders EVERYTHING that would be injected into a Claude Code session spawned
from a given directory, as ONE markdown document, in the order the model
receives it. The composed view — not the per-file view — is where redundancy,
drift, and bloat across a walk-up chain become visible.

Contract:  pict [dir] [options]          (default dir: cwd; markdown on stdout)

Options:

  --bare            the injection and nothing else — every loaded body in
                    wire order, each under its path. No weight table, no
                    mechanism notes, no on-demand layer, no hook inventory.
                    The reading copy: what the context IS, where the default
                    view answers why each file is in it and what it costs.

Options — describe the spawn being previewed:

  --headless        preview a headless spawn (`claude --print`): interactive-
                    only injectors go quiet (same as PICT_INTERACTIVE=0)
  --no-memory       the spawn env sets CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 —
                    the auto-memory index never loads
  --append FILE     content the spawner passes via --append-system-prompt,
                    in the order given (repeatable)
  --prompt TEXT     the -p payload. A `/command` prompt is resolved the way
                    the harness resolves it (nearest `.claude/commands/` on
                    the walk-up from the spawn dir, then <claude_dir>/commands)
                    and its full body inlined at its true position — the
                    expansion IS the first user message.
  --serve FILE      a captured tool-served payload (a context blob some tool
                    returned mid-session); rendered at the tail of the
                    injection order (repeatable)
  --exec-hooks      actually RUN SessionStart hooks — user settings + every
                    installed plugin — and render what each one injects.
                    OFF by default: hook commands are arbitrary programs.
                    The jStack timeline injector is never re-run (its output
                    is already emulated read-only below).
  --request FILE    render a CAPTURED API request body (the JSON POSTed to
                    /v1/messages) instead of emulating: every top-level key,
                    system block, tool schema, and message part, verbatim,
                    in wire order, each attributed to the file (or binary/
                    flag/hook) it loads from. Composite blocks split per
                    source file: harness walk-up blocks by their own
                    markers, everything else by matching block bytes
                    against the attribution pool (the walk-up chain, rules,
                    memory for [dir], plus --sources). Unmatched bytes
                    still render, labeled unattributed; a top-level key the
                    tool doesn't model gets its own verbatim envelope
                    section — nothing in the body is ever invisible. This
                    is the byte-truth mode — emulation cannot see the base
                    system prompt or tool schemas; a capture can.
  --sources PATH    add a file (or a dir, *.md recursive) to the attribution
                    pool for --request file-boundary matching (repeatable).
                    Pool also reads $PICT_SOURCES (colon-separated paths)
                    and <claude_dir>/pict-sources.txt (one path or glob per
                    line, ~ allowed, # comments).

Stages, in wire order (verified against captured request bodies):

  1. System prompt         — the harness-internal base prompt (named, not
                             renderable by emulation) with any --append
                             content inside it.
  2. First user message,   — <claude_dir>/CLAUDE.md, unconditional rules
     project context         (no `paths:` frontmatter), the CLAUDE.md /
                             CLAUDE.local.md walk-up (parent-most first,
                             HTML comments stripped in flight), the
                             auto-memory index (unless --no-memory) —
                             all inside a <system-reminder> in the first
                             user message, NOT the system prompt.
  3. First user message,   — the --prompt payload; /commands expanded to
     command expansion       their full body with $ARGUMENTS / $1..$n
                             substituted, exactly as the harness does.
  4. After the first       — SessionStart hook context + harness
     message                 reminders. The jStack timeline injection is
                             emulated faithfully (same seat resolution +
                             config as hooks/session-start-inject.py).
                             Other hooks are LISTED unless --exec-hooks
                             runs them.
  5. Mid-session data      — --serve captures, in order given.

Then the on-demand layer: path-scoped rules whose `paths:` globs match a
file that EXISTS under the spawn dir right now (jStack tail-matching
semantics), bodies included — these inject on demand, NEVER at spawn.
Rules with no matching files are listed by name only. Finally every
remaining hook from user settings and all installed plugins, one line each.

Out of scope (native harness, not file composition): the base system prompt,
tool/MCP schemas, the skills/commands description list, session guidance.

A summary table with per-source ~token weights (bytes/4) heads the document.
Structure is real markdown and `#` is pict's lane: every separator — stage,
component, file boundary — is a level-1 heading, so the document outline IS
the injection anatomy. Bodies render as plain markdown text — no code fences
(source editors paint fenced blocks as code) — with ONE visible transform:
content ATX headings render one level deeper than sent (# → ##) so they nest
under pict's separators instead of colliding with them, and a bare ---/===
line directly under text gets a preceding blank so it cannot read as a
setext underline. Where one file ends and the next begins is the point.

Env overrides (tests; same convention as inject-path-rules.py):
  JSTACK_RULES_DIR      — rules source dir        (default <claude_dir>/rules)
  JSTACK_REVIEW_CONFIG  — review/timeline config  (default <claude_dir>/jstack/review.json)
  PICT_CLAUDE_DIR       — the ~/.claude dir       (default ~/.claude)
  PICT_WALK_ROOT        — upper bound of the walk-up (default /)
  PICT_LOG_EVENT        — log_event binary        (default sibling of pict)
  PICT_INTERACTIVE      — "0" to preview a headless spawn (default interactive)

Exit 0 with the document on stdout; exit 64 on usage error. Stdlib only.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import repo_seat  # noqa: E402


def _inject_hook():
    """The SessionStart hook, imported by path — its filename has dashes, so it
    is not importable by name. pict shows what the hook composes; reimplementing
    any of it here would be a second copy that drifts from the thing it claims
    to preview."""
    import importlib.util  # noqa: PLC0415
    path = Path(__file__).resolve().parent.parent / "hooks" / "session-start-inject.py"
    try:
        spec = importlib.util.spec_from_file_location("_jstack_inject", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None

PLUGIN_BIN = Path(__file__).resolve().parent


def claude_dir() -> Path:
    return Path(os.environ.get("PICT_CLAUDE_DIR", str(Path.home() / ".claude"))).expanduser()


def rules_dir() -> Path:
    override = os.environ.get("JSTACK_RULES_DIR")
    return Path(override).expanduser() if override else claude_dir() / "rules"


def walk_root() -> Path:
    return Path(os.environ.get("PICT_WALK_ROOT", "/")).expanduser()


# ---------------------------------------------------------------- frontmatter

def parse_paths_frontmatter(text: str) -> list[str]:
    """`paths:` globs from YAML frontmatter — same accepted shapes as
    hooks/inject-path-rules.py (block list and inline list)."""
    if not text.startswith("---"):
        return []
    end = text.find("\n---", 3)
    if end == -1:
        return []
    block = text[3:end].lstrip("\n")
    paths: list[str] = []
    in_paths = False
    for raw in block.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not raw.startswith(" ") and not raw.startswith("\t"):
            if stripped.startswith("paths:"):
                rest = stripped[len("paths:"):].strip()
                if rest.startswith("[") and rest.endswith("]"):
                    paths.extend(
                        v.strip().strip('"').strip("'")
                        for v in rest[1:-1].split(",") if v.strip()
                    )
                    in_paths = False
                else:
                    in_paths = True
                continue
            in_paths = False
            continue
        if in_paths and stripped.startswith("- "):
            val = stripped[2:].strip().strip('"').strip("'")
            if val:
                paths.append(val)
    return paths


def strip_frontmatter(text: str) -> str:
    if not text.startswith("---"):
        return text
    end = text.find("\n---", 3)
    if end == -1:
        return text
    return text[end + 4:].lstrip("\n")


# ------------------------------------------------------------- glob anchoring

def _glob_to_regex(glob: str) -> str:
    """Same translation as inject-path-rules.py — ** crosses segments,
    * and ? stay within one."""
    out = ["^"]
    i, n = 0, len(glob)
    while i < n:
        c = glob[i]
        if c == "*":
            if i + 1 < n and glob[i + 1] == "*":
                if i + 2 < n and glob[i + 2] == "/":
                    out.append("(?:.*/)?")
                    i += 3
                    continue
                out.append(".*")
                i += 2
                continue
            out.append("[^/]*")
            i += 1
            continue
        if c == "?":
            out.append("[^/]")
            i += 1
            continue
        if c in r".+()[]{}|\^$":
            out.append("\\" + c)
            i += 1
            continue
        out.append(c)
        i += 1
    out.append("$")
    return "".join(out)


def _tail_match(rx: re.Pattern, path: str) -> bool:
    """Full path, then every path tail — inject-path-rules semantics."""
    if rx.match(path):
        return True
    parts = path.split("/")
    return any(rx.match("/".join(parts[i:])) for i in range(1, len(parts)))


SCAN_PRUNE = {".git", "node_modules", ".venv", "__pycache__", ".build", "DerivedData"}
SCAN_CAP = 50_000


def anchored_rules(rule_globs: dict[str, list[str]], directory: Path) -> set[str]:
    """Rule stems whose globs match a file that EXISTS under `directory` right
    now. Existence-based on purpose: a `**/*.swift` rule is not 'anchored' to
    a directory that contains no Swift — it would never fire in a session
    working there. One pruned walk, all rules tested per file, each rule
    retired on first hit."""
    pending: dict[str, list[re.Pattern]] = {}
    for stem, globs in rule_globs.items():
        rxs = []
        for g in globs:
            try:
                rxs.append(re.compile(_glob_to_regex(g)))
            except re.error:
                continue
        if rxs:
            pending[stem] = rxs
    hit: set[str] = set()
    seen = 0
    for base, dirs, files in os.walk(directory):
        dirs[:] = [d for d in dirs if d not in SCAN_PRUNE]
        for f in files:
            seen += 1
            if seen > SCAN_CAP or not pending:
                return hit
            path = os.path.join(base, f)
            for stem in list(pending):
                if any(_tail_match(rx, path) for rx in pending[stem]):
                    hit.add(stem)
                    del pending[stem]
    return hit


# ------------------------------------------------------------------ gathering

def tokens(text: str) -> int:
    return max(1, len(text.encode()) // 4)


STAGES = {
    "system": "Stage 1 — system prompt (base prompt + --append-system-prompt)",
    "context": "Stage 2 — first user message · project-context <system-reminder> "
               "(walk-up, rules, memory)",
    "prompt": "Stage 3 — first user message · command expansion",
    "start": "Stage 4 — after the first message · SessionStart hook context",
    "served": "Stage 5 — mid-session tool results (captured)",
}

HTML_COMMENT = re.compile(r"\n*<!--.*?-->", re.S)


class Source:
    def __init__(self, order: int, stage: str, label: str, mechanism: str,
                 body: str | None, note: str = ""):
        self.order = order
        self.stage = stage
        self.label = label
        self.mechanism = mechanism
        self.body = body
        self.note = note


def display(path: Path) -> str:
    home = str(Path.home())
    s = str(path)
    return "~" + s[len(home):] if s.startswith(home) else s


def read_or_none(path: Path) -> str | None:
    try:
        return path.read_text()
    except OSError:
        return None


def add(sources: list[Source], stage: str, label: str, mechanism: str,
        body: str | None, note: str = "") -> None:
    sources.append(Source(len(sources) + 1, stage, label, mechanism, body, note))


def strip_html_comments(body: str) -> tuple[str, int]:
    """The harness deletes HTML comments from CLAUDE.md content in flight
    (verified against a captured request body). Returns (stripped, removed)."""
    stripped = HTML_COMMENT.sub("", body)
    return stripped, len(body) - len(stripped)


def gather_base_note(sources: list[Source]) -> None:
    add(sources, "system", "(base system prompt + tool schemas)",
        "harness-internal — not files; emulation cannot render them. "
        "Capture a request and use --request for the bytes", None)


def gather_globals(sources: list[Source]) -> None:
    gmd = claude_dir() / "CLAUDE.md"
    body = read_or_none(gmd)
    if body is not None:
        body, removed = strip_html_comments(body)
        add(sources, "context", display(gmd),
            "global memory — rides the first-message <system-reminder>", body,
            f"harness strips HTML comments (−{removed} chars)" if removed else "")
    rdir = rules_dir()
    if not rdir.is_dir():
        return
    for rule in sorted(rdir.glob("*.md")):
        text = read_or_none(rule)
        if text is None or parse_paths_frontmatter(text):
            continue
        note = ""
        if rule.is_symlink():
            note = f"symlink → {display(rule.resolve())}"
        add(sources, "context", display(rule),
            "unconditional rule (no `paths:`) — rides the first-message "
            "<system-reminder>", strip_frontmatter(text), note)


def gather_walkup(directory: Path, sources: list[Source]) -> None:
    stop = walk_root().resolve()
    chain = [directory] + list(directory.parents)
    chain = [p for p in chain if str(p).startswith(str(stop))]
    for level in reversed(chain):
        for name in ("CLAUDE.md", "CLAUDE.local.md"):
            f = level / name
            body = read_or_none(f)
            if body is not None:
                body, removed = strip_html_comments(body)
                add(sources, "context", display(f),
                    "CLAUDE.md walk-up — rides the first-message "
                    "<system-reminder>", body,
                    f"harness strips HTML comments (−{removed} chars)"
                    if removed else "")


def project_key(directory: Path) -> str:
    try:
        r = subprocess.run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        root = r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else str(directory)
    except (OSError, subprocess.SubprocessError):
        root = str(directory)
    return re.sub(r"[^A-Za-z0-9]", "-", root)


def gather_memory(directory: Path, sources: list[Source], no_memory: bool) -> None:
    key = project_key(directory)
    if no_memory:
        add(sources, "context", f"(auto-memory DISABLED) key `{key}`",
            "spawn env sets CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 — the index never loads",
            None)
        return
    mem = claude_dir() / "projects" / key / "memory" / "MEMORY.md"
    body = read_or_none(mem)
    if body is not None:
        add(sources, "context", display(mem),
            f"auto-memory index — project key `{key}` — rides the "
            "first-message <system-reminder>", body)
    else:
        add(sources, "context", f"(no auto-memory) key `{key}`",
            "auto-memory index — none recorded for this project key", None)


def gather_appends(appends: list[Path], sources: list[Source]) -> None:
    for f in appends:
        body = read_or_none(f)
        note = f"symlink → {display(f.resolve())}" if f.is_symlink() else ""
        if body is None:
            add(sources, "system", display(f),
                "--append-system-prompt — FILE UNREADABLE", None, note)
        else:
            add(sources, "system", display(f),
                "--append-system-prompt — the spawner injects this inside the "
                "system prompt, ahead of the whole first message", body, note)


# ----------------------------------------------------------------- hook infra

class Hook:
    def __init__(self, origin: str, event: str, matcher: str, command: str,
                 plugin_root: Path | None):
        self.origin = origin
        self.event = event
        self.matcher = matcher
        self.command = command
        self.plugin_root = plugin_root
        self.executed = False


def _hooks_from_json(origin: str, path: Path, plugin_root: Path | None,
                     out: list[Hook]) -> None:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        return
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            continue
        for group in groups:
            matcher = group.get("matcher", "*") if isinstance(group, dict) else "*"
            for h in (group.get("hooks") or []) if isinstance(group, dict) else []:
                cmd = h.get("command", "") if isinstance(h, dict) else ""
                cmd = re.sub(r"\s+", " ", cmd).strip()
                if cmd:
                    out.append(Hook(origin, event, matcher, cmd, plugin_root))


def installed_plugins(directory: Path) -> list[tuple[str, str, Path]]:
    """(name, version, install_path) for every installed plugin whose scope
    applies to the spawn dir. Respects settings enabledPlugins:false."""
    reg = claude_dir() / "plugins" / "installed_plugins.json"
    try:
        data = json.loads(reg.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return []
    disabled: set[str] = set()
    for sf in ("settings.json", "settings.local.json"):
        try:
            s = json.loads((claude_dir() / sf).read_text())
            for name, on in (s.get("enabledPlugins") or {}).items():
                if on is False:
                    disabled.add(name)
        except (OSError, json.JSONDecodeError, ValueError, AttributeError):
            pass
    out: list[tuple[str, str, Path]] = []
    for name, entries in (data.get("plugins") or {}).items():
        if name in disabled or not isinstance(entries, list):
            continue
        for e in entries:
            if not isinstance(e, dict):
                continue
            if e.get("scope") == "project":
                proj = e.get("projectPath", "")
                if not proj or not str(directory.resolve()).startswith(
                        str(Path(proj).expanduser().resolve())):
                    continue
            ip = Path(e.get("installPath", ""))
            if ip.is_dir():
                out.append((name, str(e.get("version", "?")), ip))
                break
    return out


def all_hooks(directory: Path) -> list[Hook]:
    """Every hook the harness would register: user settings, then every
    installed plugin's hooks.json, then (dev fallback) the source-repo
    plugin manifest pict itself ships in. Dedupe on (event, matcher, cmd)."""
    out: list[Hook] = []
    for sf in ("settings.json", "settings.local.json"):
        _hooks_from_json(display(claude_dir() / sf), claude_dir() / sf, None, out)
    for name, version, ip in installed_plugins(directory):
        _hooks_from_json(f"plugin {name} @{version}", ip / "hooks" / "hooks.json",
                         ip, out)
    _hooks_from_json("plugin hooks.json (source repo)",
                     PLUGIN_BIN.parent / "hooks" / "hooks.json",
                     PLUGIN_BIN.parent, out)
    seen: set[tuple[str, str, str]] = set()
    deduped: list[Hook] = []
    for h in out:
        key = (h.event, h.matcher, h.command)
        if key in seen:
            continue
        seen.add(key)
        deduped.append(h)
    return deduped


def _matcher_hits_startup(matcher: str) -> bool:
    if matcher in ("*", ""):
        return True
    try:
        return re.fullmatch(matcher, "startup") is not None
    except re.error:
        return False


def exec_session_hooks(directory: Path, hooks: list[Hook],
                       sources: list[Source]) -> None:
    """Run SessionStart hooks and render what each injects. The jStack
    timeline injector is skipped — gather_timeline() emulates it read-only."""
    stdin_payload = json.dumps({
        "hook_event_name": "SessionStart", "source": "startup",
        "session_id": "pict-preview", "cwd": str(directory),
    })
    for h in hooks:
        if h.event != "SessionStart" or not _matcher_hits_startup(h.matcher):
            continue
        if "session-start-inject" in h.command:
            h.executed = True  # emulated by gather_timeline, never re-run
            continue
        cmd = h.command
        env = dict(os.environ)
        if h.plugin_root is not None:
            cmd = cmd.replace("${CLAUDE_PLUGIN_ROOT}", str(h.plugin_root))
            env["CLAUDE_PLUGIN_ROOT"] = str(h.plugin_root)
        try:
            r = subprocess.run(["/bin/sh", "-c", cmd], input=stdin_payload,
                               capture_output=True, text=True, timeout=15,
                               env=env, cwd=str(directory))
            raw = r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            raw = ""
        h.executed = True
        injected = raw
        if raw.startswith("{"):
            try:
                parsed = json.loads(raw)
                injected = (parsed.get("hookSpecificOutput", {}) or {}) \
                    .get("additionalContext", "") or parsed.get("additionalContext", "")
            except (json.JSONDecodeError, ValueError, AttributeError):
                pass
        label = f"SessionStart · {h.origin}"
        mech = f"SessionStart hook (executed) — `{h.command[:80]}`"
        if injected:
            add(sources, "start", label, mech, injected)
        else:
            add(sources, "start", label, mech + " — no context injected", None)


# --------------------------------------------------- SessionStart (timeline)

def review_config() -> dict:
    cfg_path = Path(os.environ.get("JSTACK_REVIEW_CONFIG",
                                   str(claude_dir() / "jstack" / "review.json"))).expanduser()
    try:
        data = json.loads(cfg_path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def resolve_seat(directory: Path, root: Path,
                 cfg: dict | None = None) -> tuple[str | None, str | None]:
    """Same contract as session-start-inject.py resolve(), repo-seat fallback
    included — pict has to show what the session would really receive, and in a
    repo the agent owns that is the owning agent's seat, not nothing."""
    try:
        rel = directory.resolve().relative_to(root.resolve())
    except (ValueError, OSError):
        rel = None
    if rel is not None and rel.parts:
        agent_dir = root / rel.parts[0]
        if (agent_dir / "CLAUDE.md").is_file():
            submode = "/".join(x.lower() for x in rel.parts[1:]) or "chat"
            return agent_dir.name.lower(), submode
    cfg = review_config() if cfg is None else cfg
    return repo_seat.seat_for(directory, root,
                              repo_seat.registry_path_for(cfg, root))


def seat_via_repo(directory: Path, root: Path) -> bool:
    """True when the seat came from the registry rather than the directory —
    the case the hook hands an identity block, since walk-up cannot reach a
    workspace that is a sibling of the checkout."""
    try:
        rel = directory.resolve().relative_to(root.resolve())
    except (ValueError, OSError):
        return True
    return not (rel.parts and (root / rel.parts[0] / "CLAUDE.md").is_file())


def timeline_count(cfg: dict, agent: str, submode: str) -> tuple[int, str]:
    """Per-dir nearest match, mirroring the hook: exact beats wildcard at each
    depth, then the parent dir. Injection only fires into live sessions;
    PICT_INTERACTIVE=0 previews the headless shape (nothing)."""
    inject = cfg.get("timeline_inject")
    if not isinstance(inject, dict):
        return 0, ""
    if os.environ.get("PICT_INTERACTIVE", "1") == "0":
        return 0, "headless spawn — injection is live-session-only, gets nothing"
    seat = submode
    while True:
        for key in (f"{agent}/{seat}", f"*/{seat}"):
            if key not in inject:
                continue
            val = inject[key]
            try:
                n = int(val.get("n", 0)) if isinstance(val, dict) else int(val)
            except (TypeError, ValueError):
                return 0, ""
            return n, f"config `{key}`: n={n} (live sessions only)"
        if "/" not in seat:
            return 0, "no timeline_inject key matches this seat or its ancestors"
        seat = seat.rsplit("/", 1)[0]


def gather_timeline(directory: Path, sources: list[Source]) -> None:
    cfg = review_config()
    root = Path(cfg.get("agent_root") or "~/Agents").expanduser()
    agent, submode = resolve_seat(directory, root, cfg)
    mech = "SessionStart hook — jstack session-start-inject.py (emulated read-only)"
    if agent is None or submode == "review":
        add(sources, "start", "(no timeline injection)",
            mech + " — dir is not an agent seat, and no registry entry owns it",
            None)
        return
    seat = f"{agent}/{submode}"
    if seat_via_repo(directory, root) and cfg.get("inject_identity", True):
        hook = _inject_hook()
        if hook is not None:
            reg_path = repo_seat.registry_path_for(cfg, root)
            try:
                identity = hook.build_identity(
                    agent, submode, root, repo_seat.load_registry(reg_path))
            except Exception:
                identity = ""
            if identity:
                add(sources, "start", f"role files — seat `{seat}`",
                    mech + " — cwd is a repo the registry owns, so walk-up never "
                    "reaches the workspace, wrapped in <jstack-identity>", identity)

    n, why = timeline_count(cfg, agent, submode)
    log_event = os.environ.get("PICT_LOG_EVENT", str(PLUGIN_BIN / "log_event"))

    # A pinned session is opened on a SUBJECT, and the pin REPLACES the seat's
    # window. Reading the seat here would preview a block this session never
    # got, under a heading naming the wrong axis — the one place a person
    # looks to find out what they were loaded with.
    hook = _inject_hook()
    tag = pin_note = ""
    if hook is not None:
        try:
            tag = hook.pinned_tag()
            if tag and not hook.tag_known(tag, binary=log_event):
                pin_note = (f" — pin `{tag}` is not in the vocabulary, so the "
                            "hook falls back to this seat and says so")
                tag = ""
        except Exception:
            tag = ""

    if tag:
        # The pin floors at the fleet default: a seat that injects nothing
        # still gets history when a pin explicitly asked for a subject.
        depth = n if n > 0 else 10
        why = (f"pinned by JSTACK_TIMELINE_TAG=`{tag}` — the subject's last "
               f"{depth} sittings across every seat, in place of "
               f"`{seat}`'s own")
        head = f"timeline tail — subject `{tag}` (pinned; replaces seat `{seat}`)"
        empty = f"(timeline empty) subject `{tag}`"
    elif n <= 0:
        add(sources, "start", f"(no timeline injection) seat `{seat}`",
            mech + (f" — {why}" if why else "") + pin_note, None)
        return
    else:
        depth = n
        head = f"timeline tail — seat `{seat}`"
        empty = f"(timeline empty) seat `{seat}`"

    try:
        r = subprocess.run(
            hook.tail_argv(None if tag else seat, depth, tag=tag or None,
                           binary=log_event) if hook is not None else
            [log_event, "tail", seat, "--sessions", str(depth),
             "--origin", "direct"],
            capture_output=True, text=True, timeout=8)
        entries = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        entries = ""
    if not entries and tag:
        # The pinned block ships even empty — a session that doesn't know it is
        # pinned frames its work as the seat's, and a fresh subject is exactly
        # when that matters.
        entries = "(nothing recorded on this subject yet — this is its first sitting.)"
    if not entries:
        add(sources, "start", empty, mech + f" — {why}" + pin_note, None)
        return
    add(sources, "start", head,
        mech + f" — {why}{pin_note}, wrapped in <jstack-timeline>", entries)


# ------------------------------------------------------------------- prompt

def resolve_command(name: str, directory: Path) -> Path | None:
    """The harness's own search order: nearest `.claude/commands/<name>.md`
    walking UP from the spawn dir, then the user-level commands dir."""
    stop = walk_root().resolve()
    for level in [directory] + list(directory.parents):
        if not str(level).startswith(str(stop)):
            break
        cand = level / ".claude" / "commands" / f"{name}.md"
        if cand.is_file():
            return cand
    cand = claude_dir() / "commands" / f"{name}.md"
    return cand if cand.is_file() else None


def gather_prompt(prompt: str, directory: Path, sources: list[Source]) -> None:
    text = prompt.strip()
    if not text.startswith("/"):
        add(sources, "prompt", "(-p prompt, literal)",
            "the -p payload IS the first user message", text)
        return
    parts = text[1:].split(None, 1)
    name = parts[0]
    args = parts[1] if len(parts) > 1 else ""
    cand = resolve_command(name, directory)
    wrapper = (f"<command-name>/{name}</command-name>"
               + (f" <command-args>{args}</command-args>" if args else ""))
    if cand is None:
        add(sources, "prompt", f"/{name} (COMMAND NOT FOUND)",
            "command expansion — no matching .claude/commands file on the "
            "walk-up or in the user commands dir", None, wrapper)
        return
    note = wrapper
    if cand.is_symlink():
        note += f" · symlink → {display(cand.resolve())}"
    body = strip_frontmatter(read_or_none(cand) or "")
    argv = args.split()
    subst = body.replace("$ARGUMENTS", args)
    subst = re.sub(r"\$(\d+)",
                   lambda m: argv[int(m.group(1)) - 1]
                   if 0 < int(m.group(1)) <= len(argv) else "", subst)
    if len(subst) != len(body):
        note += (f" · harness substituted $ARGUMENTS/$n "
                 f"({len(body) - len(subst):+d} chars)".replace("+-", "−"))
    add(sources, "prompt", f"/{name} → {display(cand)}",
        "command expansion — the -p prompt names this command; its body "
        "(frontmatter stripped, $ARGUMENTS/$n substituted) follows the "
        "wrapper in the first user message", subst, note)


def gather_serves(serves: list[Path], sources: list[Source]) -> None:
    for f in serves:
        body = read_or_none(f)
        if body is None:
            add(sources, "served", display(f),
                "tool-served payload — FILE UNREADABLE", None)
        else:
            add(sources, "served", display(f),
                "tool-served payload — arrives mid-session as a tool result "
                "(captured copy)", body)


# ------------------------------------------------------------- request mode

_WALKUP_FILE = re.compile(r"^Contents of (\S+) \(([^)]*)\)", re.M)
_WALKUP_STUB = re.compile(r"^# (claudeMd|userEmail|currentDate)\b", re.M)


def _symlink_alias(target: Path) -> str | None:
    """The wire prints RESOLVED paths — a rule wired in as a
    `~/.claude/rules/*` symlink shows up under its target path, hiding how
    it actually loads. Name the symlink so the wiring is visible."""
    rd = rules_dir()
    if not rd.is_dir():
        return None
    for p in rd.iterdir():
        if p.is_symlink():
            try:
                if p.resolve() == target.resolve():
                    return display(p)
            except OSError:
                continue
    return None


def _walkup_marks(text: str) -> list[tuple[int, str, str]]:
    """Boundary positions of every per-source section inside a claudeMd
    system-reminder: each `Contents of <path> (<why>)` file plus the harness
    stubs, in wire order. Returns (offset, path-or-stub, how-it-loads)."""
    marks: list[tuple[int, str, str]] = []
    for m in _WALKUP_FILE.finditer(text):
        note = m.group(2)
        alias = _symlink_alias(Path(m.group(1)))
        if alias:
            note += f" · wired as symlink `{alias}`"
        marks.append((m.start(), m.group(1), note))
    for m in _WALKUP_STUB.finditer(text):
        marks.append((m.start(), f"{m.group(1)} stub", "no file — harness text"))
    marks.sort()
    return marks


def _walkup_subrows(text: str) -> list[tuple[str, int, str]]:
    marks = _walkup_marks(text)
    rows: list[tuple[str, int, str]] = []
    for i, (pos, label, note) in enumerate(marks):
        end = marks[i + 1][0] if i + 1 < len(marks) else len(text)
        rows.append((label, len(text[pos:end].encode()), note))
    return rows


def _attr_system_block(text: str) -> str:
    if text.startswith("x-anthropic-billing-header"):
        return "claude binary — billing header"
    if "Claude Agent SDK" in text and len(text) < 200:
        return "claude binary — SDK line"
    stripped = text.lstrip()
    if stripped.startswith("You are Claude Code") and len(text) > 4000:
        return "claude binary — default harness prompt (gitStatus tail included)"
    if stripped.startswith("You are an interactive agent that helps users "
                           "with software engineering tasks") and len(text) > 4000:
        return "claude binary — default agent prompt (no --system-prompt passed)"
    return "spawn flag — `--system-prompt` / `--append-system-prompt`"


# --- content attribution pool: files whose bytes may ride inside a block ---

_POOL_MIN = 160          # candidate text shorter than this can't attribute
_POOL_FILE_CAP = 400     # max files one --sources dir contributes


def _pool_paths(directory: Path, extra: list[Path]) -> list[Path]:
    """Candidate files for content attribution: the CLAUDE.md walk-up chain,
    the global CLAUDE.md, rules, and auto-memory for `directory`, plus
    --sources files/dirs, $PICT_SOURCES (colon-separated), and
    <claude_dir>/pict-sources.txt (one path or glob per line, ~ allowed,
    # comments)."""
    import glob as _glob
    paths: list[Path] = []
    d = directory
    root = walk_root()
    while True:
        for name in ("CLAUDE.md", "CLAUDE.local.md"):
            paths.append(d / name)
        if d == root or d == d.parent:
            break
        d = d.parent
    paths.append(claude_dir() / "CLAUDE.md")
    rdir = rules_dir()
    if rdir.is_dir():
        paths += sorted(rdir.glob("*.md"))
    mem = claude_dir() / "projects" / project_key(directory) / "memory"
    if mem.is_dir():
        paths += sorted(mem.glob("*.md"))
    entries = list(extra)
    entries += [Path(p).expanduser()
                for p in os.environ.get("PICT_SOURCES", "").split(":") if p]
    pf = claude_dir() / "pict-sources.txt"
    if pf.is_file():
        for line in pf.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            hits = sorted(_glob.glob(os.path.expanduser(line), recursive=True))
            entries += [Path(h) for h in hits] if hits else [Path(line).expanduser()]
    for e in entries:
        if e.is_dir():
            paths += sorted(e.rglob("*.md"))[:_POOL_FILE_CAP]
        else:
            paths.append(e)
    seen: set[Path] = set()
    out: list[Path] = []
    for p in paths:
        if not p.is_file():
            continue
        try:
            rp = p.resolve()
        except OSError:
            continue
        if rp in seen:
            continue
        seen.add(rp)
        out.append(p)
    return out


def attribution_pool(directory: Path,
                     extra: list[Path]) -> list[tuple[str, str]]:
    """(label, exact-text) candidates, longest first. A file contributes its
    full text, its frontmatter-stripped text, and — for markdown — every
    `## ` section (with and without the heading line), so an extracted
    section (a register, one chapter) still attributes to its file."""
    pool: list[tuple[str, str]] = []
    seen_text: set[str] = set()

    def put(label: str, text: str) -> None:
        text = text.strip()
        if len(text) >= _POOL_MIN and text not in seen_text:
            seen_text.add(text)
            pool.append((label, text))

    for p in _pool_paths(directory, extra):
        text = read_or_none(p)
        if text is None:
            continue
        put(f"`{display(p)}`", text)
        if p.suffix == ".md":
            body = strip_frontmatter(text)
            put(f"`{display(p)}`", body)
            for m in re.finditer(r"(?m)^## .*$", body):
                nxt = re.search(r"(?m)^## ", body[m.end():])
                end = m.end() + nxt.start() if nxt else len(body)
                head = m.group(0).strip()
                put(f"`{display(p)}` § {head}", body[m.start():end])
                put(f"`{display(p)}` § {head} (heading line not sent)",
                    body[m.end():end])
    pool.sort(key=lambda lt: -len(lt[1]))
    return pool


_POOL_TOKEN = re.compile(r"\n?[ \t]*\{[a-z_]+\}[ \t]*\n?")


def _token_pattern(text: str):
    """A pool text carrying `{token}` placeholders can still attribute a
    body where an engine filled them: literals must match verbatim, each
    token spans a bounded lazy wildcard (lazy = earliest end, so a partial
    match under-claims rather than over-claims). Returns (pattern,
    literal_len) or None when the text has no tokens."""
    parts = _POOL_TOKEN.split(text)
    if len(parts) == 1:
        return None
    pat = re.compile("(?s)" + "(?:.{0,8000}?)".join(re.escape(p)
                                                    for p in parts))
    return pat, sum(len(p) for p in parts)


def content_marks(body: str,
                  pool: list[tuple[str, str]]) -> list[tuple[int, int, str]]:
    """Non-overlapping (start, end, label) spans where a pool text appears
    inside `body` — verbatim, or with `{tokens}` filled by an engine
    (labeled so). Pool is longest-first, so a whole file claims its span
    before its own sections — or a snippet spliced into it — can."""
    kept: list[tuple[int, int, str]] = []
    for label, text in pool:
        spans: list[tuple[int, int, str]] = []
        start = 0
        while True:
            i = body.find(text, start)
            if i < 0:
                break
            spans.append((i, i + len(text), label))
            start = i + len(text)
        if not spans and "{" in text:
            tp = _token_pattern(text)
            if tp is not None and tp[1] >= _POOL_MIN:
                pat, parts = tp[0], _POOL_TOKEN.split(text)
                # every sizeable literal must be present at all, or the
                # regex cannot match — cheap prune before backtracking
                if all(p in body for p in parts if len(p) >= 8):
                    start = 0
                    while True:
                        m = pat.search(body, start)
                        if not m:
                            break
                        if m.end() - m.start() >= _POOL_MIN:
                            spans.append((m.start(), m.end(),
                                          f"{label} (tokens filled)"))
                        start = max(m.end(), m.start() + 1)
        for i, j, lab in spans:
            if all(j <= s or i >= e for s, e, _ in kept):
                kept.append((i, j, lab))
    return sorted(kept)


def _segments(body: str, marks: list[tuple[int, int, str]],
              gap_label: str) -> list[tuple[str, str]]:
    """(label, text) segments that tile body EXACTLY — concatenating the
    segment texts reproduces the block byte-for-byte. A whitespace-only gap
    is absorbed into the neighboring segment instead of becoming noise."""
    segs: list[tuple[str, str]] = []
    carry = ""
    pos = 0
    for s, e, label in marks:
        gap = body[pos:s]
        if gap.strip():
            segs.append((gap_label, carry + gap))
            carry = ""
        else:
            carry += gap
        segs.append((label, carry + body[s:e]))
        carry = ""
        pos = e
    tail = body[pos:]
    if tail.strip():
        segs.append((gap_label, carry + tail))
    elif tail or carry:
        if segs:
            segs[-1] = (segs[-1][0], segs[-1][1] + carry + tail)
        else:
            segs.append((gap_label, carry + tail))
    if "".join(t for _, t in segs) != body:      # never lie: unsplit beats wrong
        return []
    return segs


_HEADING_LINE = re.compile(r"^( {0,3})#{1,6}(\s|$)")
_RULE_LINE = re.compile(r"^ {0,3}(-{3,}|={3,}|_{3,}|\*{3,})[ \t]*$")


def neutral(body: str) -> list[str]:
    """Verbatim body as plain markdown text — readable in any md editor, no
    code fences (source editors paint fenced blocks as code), no escape
    glyphs. `#` is pict's separator lane, so the one transform: content ATX
    headings render one level deeper than sent (# → ##, ## → ###, …) — they
    nest under pict's anatomy in the outline instead of colliding with it —
    and a bare ---/===/*** line directly under text gets a preceding blank
    line so it cannot read as a setext underline. Every other byte is
    verbatim."""
    if not body.strip():
        return ["(empty)"]
    out = []
    for ln in body.splitlines():
        m = _HEADING_LINE.match(ln)
        if m:
            i = len(m.group(1))
            ln = ln[:i] + "#" + ln[i:]
        elif _RULE_LINE.match(ln) and out and out[-1].strip():
            out.append("")
            out.append(ln)
            continue
        out.append(ln)
    return out


def render_request(path: Path, directory: Path | None = None,
                   sources_extra: list[Path] | None = None) -> str:
    """Byte-truth mode: render a captured /v1/messages request body — every
    top-level key, system block, tool schema, and message part, verbatim.
    Sections come in the order the model READS them (system → tools →
    messages → envelope keys), not raw JSON key order — the CLI serializes
    `messages` before `system` in the body, but the model always gets system
    first; the header states the raw wire key order. Components are level-1
    markdown headings (`#` is pict's lane — the document outline IS the
    request anatomy); bodies render as plain text with content headings one
    level deeper than sent (see neutral()). Composite blocks split per
    source file via the attribution pool; unmatched bytes still render,
    labeled unattributed. Complete by construction: a top-level key this
    tool does not model gets its own verbatim section rather than being
    dropped."""
    directory = (directory or Path.cwd()).resolve()
    req = json.loads(path.read_text())
    total_bytes = len(path.read_bytes())
    pool = attribution_pool(directory, sources_extra or [])

    # components: (label, kind, body, source, segments[(sublabel, text)], note)
    comps: list[tuple[str, str, str, str, list[tuple[str, str]], str]] = []
    handled = {"system", "tools", "messages"}
    gap = "(unattributed — no pool file matches these bytes)"

    def block_note(block: dict, skip: tuple[str, ...]) -> str:
        extras = {k: v for k, v in block.items() if k not in skip}
        if not extras:
            return ""
        return ("also carries " + json.dumps(extras, sort_keys=True)
                + " — shown here, sent as JSON fields of this block")

    def add_comp(label: str, kind: str, body: str, src: str,
                 split: bool = True, note: str = "") -> None:
        marks = content_marks(body, pool) if split and len(body) > 400 else []
        segs = _segments(body, marks, gap) if marks else []
        comps.append((label, kind, body, src, segs, note))

    # model-read order: system, then tools, then the conversation, then the
    # remaining envelope keys in their wire order
    keys = ([k for k in ("system", "tools", "messages") if k in req]
            + [k for k in req if k not in ("system", "tools", "messages")])
    for key in keys:
        if key == "system":
            sysblocks = req["system"]
            if isinstance(sysblocks, str):
                sysblocks = [{"text": sysblocks}]
            for i, b in enumerate(sysblocks):
                t = b.get("text", "") if isinstance(b, dict) else str(b)
                note = block_note(b, ("type", "text")) if isinstance(b, dict) else ""
                add_comp(f"system[{i}]", "system prompt block", t,
                         _attr_system_block(t), note=note)
        elif key == "tools":
            for t in req["tools"] or []:
                name = t.get("name", "?") if isinstance(t, dict) else "?"
                add_comp(f"tool schema — {name}",
                         "tools[] entry (bytes as sent, shown pretty-printed)",
                         json.dumps(t, indent=1),
                         "claude binary — built-in schema", split=False)
        elif key == "messages":
            cmd_name: str | None = None
            for mi, m in enumerate(req["messages"] or []):
                role = m.get("role", "?")
                content = m.get("content")
                if isinstance(content, str):
                    src = ("SessionStart hook output — registered hooks run at spawn"
                           if "SessionStart hook additional context" in content
                           else "harness reminder"
                           if content.startswith("<system-reminder>")
                           else "conversation")
                    add_comp(f"messages[{mi}] ({role})", "string content",
                             content, src)
                    continue
                for pi, part in enumerate(content or []):
                    ptype = part.get("type", "?") if isinstance(part, dict) else "?"
                    body = part.get("text", "") if isinstance(part, dict) else str(part)
                    if ptype != "text" and not body:
                        body = json.dumps(part, indent=1)
                    note = (block_note(part, ("type", "text"))
                            if isinstance(part, dict) and ptype == "text" else "")
                    walkup = "# claudeMd" in body and "Contents of" in body
                    if walkup:
                        src = "CLAUDE.md walk-up + always-on rules — split per file below"
                    elif "<command-name>" in body and len(body) < 1000:
                        w = re.search(r"<command-name>/?([^<]+)</command-name>", body)
                        cmd_name = w.group(1) if w else None
                        src = "CLI — command wrapper for the -p prompt"
                    elif cmd_name:
                        cand = resolve_command(cmd_name, directory)
                        if cand is not None:
                            src = f"`{display(cand)}`"
                            if cand.is_symlink():
                                src += f" → `{display(cand.resolve())}`"
                        else:
                            src = (f"expanded body of `/{cmd_name}` — source file "
                                   f"not found from `{display(directory)}`")
                        cmd_name = None
                    elif "SessionStart hook additional context" in body:
                        src = "SessionStart hook output — registered hooks run at spawn"
                    elif body.startswith("<system-reminder>"):
                        src = "harness reminder"
                    else:
                        src = "-p payload / conversation"
                    label = f"messages[{mi}].content[{pi}] ({role} · {ptype})"
                    if walkup:
                        marks = _walkup_marks(body)
                        spans = [(pos, marks[k + 1][0] if k + 1 < len(marks)
                                  else len(body), lab)
                                 for k, (pos, lab, _n) in enumerate(marks)]
                        segs = _segments(body, spans, gap)
                        comps.append((label, "message part", body, src, segs, note))
                    else:
                        add_comp(label, "message part", body, src, note=note)
        else:
            # request envelope: every key the renderer does not model still
            # gets a section — nothing in the body is ever invisible
            add_comp(f"envelope · {key}",
                     "API call parameter — CLI plumbing, not prompt text "
                     "(configures the call; the model never reads it as words)",
                     json.dumps({key: req[key]}, indent=1),
                     "claude binary — API envelope (model/sampling/framing)",
                     split=False)

    rendered = sum(len(b.encode()) for _, _, b, _, _, _ in comps)
    lines: list[str] = []
    lines.append(f"# pict --request — `{display(path)}`\n")
    lines.append(f"Model `{req.get('model', '?')}` · request body {total_bytes:,} "
                 f"bytes · every top-level key rendered verbatim, in the order "
                 f"the model reads it (system → tools → messages → envelope; "
                 f"raw wire key order: {', '.join(f'`{k}`' for k in req)}) · "
                 f"attribution pool resolved from `{display(directory)}` "
                 f"({len(pool)} candidate texts). Content rendered below: "
                 f"{rendered:,} bytes; the remainder of the body is JSON framing "
                 f"(keys, quotes, escapes) — no content is omitted. Content "
                 f"headings render one level deeper than sent (# → ##); `#` "
                 f"headings are pict's anatomy only. Envelope components at "
                 f"the end are the CLI's API call parameters — plumbing that "
                 f"configures the call, never prompt content.\n")
    lines.append("| # | component | bytes | % of request | source |")
    lines.append("|---|-----------|-------|--------------|--------|")
    for i, (label, _, body, src, segs, _note) in enumerate(comps, 1):
        b = len(body.encode())
        lines.append(f"| {i} | `{label}` | {b:,} | "
                     f"{100.0 * b / max(1, total_bytes):.1f}% | {src} |")
        for slabel, stext in segs:
            sb = len(stext.encode())
            lines.append(f"| | ↳ {slabel} | {sb:,} | "
                         f"{100.0 * sb / max(1, total_bytes):.1f}% | |")
    lines.append(f"| | **request total (with JSON framing)** | **{total_bytes:,}** "
                 f"| 100% | |")
    lines.append("")
    total = len(comps)
    for i, (label, kind, body, src, segs, note) in enumerate(comps, 1):
        lines.append(f"# {i}/{total} · {label}")
        lines.append("")
        meta = f"{kind} · {len(body.encode()):,} bytes · source: {src}"
        if note:
            meta += f" · {note}"
        lines.append(meta)
        lines.append("")
        if segs:
            for j, (slabel, stext) in enumerate(segs, 1):
                lines.append(f"# {i}.{j} · {slabel} · {len(stext.encode()):,} bytes")
                lines.append("")
                lines += neutral(stext)
                lines.append("")
        else:
            lines += neutral(body)
            lines.append("")
    return "\n".join(lines) + "\n"


# ------------------------------------------------------------------ document


def gather(directory: Path, opts: dict, hooks: list[Hook]) -> list[Source]:
    """Every source that actually injects, in the order the model gets it.

    The on-demand layer is deliberately NOT here: a path rule fires when a
    session touches a matching file, which is a different event from a spawn.
    Anything this returns is in the first request, full stop."""
    sources: list[Source] = []
    gather_base_note(sources)
    gather_appends(opts["appends"], sources)
    gather_globals(sources)
    gather_walkup(directory, sources)
    gather_memory(directory, sources, opts["no_memory"])
    if opts["prompt"]:
        gather_prompt(opts["prompt"], directory, sources)
    if opts["exec_hooks"]:
        exec_session_hooks(directory, hooks, sources)
    gather_timeline(directory, sources)
    gather_serves(opts["serves"], sources)
    return sources


BARE_STAGES = {
    "system": "system prompt",
    "context": "first user message · project context",
    "prompt": "first user message · the prompt",
    "start": "after the first message · hook context",
    "served": "mid-session tool results",
}


def render_bare(directory: Path, opts: dict) -> str:
    """The injection and nothing else: every loaded body in wire order,
    each under its path, with no weights, no mechanism notes, no on-demand
    layer, no hook inventory.

    The annotated view answers *why* a file is in the context and what it
    costs. This one answers *what the context is* — the reading copy, for
    when the question is the content rather than the plumbing. Same
    `neutral()` body transform, so the bytes are the bytes.

    One thing survives the strip: the base-prompt line. Emulation cannot
    render the harness's own prompt or the tool schemas, and a document that
    silently omitted them would read as a complete context while missing its
    largest block — the exact lie pict exists to kill. It is named, and
    `--request` is where the real bytes come from."""
    sources = gather(directory, opts, all_hooks(directory))
    lines: list[str] = []
    stage = None
    for s in sources:
        if s.stage != stage:
            stage = s.stage
            lines.append(f"\n# ── {BARE_STAGES[s.stage]} ──\n")
        lines.append(f"# {s.label}\n")
        # `None` is unrenderable, `""` is a file that really is empty — a
        # distinction worth keeping: an empty always-on rule is a live slot
        # holding no content, not a hole in the render.
        lines += (["*(not renderable by emulation — see --request)*"]
                  if s.body is None else neutral(s.body))
        lines.append("")
    return "\n".join(lines).lstrip("\n") + "\n"


def render(directory: Path, opts: dict) -> str:
    hooks = all_hooks(directory)
    sources = gather(directory, opts, hooks)
    total = len(sources)

    candidates: dict[str, tuple[Path, list[str], str]] = {}
    rdir = rules_dir()
    if rdir.is_dir():
        for rule in sorted(rdir.glob("*.md")):
            text = read_or_none(rule)
            if text is None:
                continue
            globs = parse_paths_frontmatter(text)
            if globs:
                candidates[rule.stem] = (rule, globs, strip_frontmatter(text))
    hits = anchored_rules({s: g for s, (_, g, _) in candidates.items()}, directory)
    anchored = [candidates[s] for s in sorted(hits)]
    elsewhere = [(s, g) for s, (_, g, _) in sorted(candidates.items()) if s not in hits]
    appended = {}
    for a in opts["appends"]:
        try:
            appended[a.resolve()] = a
        except OSError:
            pass

    def dup_of_append(rule: Path) -> bool:
        try:
            return rule.resolve() in appended
        except OSError:
            return False

    lines: list[str] = []
    lines.append(f"# pict — composed context for `{display(directory)}`\n")
    lines.append("Every injected source in the order the model receives it, then the")
    lines.append("on-demand layer. Weights are ~tokens (bytes/4).\n")

    stage_totals = {k: 0 for k in STAGES}
    lines.append("| # | stage | source | mechanism | ~tokens |")
    lines.append("|---|-------|--------|-----------|---------|")
    for s in sources:
        w = tokens(s.body) if s.body else 0
        stage_totals[s.stage] += w
        lines.append(f"| {s.order} | {s.stage} | `{s.label}` | {s.mechanism} | {w or '—'} |")
    req_total = (stage_totals["system"] + stage_totals["context"]
                 + stage_totals["prompt"] + stage_totals["start"])
    lines.append(f"| | | **first request — emulatable share** (base prompt + tool "
                 f"schemas NOT included; see --request) | | **{req_total}** |")
    if stage_totals["served"]:
        lines.append(f"| | | **mid-session tool results (captured)** | | **{stage_totals['served']}** |")
    grand = sum(stage_totals.values())
    lines.append(f"| | | **TOTAL of the above** | | **{grand}** |")
    ondemand_total = 0
    for rule, globs, body in anchored:
        ondemand_total += tokens(body)
        dup = (" — **SAME FILE as the --append above: already in the system "
               "prompt; if this ever fires it injects TWICE**"
               if dup_of_append(rule) else "")
        lines.append(f"| · | on-demand | `{display(rule)}` | files matching "
                     f"`{', '.join(globs)}` exist here{dup} | {tokens(body)} |")
    if anchored:
        lines.append(f"| | | **on-demand pool (each loads only when its files are touched)** "
                     f"| | **{ondemand_total}** |")
    lines.append("")

    prev_stage = None
    stage_no = 0
    for s in sources:
        if s.stage != prev_stage:
            stage_no += 1
            lines.append(f"\n# Stage {stage_no} · {STAGES[s.stage]}\n")
            prev_stage = s.stage
        lines.append(f"# {s.order}/{total} · {s.label}")
        lines.append("")
        meta = s.mechanism
        if s.body is not None:
            meta += f" · {len(s.body.splitlines())} lines · ~{tokens(s.body)} tokens"
        if s.note:
            meta += f" · {s.note}"
        lines.append(meta)
        lines.append("")
        if s.body:
            lines += neutral(s.body)
        lines.append("")

    lines.append("---\n")
    lines.append("# On-demand rules — matching files exist under this directory\n")
    lines.append("NOT loaded at spawn. Each loads only when one of its matching files")
    lines.append("is read/edited (native) or about to be mutated (jStack PreToolUse")
    lines.append("hook, re-injected after ~400KB of transcript growth).\n")
    if not anchored:
        lines.append("*(none)*\n")
    for rule, globs, body in anchored:
        lines.append(f"# on-demand · {display(rule)}")
        lines.append("")
        meta = (f"fires on `{', '.join(globs)}` · {len(body.splitlines())} "
                f"lines · ~{tokens(body)} tokens")
        if dup_of_append(rule):
            lines.append(meta + " · SAME FILE as the --append: already in the "
                         "system prompt of this spawn; body not repeated here.")
            lines.append("")
            continue
        lines.append(meta)
        lines.append("")
        lines += neutral(body)
        lines.append("")

    if elsewhere:
        lines.append("---\n")
        lines.append("# Path rules with no matching files here\n")
        lines.append("Would fire only if the session touches matching paths elsewhere")
        lines.append("(cross-tree) or creates matching files:\n")
        for stem, globs in elsewhere:
            lines.append(f"- `{stem}` — `{', '.join(globs)}`")
        lines.append("")

    if hooks:
        lines.append("---\n")
        lines.append("# All registered hooks (user settings + installed plugins)\n")
        lines.append("Conditional injectors and gates. Listed, not executed" +
                     (" — except SessionStart hooks rendered above (--exec-hooks)."
                      if opts["exec_hooks"] else
                      " (pass --exec-hooks to run SessionStart hooks and see "
                      "what they inject)."))
        lines.append("")
        lines.append("| origin | event | matcher | command |")
        lines.append("|--------|-------|---------|---------|")
        for h in hooks:
            cmd = h.command if len(h.command) <= 100 else h.command[:97] + "..."
            mark = " ✱ rendered above" if h.executed else ""
            lines.append(f"| {h.origin} | {h.event} | `{h.matcher}` | `{cmd}`{mark} |")
        lines.append("")

    lines.append("---\n")
    lines.append("*Emulation cannot see: the base system prompt, tool schemas, the")
    lines.append("skills/commands description list, MCP server instructions, session")
    lines.append("guidance. For those bytes, capture a request and run")
    lines.append("`pict --request <file>`.*")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    if any(a in ("-h", "--help") for a in argv[1:]):
        sys.stdout.write(__doc__.strip() + "\n")
        return 0
    opts = {"no_memory": False, "exec_hooks": False, "appends": [],
            "serves": [], "prompt": "", "sources": []}
    bare = False
    request: Path | None = None
    positional: list[str] = []
    args = argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--headless":
            os.environ["PICT_INTERACTIVE"] = "0"
        elif a == "--no-memory":
            opts["no_memory"] = True
        elif a == "--exec-hooks":
            opts["exec_hooks"] = True
        elif a == "--bare":
            bare = True
        elif a in ("--append", "--serve", "--prompt", "--request", "--sources"):
            if i + 1 >= len(args):
                sys.stderr.write(f"pict: {a} needs a value\n")
                return 64
            val = args[i + 1]
            i += 1
            if a == "--append":
                opts["appends"].append(Path(val).expanduser())
            elif a == "--serve":
                opts["serves"].append(Path(val).expanduser())
            elif a == "--sources":
                opts["sources"].append(Path(val).expanduser())
            elif a == "--request":
                request = Path(val).expanduser()
                if not request.is_file():
                    sys.stderr.write(f"pict: not a file: {request}\n")
                    return 64
            else:
                opts["prompt"] = val
        elif a.startswith("-"):
            sys.stderr.write(f"pict: unknown option {a}\n")
            return 64
        else:
            positional.append(a)
        i += 1
    if len(positional) > 1:
        sys.stderr.write("usage: pict [dir] [--bare] [--headless] [--no-memory] "
                         "[--exec-hooks] [--append FILE]... [--prompt TEXT] "
                         "[--serve FILE]... [--sources PATH]... [--request FILE]\n")
        return 64
    directory = Path(positional[0]).expanduser().resolve() if positional else Path.cwd()
    if not directory.is_dir():
        sys.stderr.write(f"pict: not a directory: {directory}\n")
        return 64
    if request is not None:
        try:
            sys.stdout.write(render_request(request, directory, opts["sources"]))
        except (json.JSONDecodeError, ValueError) as e:
            sys.stderr.write(f"pict: {request} is not request JSON: {e}\n")
            return 64
        return 0
    sys.stdout.write(render_bare(directory, opts) if bare
                     else render(directory, opts))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
