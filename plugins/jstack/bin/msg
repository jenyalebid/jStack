#!/usr/bin/env python3
"""msg — agent-to-agent messaging in exactly two forms.

    msg send @seat "content"           an UPDATE: news, no reply expected
    msg send @seat "content" --wake    a TASK: opens a channel, they answer
    msg reply <id> "content"           the next turn in that channel

    msg check <id>                     what became of something you sent
    msg inbox / read <id> / thread <id> / sent      reading

An **update** is a note addressed to a SEAT. It shows up once in that seat's
next session as context and is done — it obliges nobody, closes itself, and
never comes back. This is the append: whatever you write lands in front of
whoever next sits down there.

A **task** is addressed to a SESSION, and `--wake` is what makes it one. It
spawns a session in the receiving seat, ties that session to yours, and opens
a **channel** between the two: they do the work and reply, and the reply comes
back to the session that asked — not to its seat, and not to whoever happens
to sit down there next. If that session has already exited, the reply
fork-resumes it, so the answer always lands in the conversation that wanted
it. It is a subagent call to another agent, and like a subagent call the
answer is the point.

A channel is a thread and it runs both ways. Either end can `msg reply` again
— to clarify, to push back, to ask the one thing that was missing — and each
turn reaches the other end's session the same way. It ends when someone
answers and nobody answers back, and the exchange is written to both seats'
timelines when the task it opened with is answered.

Nothing accumulates. A task binds ONLY the session it was delivered to, so
opening a chat can never make an agent go off doing something that has been
sitting around; an unanswered task is the sender's problem to notice, visible
in `msg sent` and `msg check`, and it is invisible to every other session.

The bar for a task is that it genuinely needs them — their access, their
device, context you cannot get. Work you could do yourself is not a task
because a doc names someone else as the owner, and a message is never sent to
correct or withdraw an earlier message.

The task system (~/Systems/tasks) rides the same channel plumbing for its
creator leg: `msg inject` (plumbing, called by the GitHub webhook) delivers an
issue comment to the session that created the issue — bound like a reply,
consumed by being shown, but answered on the issue itself with
`gh issue comment`, never with `msg reply`. GitHub holds that conversation;
the row here is only the delivery.

Addressing — `@agent` is the agent's cockpit, hyphens walk down to a sub-seat:

    @bob                   -> bob/chat
    @alice-social          -> alice/social/chat   (descends into chat/)
    @alice-pm              -> alice/pm            (no pm/chat dir)
    @alice-service-call    -> alice/service-call
    @self                  -> the sender's own seat

The trailing descent into `chat/` is the rule that makes `@alice-social` mean
the social OPERATOR seat rather than the social container — the same
`{base}-social-chat` convention the rest of the stack already uses.

Store: the timeline db ({timeline_dir}/timeline.db), own `messages` table.
One store, one backup, one WAL; the timeline's `entries` table is untouched.
This binary is the only sanctioned writer of `messages` — a second writer
would fork the source of truth (same law log_event holds).

`@boss` is deliberately NOT a mailbox: the host's own channel to its human
owns that contact and already has a reply path. Sending to it errors and
says so.

Self-contained python3 stdlib — no venv, no host imports. Safe to call from
hooks, crons, spawned sessions, or interactively.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

# root.py is the one answer for "where is the tree" — a pure-stdlib sibling in
# the plugin dir, so importing it keeps the self-contained promise above. An
# older install (or a partial deploy) legitimately has no root.py; that is a
# supported state, and the literal pre-root defaults at each use site keep it
# answering exactly as it did before the derivation existed.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
try:
    import root as _root
except ImportError:
    _root = None


def _is_seat(path: Path) -> bool:
    """A seat is a directory holding a CLAUDE.md — the same evidence the
    injector and review engine use to recognize one.

    This is the gate, not a blocklist of storage dir names: `Alice/ideas`
    is a real seat and `Bob/pad` is not, and only the file on disk knows
    which is which. Addressing a dir no session ever boots in would file a
    message that could never be read — so it must fail at send time."""
    return (path / "CLAUDE.md").is_file()


def _seats_under(root: Path) -> list:
    try:
        return sorted(c.name for c in root.iterdir()
                      if c.is_dir() and not c.name.startswith(".") and _is_seat(c))
    except OSError:
        return []

_SCHEMA = """
CREATE TABLE IF NOT EXISTS messages (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    created_at     TEXT NOT NULL,
    from_seat      TEXT NOT NULL,
    to_agent       TEXT NOT NULL,
    to_seat        TEXT NOT NULL,
    subject        TEXT NOT NULL,
    body           TEXT NOT NULL DEFAULT '',
    attachments    TEXT NOT NULL DEFAULT '[]',
    wake           INTEGER NOT NULL DEFAULT 0,
    reply_to       INTEGER,
    thread_id      INTEGER NOT NULL DEFAULT 0,
    -- Addressed to a seat:    update -> seen
    -- Addressed to a session: task   -> answered   (a request; the reply closes it)
    --                         reply  -> seen       (the return leg; nothing is owed back)
    state          TEXT NOT NULL DEFAULT 'update',
    resolution     TEXT,
    resolved_at    TEXT,
    resolved_by    TEXT,
    -- The session that wrote this. On a task it is the far end of the channel:
    -- where the answer has to come back to.
    origin_session TEXT,
    -- The session this message is FOR. A session-addressed message binds to
    -- this one session and no other, which is what makes a stale item
    -- impossible. NULL on a task whose session has not booted yet — the wake
    -- is booked, the session does not exist, and claiming one would be a lie.
    bound_session  TEXT,
    -- The scheduler one-shot booked to carry this message to its session.
    -- Held so the sender can ask what became of it, and so a delivery that
    -- arrives another way can cancel the spawn it no longer needs.
    wake_job       TEXT,
    consumed_at    TEXT,
    logged_at      TEXT,
    delivery       TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS idx_messages_to ON messages(to_seat, state, created_at);
CREATE INDEX IF NOT EXISTS idx_messages_agent ON messages(to_agent, state, created_at);
CREATE INDEX IF NOT EXISTS idx_messages_thread ON messages(thread_id, created_at);
"""


# --------------------------------------------------------------- config/store


def _config() -> dict:
    """Host config — shared with the timeline/review engine."""
    path = Path(os.environ.get(
        "JSTACK_REVIEW_CONFIG",
        str(Path.home() / ".claude" / "jstack" / "review.json"),
    )).expanduser()
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def _mail_config() -> dict:
    cfg = _config().get("mail")
    return cfg if isinstance(cfg, dict) else {}


def timeline_dir() -> Path:
    """Same db as bin/log_event's, and it has to be the same by construction.

    An exchange is filed into both seats' timelines from here; the seat then
    reads its own history through log_event. Two independently-written
    defaults agreeing is not one location — move either and both tools still
    succeed, against different files.
    """
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    if _root is not None:
        return _root.timeline_dir(_config())
    return Path.home() / "Logs" / "Timeline"


def db_path() -> Path:
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / "timeline.db"


def connect() -> sqlite3.Connection:
    con = sqlite3.connect(db_path(), timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.executescript(_SCHEMA)
    cols = {r[1] for r in con.execute("PRAGMA table_info(messages)")}
    for col in ("bound_session", "wake_job", "consumed_at", "logged_at"):
        if col not in cols:
            con.execute(f"ALTER TABLE messages ADD COLUMN {col} TEXT")
            con.commit()
    for dead in ("deferred_until", "deferred_session"):
        if dead in cols:
            try:
                con.execute(f"ALTER TABLE messages DROP COLUMN {dead}")
                con.commit()
            except sqlite3.Error:
                pass
    con.row_factory = sqlite3.Row
    return con


def session_id() -> str:
    """The calling session, or '' when there is none."""
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or ""


def agent_root() -> Path:
    if _root is not None:
        return _root.agents_dir(_config())
    return Path(_config().get("agent_root") or "~/Agents").expanduser()


def now_iso() -> str:
    return datetime.now().isoformat(timespec="seconds")


def _fail(msg: str, code: int = 2) -> "None":
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


# ------------------------------------------------------------------ addressing


def _agent_dirs() -> dict:
    """lowercase agent name -> its workspace dir. root.agents() is the one
    definition of what an agent is — a dir under the agent root carrying a
    CLAUDE.md itself or in a seat subdir; six places used to each hold their
    own version of that rule and drift apart."""
    if _root is not None:
        cfg = _config()
        base = _root.agents_dir(cfg)
        return {name.lower(): base / name for name in _root.agents(cfg)}
    # Older install, no root.py: the literal pre-root scan.
    out = {}
    try:
        for child in sorted(agent_root().iterdir()):
            if child.is_dir() and (child / "CLAUDE.md").is_file():
                out[child.name.lower()] = child
    except OSError:
        pass
    return out


def _walk_segments(root: Path, segs: list) -> "str|None":
    """Resolve hyphen segments as a directory path under root.

    'service-call' resolves as the single dir `service-call` before it is
    tried as `service/call`: a hyphen inside a real directory name is far
    commoner than a nested pair, and trying the whole string first is what
    makes @alice-service-call work without special-casing it."""
    if not segs:
        return ""
    whole = "-".join(segs)
    if _is_seat(root / whole):
        return whole
    for i in range(1, len(segs)):
        head = "-".join(segs[:i])
        sub = root / head
        if not sub.is_dir():
            continue
        tail = _walk_segments(sub, segs[i:])
        if tail is not None:
            return f"{head}/{tail}" if tail else head
    return None


def resolve_seat(spec: str, sender: "str|None" = None) -> tuple:
    """'@alice-social' -> ('alice', 'social/chat', Path(...)).

    Raises SystemExit with a usable message when the seat is not a real dir —
    a message addressed to nowhere must fail loudly at send time, never land
    in a table nobody reads.

    The grammar lives in `root.resolve_seat`, which every jStack command that
    takes an @-token now shares. It was written here first and stayed here,
    private to one CLI, while the commands that spawn sessions each grew a
    weaker resolver of their own — so `@alice-social` addressed a seat in mail
    and was refused as an unknown agent by handoff and takeover. The `@boss`
    refusal stays local: that is a mail policy, not part of the grammar.
    """
    spec = (spec or "").strip()
    if spec.startswith("@"):
        spec = spec[1:]
    if not spec:
        _fail("no recipient — use @agent, @agent-seat, or @self")
    if spec.lower() == "boss":
        _fail("@boss is not a mailbox — the host's own channel to its human "
              "owns that contact and has its own reply path. Use it instead.")
    if _root is not None and hasattr(_root, "resolve_seat"):
        try:
            seat = _root.resolve_seat(spec, sender=sender, cfg=_config())
        except _root.AddressError as exc:
            _fail(str(exc))
        return seat.agent, seat.submode, seat.path
    # Older install, no root.resolve_seat: the literal pre-lift resolver.
    if spec.lower() in ("self", "me"):
        if not sender:
            _fail("@self: could not resolve the sending seat from cwd")
        agent, _, submode = sender.partition("/")
        agent, submode = agent.lower(), (submode or "chat")
        # A seat STRING is lowercase; the directory it names is not. Resolve
        # through the real dir instead of rebuilding a path out of the
        # lowercase name — the workspace string is what the CLI hashes into a
        # session's project dir, so `~/Agents/alice/chat` files a spawned
        # session's transcript somewhere the seat's own history never looks.
        root = _agent_dirs().get(agent)
        if root is None:
            _fail(f"@self: {agent!r} is not an agent under {agent_root()}")
        seat_dir = root / submode
        if submode == "chat" and not _is_seat(seat_dir) and _is_seat(root):
            seat_dir = root  # bare cockpit: the seat is the agent root itself
        return agent, submode, seat_dir

    agents = _agent_dirs()
    parts = [p for p in spec.lower().split("-") if p]
    base = None
    root = None
    # Longest agent-name match first: an agent whose own name holds a hyphen
    # must win over the same prefix read as agent + seat.
    for i in range(len(parts), 0, -1):
        cand = "-".join(parts[:i])
        if cand in agents:
            base, root, parts = cand, agents[cand], parts[i:]
            break
    if base is None:
        known = ", ".join(sorted(agents)) or "(none found)"
        _fail(f"unknown agent in {spec!r}. Known agents: {known}")

    submode = _walk_segments(root, parts)
    if submode is None:
        _fail(f"{spec!r}: no seat {'-'.join(parts)!r} under {root}. "
              f"Seats there: {', '.join(_seats_under(root)) or '(none)'}")

    # The cockpit descent: a seat that itself holds a chat/ dir means the
    # operator seat, not the container. @alice-social -> alice/social/chat.
    if not submode:
        if _is_seat(root / "chat"):
            submode = "chat"
        elif _is_seat(root):
            # A bare agent — CLAUDE.md at the top, no chat/ dir — keeps its
            # cockpit at the agent root itself. The injector already files a
            # session booted there as {agent}/chat, so that is the seat this
            # message addresses; {root}/chat would name a directory no
            # session ever boots in.
            return base, "chat", root
        else:
            submode = ""
    elif _is_seat(root / submode / "chat"):
        submode = f"{submode}/chat"

    if not submode:
        _fail(f"{spec!r}: {root} has no chat/ seat to address")
    seat_dir = root / submode
    if not _is_seat(seat_dir):
        _fail(f"{spec!r}: {seat_dir} is not a seat (no CLAUDE.md) — no session "
              f"boots there, so a message would never be read. "
              f"Seats: {', '.join(_seats_under(root)) or '(none)'}")
    return base, submode, seat_dir


def _seat_of(path: "Path|None") -> "str|None":
    """A directory -> the seat it sits in, or None. The injector's resolution."""
    if path is None:
        return None
    if _root is not None:
        agent, submode = _root.seat_of(path, _config())
        return f"{agent}/{submode}" if agent else None
    # Older install without root.py: the literal gate this shipped with.
    root = agent_root()
    try:
        rel = path.resolve().relative_to(root.resolve())
    except (ValueError, OSError):
        return None
    if not rel.parts or not (root / rel.parts[0] / "CLAUDE.md").is_file():
        return None
    submode = "/".join(p.lower() for p in rel.parts[1:]) or "chat"
    return f"{rel.parts[0].lower()}/{submode}"


def _cwd_of_session(sid: str) -> "Path|None":
    """The workspace a session was STARTED in, read from its own transcript.

    cwd is where the agent last `cd`'d to, which is routinely somewhere else —
    a repo, an infra dir. The transcript records the workspace the session was
    started in, so a message sent or closed from anywhere still carries the
    seat that did it, rather than an anonymous '?'.

    It is also the only correct answer for resuming that session: the CLI finds
    a transcript by hashing the cwd into a project dir, so a resume spawned
    from the seat dir cannot see a session that started at the agent root. None
    here means no transcript exists — the session is not resumable, whatever
    the row remembers."""
    sid = (sid or "").strip()
    if not sid:
        return None
    try:
        hits = sorted((Path.home() / ".claude" / "projects").glob(f"*/{sid}.jsonl"))
    except OSError:
        return None
    for path in hits:
        try:
            with path.open() as fh:
                for _ in range(40):
                    line = fh.readline()
                    if not line:
                        break
                    cwd = (json.loads(line) or {}).get("cwd")
                    if cwd:
                        return Path(cwd)
        except (OSError, json.JSONDecodeError, ValueError, AttributeError):
            continue
    return None


def _session_cwd() -> "Path|None":
    """The calling session's own workspace."""
    return _cwd_of_session(os.environ.get("CLAUDE_CODE_SESSION_ID", ""))


def sender_seat() -> "str|None":
    """The calling session's seat: an override, then cwd, then its workspace."""
    env = os.environ.get("JSTACK_MAIL_FROM", "").strip()
    if env:
        return env
    return _seat_of(Path.cwd()) or _seat_of(_session_cwd())


# ---------------------------------------------------------------- attachments


def _stash_attachments(paths: list, seat_dir: Path, agent_dir: "Path|None" = None) -> list:
    """Copy each file into the receiving seat's pad and return the new paths.

    The receiver must be able to open an attachment after the sender's own
    scratch is gone, so the bytes move to the receiver's side at send time.
    Same landing convention the share-sheet drop already uses: a stamped
    name in a pad the receiving agent owns.

    A file already **anywhere under the receiving agent's own tree** is
    recorded where it lies. The copy exists to make the file reachable by the
    receiver; one that is already inside their tree is already reachable, and
    copying it would leave two files and no fact about which is real. This is
    the share-sheet path: a drop lands in the agent's pad before any message
    is written."""
    if not paths:
        return []
    pad = seat_dir / "pad"
    try:
        pad.mkdir(parents=True, exist_ok=True)
    except OSError:
        pad = seat_dir
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    out = []
    for p in paths:
        src = Path(p).expanduser()
        if not src.is_file():
            _fail(f"--file {p}: no such file")
        try:
            rs = src.resolve()
            inside = rs.parent == pad.resolve()
            if not inside and agent_dir is not None:
                inside = agent_dir.resolve() in rs.parents
            if inside:
                out.append(str(rs))
                continue
        except OSError:
            pass
        dest = pad / f"{stamp}-{src.name}"
        n = 1
        while dest.exists():
            n += 1
            dest = pad / f"{stamp}-{n}-{src.name}"
        try:
            shutil.copy2(src, dest)
        except OSError as e:
            _fail(f"--file {p}: {e}")
        out.append(str(dest))
    return out


# -------------------------------------------------------------------- display


def _short(row, width: int = 78) -> str:
    subj = row["subject"]
    if len(subj) > width:
        subj = subj[:width - 1] + "…"
    return subj


def _row_header(row) -> str:
    bits = [f"[#{row['id']}]", f"from {row['from_seat']}", row["created_at"].replace("T", " ")]
    bits.append({"task": "TASK — unanswered", "answered": "task, answered",
                 "reply": "reply — not shown yet",
                 "inject": "issue comment — not shown yet"}.get(row["state"], "update"))
    if row["reply_to"]:
        bits.append(f"reply to #{row['reply_to']}")
    return " · ".join(bits)


def _render(row, full: bool = False) -> str:
    lines = [_row_header(row), f"  {_short(row)}"]
    if full:
        if row["body"]:
            lines.append("")
            lines.extend("  " + ln for ln in row["body"].splitlines())
        atts = json.loads(row["attachments"] or "[]")
        if atts:
            lines.append("")
            lines.append("  Attachments:")
            lines.extend(f"    {a}" for a in atts)
        if row["state"] == "answered":
            lines.append("")
            lines.append(f"  ✓ answered {(row['resolved_at'] or '').replace('T', ' ')}"
                         f" by {row['resolved_by'] or '?'}")
            if row["resolution"]:
                lines.extend("    " + ln for ln in row["resolution"].splitlines())
    return "\n".join(lines)


def _dump(rows, as_json: bool, full: bool = False) -> None:
    if as_json:
        print(json.dumps([dict(r) for r in rows], indent=2))
        return
    if not rows:
        print("(nothing)")
        return
    print("\n\n".join(_render(r, full=full) for r in rows))


# ------------------------------------------------------------------- delivery


#: How far back an unseen update is still news. Older than this it is not
#: shown to anyone — a note nobody read for a week is not worth a session's
#: attention, and silently ageing out is the only thing that guarantees the
#: mailbox cannot grow into a backlog.
UPDATE_TTL_DAYS = 7
UPDATE_MAX = 8


def unseen_updates(con, seat: str) -> list:
    """Updates this seat has not been shown yet, newest first, capped and aged.

    Reading them marks them seen — an update is delivered exactly once."""
    cutoff = (datetime.now() - timedelta(days=UPDATE_TTL_DAYS)).isoformat(timespec="seconds")
    return con.execute(
        "SELECT * FROM messages WHERE to_seat = ? AND state = 'update' "
        "AND created_at >= ? ORDER BY created_at DESC, id DESC LIMIT ?",
        (seat, cutoff, UPDATE_MAX)).fetchall()


def mark_seen(con, rows) -> None:
    ids = [r["id"] for r in rows]
    if not ids:
        return
    con.execute(f"UPDATE messages SET state='seen' WHERE id IN "
                f"({','.join('?' * len(ids))})", ids)
    con.commit()


def for_session(con, sid: str) -> list:
    """Session-addressed messages waiting on THIS session — never any other.

    Three kinds: a `task` this session must answer, a `reply` it asked for and
    has not been shown yet, and an `inject` — a GitHub comment on a task issue
    this session created, riding the reply's delivery but answered on the
    issue itself.

    The whole no-backlog guarantee is this one clause: a message nobody
    addressed to your session is not yours to discover, so no session can ever
    be ambushed by something that has been sitting around."""
    if not sid:
        return []
    return con.execute(
        "SELECT * FROM messages WHERE state IN ('task', 'reply', 'inject') "
        "AND bound_session = ? ORDER BY created_at, id", (sid,)).fetchall()


def _wake_prompt(row) -> str:
    atts = json.loads(row["attachments"] or "[]")
    parts = [
        f"[inbox:{row['id']}] Task from {row['from_seat']}. They are waiting on "
        f"your answer — do it now, then reply.",
        "",
        row["subject"],
    ]
    if row["body"]:
        parts += ["", row["body"]]
    if atts:
        parts += ["", "Attachments:"] + [f"  {a}" for a in atts]
    parts += [
        "",
        f'  msg reply {row["id"]} "what you did, or the answer they asked for"',
        "",
        "That reply is the whole point of this task and it goes back into the "
        "session that asked — not to a mailbox, to the conversation itself. So "
        "if the ask is unclear or you need one thing to do it, reply with that "
        "question: it reaches them the same way and they can answer it. "
        "Nothing else is expected of you: this is the only thing in your inbox, "
        "and when you have answered it there is nothing left.",
    ]
    return "\n".join(parts)


# There was a rung above the wake once: a host hook (`mail.deliver_live`) that
# found a live session of the seat and typed the task into it, to save the
# minute the wake costs and reuse a session whose context was already warm.
# It is gone, and the reason is worth keeping.
#
# Mail addresses a SEAT, and a seat is a chat dir — that is the rule that stops
# mail to a cockpit from hijacking cron workers. So every target the live rung
# could ever resolve was a conversation, and the session it picked was the
# most recently active one, which is by construction the one a person is
# typing in. It was not a delivery path that occasionally hit a human; it was
# aimed at them. In production it appended a task to a half-written question
# the operator was still typing, submitted the two as one message, and sent
# the session off to answer the sender instead of the person mid-sentence.
# Across its whole life it delivered exactly once, and that was the once.
#
# A task now books the wake and nothing else. The wake is headless by design —
# a fresh `claude --print` in the seat's workspace — so it disturbs no live
# session, and costs about a minute.


def seat_dir_for(seat: str) -> "Path|None":
    """'bob/chat' -> its workspace dir, or None if it is no longer a seat.

    The stored seat string is the identity; a wake has to be booked against a
    directory. A seat that has since been renamed away returns None rather
    than a path nothing boots in."""
    agent, _, submode = (seat or "").partition("/")
    root = _agent_dirs().get(agent.lower())
    if root is None or not submode:
        return None
    d = root / submode
    if _is_seat(d):
        return d
    if submode == "chat" and _is_seat(root):
        return root  # bare cockpit: the seat is the agent root itself
    return None


def _reply_prompt(row, parent) -> str:
    """The return leg, as a fork-resume of the session that asked.

    Only the wake path uses this — when the asking session takes the reply at
    its own stop, the hook writes that text instead. So this addresses a fork:
    a session holding the whole context of having asked, brought back for the
    one purpose of receiving the answer. It does not re-explain the errand.

    It has to say plainly that it IS a fork. The conversation it came from may
    still be open in front of a person, and a fork that assumes it is the only
    copy will redo work that is already done or answer someone who never asked
    it anything."""
    parts = [
        f"[inbox:{row['id']}] {row['from_seat']} answered the task you sent them "
        f"(#{parent['id']}). This is the reply you were waiting on.",
        "",
        f"You asked: {parent['subject']}",
        "",
        "They said:",
        row["subject"],
    ]
    if row["body"]:
        parts += ["", row["body"]]
    for att in json.loads(row["attachments"] or "[]"):
        parts.append(f"  attached: {att}")
    parts += [
        "",
        "You are a continuation of the conversation that sent that task, woken "
        "to receive the answer — not a fresh session, and not necessarily the "
        "only copy: the conversation you came from may still be open in front "
        "of somebody. So do the thing this answer unblocks and nothing else. "
        "Do not redo what is already above you, and do not re-report to a "
        "person who is sitting in the other copy watching you do it.",
        "",
        "If the answer settles it, the exchange is over — say nothing back; a "
        "message acknowledging a message is traffic, not work. If it does not, "
        f'`msg reply {row["id"]} "the one thing that was missing"` puts the '
        "follow-up into the same conversation on their side. This is a channel, "
        "not a one-shot.",
    ]
    return "\n".join(parts)


def _inject_prompt(row, repo: str, num: str, author: str) -> str:
    """A GitHub issue comment, as a fork-resume of the session that created
    the issue.

    Same shape as _reply_prompt and for the same reason: only the wake path
    uses this — a live creator session takes the comment at its own stop
    instead. So it addresses a fork of the conversation that filed the issue,
    and the answer path is the issue itself, not msg: the worker on the other
    end reads GitHub, not this table."""
    parts = [
        f"[inbox:{row['id']}] {author} commented on {repo}#{num} — the task "
        f"issue this conversation created.",
        "",
        "They said:",
        row["body"] or row["subject"],
        "",
        "You are a continuation of the conversation that created that issue, "
        "woken to receive this comment — not a fresh session, and not "
        "necessarily the only copy: the conversation you came from may still "
        "be open in front of somebody. Act only on what the comment needs.",
        "",
        "If it asks you something, or the work has gone wrong, answer on the "
        "issue itself — that is where the worker reads:",
        f'  gh issue comment {num} -R {repo} --body "…"',
        "",
        "Digest form, a few lines — what you decided, what you need, what is "
        "blocked. The operator reads these. If the comment is a progress note that "
        "needs nothing, take it and say nothing back — a comment acknowledging "
        "a comment is traffic, not work.",
    ]
    return "\n".join(parts)


#: How many turns a channel may run before it stops waking anyone. Two agents
#: can always find one more thing to say, and each turn is a spawned session on
#: a machine that runs unattended. Past this the messages still file and still
#: read — nothing is lost — but nobody is woken for them, which is the point at
#: which a conversation has to become work or stop.
MAX_CHANNEL_TURNS = 8

#: How long a reply waits for the asking session to come and take it before a
#: fork is woken to receive it. Long enough that a session still working its
#: turn wins the race; short enough that an idle one is not left holding an
#: answer nobody reads.
REPLY_WAKE_MINUTES = 3

#: How a wake time is written on the wire and read back off it. `_book_wake`
#: hands the scheduler this shape and returns it in `delivery`, which is what
#: gets stored on the row and printed back — so it is now parsed as well as
#: formatted, and the two halves have to agree in one place.
WAKE_FMT = "%Y-%m-%d %H:%M"


def _scheduler_home() -> "Path|None":
    """Where msg itself READS scheduler state (`msg check`) — never a place it
    invents for the child to book into.

    `mail.scheduler_home` when set, else the SCHEDULER_HOME the child would
    inherit, else None. None is not "wakes are off": on a machine configured
    by neither, the scheduler derives its own tree (JSTACK_ROOT, root.py) and
    its state dir is not home-shaped at all — so guessing a home here would
    read state from a place the daemon never used. _run_state degrades to
    "no record" instead, which is at least true."""
    home = _mail_config().get("scheduler_home")
    if home:
        return Path(home).expanduser()
    env = os.environ.get("SCHEDULER_HOME", "").strip()
    return Path(env).expanduser() if env else None


def _sched_argv(sub: list) -> "tuple|None":
    """(argv, env, cwd) for a scheduler.cli call, or None if wakes are off."""
    mail = _mail_config()
    if mail.get("wake") is False:
        return None
    plugin_root = Path(__file__).resolve().parent.parent
    env = os.environ.copy()
    env["PYTHONPATH"] = f"{plugin_root}:{env.get('PYTHONPATH', '')}".rstrip(":")
    home = mail.get("scheduler_home")
    if home:
        env["SCHEDULER_HOME"] = str(Path(home).expanduser())
    # No configured home → the child env rides untouched and scheduler.cli
    # resolves its own: the SCHEDULER_HOME it inherited, else the JSTACK_ROOT
    # derivation, else ~/.scheduler. That derivation is what turned the wake
    # real on an unconfigured machine — it used to land in a ~/.scheduler no
    # daemon read — and deriving a home HERE instead would be a second opinion
    # about the scheduler's tree, the exact drift the root migration removes.
    python = str(Path(mail.get("python") or sys.executable or "python3").expanduser())
    return [python, "-m", "scheduler.cli"] + sub, env, str(plugin_root)


def _tz_label(at: "datetime|str|None" = None) -> str:
    """The zone abbreviation for the instant being named — not for now.

    The machine's own zone (PDT, CET, …), because a hardcoded region name would
    lie to every install outside it. But a label reads as a fact about the time
    printed beside it, so it has to be computed AT that time: every caller here
    is naming a future wake, and one booked in August for a January morning is
    labelled PDT and fires in PST — an hour of apparent drift that is only the
    name being wrong.

    `at` is the wake in either form it exists in — the `WAKE_FMT` wall-clock
    string carried on the row, or the datetime it parses to. Both are naive
    local time, and `.astimezone()` on a naive value resolves the local offset
    for THAT instant rather than for now, which is the whole of the fix.

    A string that will not parse falls back to now's label: no worse than the
    bug this replaces, and not worth raising over a cosmetic suffix."""
    if isinstance(at, str):
        try:
            at = datetime.strptime(at.strip(), WAKE_FMT)
        except ValueError:
            at = None
    return (at or datetime.now()).astimezone().tzname() or "local time"


def _book_wake(seat: str, workspace: Path, prompt: str, name: str,
               at: "str|None" = None, resume: "str|None" = None) -> tuple:
    """Book a one-shot on the host scheduler — the wake. Default: one minute out.

    Returns (delivery, job_id); ('', '') if none could be booked.

    Not a new spawn path: the scheduler already owns 'run claude in this
    workspace with this context message, with a timeout, a model tier and a
    journal entry', and the wake lands on the schedule page like any other.

    `resume` fork-resumes that session instead of starting fresh — how a reply
    reaches the conversation that asked for it rather than a stranger who
    inherits the seat. The workspace must be where that session STARTED, since
    that is what names its transcript.

    The job is booked `--delete-after-run`: a spent one-shot is scheduler
    litter, not the record of the exchange. The record is the `messages` row,
    which nothing here deletes, and the timeline entry written at close."""
    built = _sched_argv([])
    if built is None:
        return "", ""
    _, env, cwd = built
    at = at or (datetime.now() + timedelta(minutes=1)).strftime(WAKE_FMT)
    sub = [
        "add-once",
        "--agent", seat.replace("/", "-"),
        "--at", at,
        "--workspace", str(workspace),
        "--message", prompt,
        "--name", name,
        "--category", _mail_config().get("category") or "inbox",
        "--delete-after-run",
        "--json",
    ]
    if resume:
        sub += ["--resume-session", resume]
    argv = _sched_argv(sub)[0]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30,
                           env=env, cwd=cwd)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"warning: wake could not be booked ({e})", file=sys.stderr)
        return "", ""
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or "").strip().splitlines()
        print(f"warning: wake could not be booked "
              f"({detail[-1] if detail else 'scheduler refused'})", file=sys.stderr)
        return "", ""
    try:
        job_id = (json.loads(r.stdout) or {}).get("id") or ""
    except (json.JSONDecodeError, ValueError, AttributeError):
        job_id = ""
    return f"spawned:{at}", job_id


def _cancel_wake(job_id: str) -> bool:
    """Drop a booked wake that is no longer needed — the reply got there first.

    Best effort by design: the job may already have fired and deleted itself,
    which is the same outcome from here."""
    built = _sched_argv(["rm", job_id])
    if not job_id or built is None:
        return False
    argv, env, cwd = built
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30,
                           env=env, cwd=cwd)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _run_state(job_id: str) -> dict:
    """What the scheduler knows about a booked wake, read straight off its state.

    {"known": bool, "running": bool, "session": str, "status": str}

    `known` false is genuinely "no record" — a wake not yet fired leaves no
    entry, and one that finished under `delete_after_run` has its entry removed
    with the job. It is never rendered as "nothing happened": the run journal
    outlives both, and is read here when the live state has let go."""
    out = {"known": False, "running": False, "session": "", "status": ""}
    home = _scheduler_home()
    if not job_id or home is None:
        return out
    try:
        st = json.loads((home / "state" / "scheduler" / "state.json").read_text())
        entry = st.get(job_id) or {}
    except (OSError, json.JSONDecodeError, ValueError, AttributeError):
        entry = {}
    if entry:
        out["known"] = True
        active = [r for r in entry.get("active_runs") or [] if r.get("session_id")]
        if active:
            out.update(running=True, session=active[-1]["session_id"], status="running")
            return out
        out["session"] = entry.get("last_session_id") or ""
        out["status"] = entry.get("last_status") or ""
        return out
    try:
        lines = (home / "state" / "scheduler" / "runs" / f"{job_id}.jsonl"
                 ).read_text().splitlines()
    except OSError:
        return out
    for line in reversed(lines):
        try:
            rec = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        if rec.get("session_id"):
            out.update(known=True, session=rec["session_id"],
                       status=rec.get("status") or "")
            return out
    return out


# ------------------------------------------------------------------- commands


def cmd_send(args) -> int:
    con = connect()
    frm = args.frm or sender_seat()
    if not frm:
        _fail("could not resolve the sending seat from cwd — pass --from agent/seat")
    agent, submode, seat_dir = resolve_seat(args.to, sender=frm)
    seat = f"{agent}/{submode}"

    content = (args.content or "").strip()
    if not content:
        _fail("empty message")
    subject, _, body = content.partition("\n")
    subject = subject.strip()[:200] or content[:200]
    body = body.strip()

    reply_to = args.reply_to
    thread_id = 0
    if reply_to:
        parent = con.execute("SELECT * FROM messages WHERE id = ?", (reply_to,)).fetchone()
        if not parent:
            _fail(f"--reply-to {reply_to}: no such message")
        thread_id = parent["thread_id"] or parent["id"]

    # The agent's own root. Climbing seat_dir back up past every submode part
    # breaks for a bare cockpit — the seat IS the agent root, and the climb
    # would step out of the tree — so ask the map that just resolved the
    # address instead.
    agent_dir = _agent_dirs().get(agent) or seat_dir
    atts = _stash_attachments(args.file or [], seat_dir, agent_dir)
    state = "task" if args.wake else "update"
    cur = con.execute(
        "INSERT INTO messages (created_at, from_seat, to_agent, to_seat, subject, "
        "body, attachments, wake, reply_to, thread_id, state, origin_session) "
        "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
        (now_iso(), frm, agent, seat, subject, body, json.dumps(atts),
         1 if args.wake else 0, reply_to, thread_id, state,
         os.environ.get("CLAUDE_CODE_SESSION_ID") or None))
    mid = cur.lastrowid
    if not thread_id:
        con.execute("UPDATE messages SET thread_id = ? WHERE id = ?", (mid, mid))
    con.commit()

    row = con.execute("SELECT * FROM messages WHERE id = ?", (mid,)).fetchone()

    # A reply is the return leg of an open channel and goes back to the session
    # that asked — a different delivery from a fresh message to a seat.
    parent = getattr(args, "channel_parent", None)
    if parent is not None:
        return _return_leg(con, row, seat, parent)

    if not args.wake:
        print(f"#{mid} → {seat} — update, lands in their next session")
        return 0

    # A task gets its own session — a headless wake, about a minute out. It is
    # never typed into a session someone is already in: see the note above
    # `seat_dir_for`. `bound_session` stays NULL until that session exists and
    # claims it; naming one before it has booted would be a guess, and this
    # column is what the whole no-ambush rule reads. A task that reaches nobody
    # is not filed to be found later; it is reported failed, because the sender
    # is the one waiting.
    delivery, job = _book_wake(seat, seat_dir, _wake_prompt(row),
                               f"inbox #{mid} → {seat}")
    if not delivery:
        con.execute("DELETE FROM messages WHERE id = ?", (mid,))
        con.commit()
        _fail(f"could not reach {seat} — no wake could be booked. "
              f"Nothing was filed: a task nobody is doing is not a message, and "
              f"leaving it to be found later is the backlog this refuses to make.",
              code=3)
    con.execute("UPDATE messages SET delivery = ?, wake_job = ? WHERE id = ?",
                (delivery, job, mid))
    con.commit()
    when = delivery.split(":", 1)[1]
    print(f"#{mid} → {seat} — session spawning at "
          f"{when} {_tz_label(when)}, tied to this one. Their reply comes "
          f"back here; `msg check {mid}` says where it has got to.")
    return 0


def _return_leg(con, row, seat: str, parent) -> int:
    """Deliver a reply to the SESSION that asked, not merely to its seat.

    A seat's next session is a different conversation: handing it an answer to
    a question it never asked is how a channel turns into a stranger's note. So
    the reply binds to `origin_session` and is delivered one of two ways —
    whichever gets there first, both correct:

      - that session is still running, and takes it at its next stop;
      - it has already exited, and the wake below fork-resumes it, so the
        answer arrives inside the conversation that wanted it.

    The race needs no liveness guess anywhere, which is the point: guessing
    which session is live is what broke this system once already."""
    mid = row["id"]
    target = (parent["origin_session"] or "").strip()
    work = _cwd_of_session(target) if target else None

    if work is None:
        # Either the asking side recorded no session (a host filing on a
        # human's behalf, a pre-channel row), or its transcript is gone. There
        # is no conversation left to answer into, so this degrades honestly to
        # news for the seat rather than pretending at a channel.
        why = ("no session was recorded on it" if not target
               else f"session {target[:8]} has no transcript left")
        print(f"#{mid} → {seat} — #{parent['id']}: {why}. Filed as an update; it "
              f"lands in their next session.")
        _log_exchange(con, parent, row)
        return 0

    con.execute("UPDATE messages SET state = 'reply', bound_session = ? WHERE id = ?",
                (target, mid))
    con.commit()
    turns = con.execute("SELECT COUNT(*) c FROM messages WHERE thread_id = ?",
                        (row["thread_id"],)).fetchone()["c"]
    if turns > MAX_CHANNEL_TURNS:
        print(f"#{mid} → {seat} — filed for session {target[:8]}, but this channel "
              f"is {turns} turns deep, so no wake was booked. They will see it if "
              f"that session stops again. {MAX_CHANNEL_TURNS} turns is where an "
              f"exchange has to become work or stop.")
        _log_exchange(con, parent, row)
        return 0

    # Further out than a task's wake, deliberately. The two paths are racing and
    # the live one is cheaper — it costs a hook call rather than a spawned
    # session — so the wake gives the asking session a few minutes to finish its
    # turn and take the answer itself before a fork is made to hand it over.
    at = (datetime.now() + timedelta(minutes=REPLY_WAKE_MINUTES)).strftime(WAKE_FMT)
    delivery, job = _book_wake(seat, work, _reply_prompt(row, parent),
                              f"reply #{mid} → {seat}", at=at, resume=target)
    con.execute("UPDATE messages SET delivery = ?, wake_job = ? WHERE id = ?",
                (delivery, job, mid))
    con.commit()
    if delivery:
        when = delivery.split(":", 1)[1]
        print(f"#{mid} → {seat} — answer bound to session {target[:8]}. It reaches "
              f"them at their next stop, or resumes that conversation at "
              f"{when} {_tz_label(when)}, whichever comes first.")
    else:
        # Not fatal the way a task's failed wake is: the message is an answer,
        # it is already bound to the right session, and that session picks it
        # up at its next stop. Only the resume fallback is lost.
        print(f"#{mid} → {seat} — answer bound to session {target[:8]}; no resume "
              f"wake could be booked, so it lands only if that session stops "
              f"again. Check with them if it matters.", file=sys.stderr)
    _log_exchange(con, parent, row)
    return 0


def _log_exchange(con, parent, reply) -> None:
    """Write the finished exchange into both seats' timelines, once.

    `messages` is the channel; the timeline is what a seat did. An exchange
    that was worth waking a session for is part of both seats' history, and
    without this the only trace that one agent asked another for something
    lives in a table neither of them reads by habit.

    Guarded by `logged_at` on the parent, and stamped only after the write
    lands — a failed write leaves the row unstamped so a later turn can still
    carry it, rather than silently swallowing the record."""
    fresh = con.execute("SELECT * FROM messages WHERE id = ?", (parent["id"],)).fetchone()
    if not fresh or fresh["logged_at"] or fresh["state"] != "answered":
        return
    asked, did = fresh["from_seat"], fresh["to_seat"]
    answer = (fresh["resolution"] or reply["subject"] or "").strip()
    pairs = [
        (asked, f"Asked {did} — {fresh['subject']}", fresh["origin_session"] or ""),
        (did, f"Answered {asked} — {fresh['subject']}", reply["origin_session"] or ""),
    ]
    log = str(Path(__file__).resolve().parent / "log_event")
    for seat, headline, sid in pairs:
        argv = [log, seat, headline[:300],
                "--detail", f"they got: {answer[:600]}" if seat == asked
                else f"answered: {answer[:600]}",
                "--detail", f"channel #{fresh['thread_id']} — msg thread {fresh['thread_id']}"]
        if sid:
            argv += ["--session", sid]
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            print(f"warning: timeline write for {seat} failed ({e})", file=sys.stderr)
            return
        if r.returncode != 0:
            print(f"warning: timeline write for {seat} failed "
                  f"({(r.stderr or '').strip()[:160]})", file=sys.stderr)
            return
    con.execute("UPDATE messages SET logged_at = ? WHERE id = ?", (now_iso(), fresh["id"]))
    con.commit()


def cmd_reply(args) -> int:
    """The next turn in a channel. Answering a task also closes it.

    There is no separate close verb and no `--wake` here: every reply reaches
    the other end's session, because that is what a channel is."""
    con = connect()
    parent = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not parent:
        _fail(f"no message #{args.id}")
    me = args.frm or sender_seat()
    content = (args.content or "").strip()
    if not content:
        _fail("empty reply")
    if parent["state"] == "task":
        con.execute(
            "UPDATE messages SET state='answered', resolution=?, resolved_at=?, "
            "resolved_by=? WHERE id = ?", (content, now_iso(), me or "?", args.id))
        con.commit()
    args.to = "@" + parent["from_seat"].replace("/", "-")
    args.reply_to = args.id
    args.frm = me
    args.wake = False
    args.channel_parent = parent
    return cmd_send(args)


def cmd_inject(args) -> int:
    """Plumbing: deliver a GitHub issue comment into the session that created
    the issue.

    The task system's creator leg. An issue filed by /task carries its
    creator's session id in the issue body; when the worker (or the operator)
    comments, the webhook calls this with that id and the comment. Delivery is
    the same race a reply runs — the creator session takes it at its next
    stop, or a wake fork-resumes it — because a comment on your issue is an
    answer to a question you asked, whatever channel it rode in on.

    Unlike a reply there is no msg thread: GitHub holds the conversation, the
    answer path is `gh issue comment`, and a dead creator session degrades to
    seat news instead of failing — the comment is already permanent on the
    issue, so nothing is lost by landing it in front of the seat's next
    session instead."""
    con = connect()
    sid = (args.session or "").strip()
    if not sid:
        _fail("inject: a creator session id is required")
    ref = (args.issue or "").strip()
    repo, _, num = ref.partition("#")
    if not repo or "/" not in repo or not num.isdigit():
        _fail(f"--issue {ref!r}: expected owner/repo#N")
    author = (args.author or "").strip() or "someone"
    content = (args.content or "").strip()
    if not content:
        _fail("empty comment")

    work = _cwd_of_session(sid)
    seat = (_seat_of(work) if work else None) or (args.seat or "").strip()
    subject = f"{ref} — {author} commented"

    if work is None:
        # The creating conversation is gone. The comment is already permanent
        # on the issue, so this degrades to news for the creator's seat —
        # whoever next sits down there picks the thread up on GitHub.
        if not seat:
            _fail(f"session {sid[:8]} has no transcript left and no --seat "
                  f"was given — nowhere to deliver")
        cur = con.execute(
            "INSERT INTO messages (created_at, from_seat, to_agent, to_seat, "
            "subject, body, state) VALUES (?,?,?,?,?,?,'update')",
            (now_iso(), f"github:{author}", seat.partition("/")[0], seat,
             subject, content))
        con.execute("UPDATE messages SET thread_id = ? WHERE id = ?",
                    (cur.lastrowid, cur.lastrowid))
        con.commit()
        print(f"#{cur.lastrowid} → {seat} — session {sid[:8]} has no "
              f"transcript left. Filed as an update; the thread lives on {ref}.")
        return 0

    if not seat:
        _fail(f"session {sid[:8]} started outside the agent tree ({work}) "
              f"and no --seat was given — nowhere to book the wake")

    cur = con.execute(
        "INSERT INTO messages (created_at, from_seat, to_agent, to_seat, "
        "subject, body, state, bound_session) VALUES (?,?,?,?,?,?,'inject',?)",
        (now_iso(), f"github:{author}", seat.partition("/")[0], seat,
         subject, content, sid))
    mid = cur.lastrowid
    con.execute("UPDATE messages SET thread_id = ? WHERE id = ?", (mid, mid))
    con.commit()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (mid,)).fetchone()

    # The same ceiling a channel has, per issue per session: past it the
    # comments still file and still show at that session's next stop, but
    # nobody is woken — two ends politely commenting back and forth is the
    # same runaway a msg channel can be, with a spawned session per turn.
    turns = con.execute(
        "SELECT COUNT(*) c FROM messages WHERE bound_session = ? "
        "AND subject LIKE ?", (sid, f"{ref} — %")).fetchone()["c"]
    if turns > MAX_CHANNEL_TURNS:
        print(f"#{mid} → {seat} — filed for session {sid[:8]}, but {ref} has "
              f"sent it {turns} comments, so no wake was booked. They see it "
              f"if that session stops again; the thread is on the issue.")
        return 0

    at = (datetime.now() + timedelta(minutes=REPLY_WAKE_MINUTES)).strftime(WAKE_FMT)
    delivery, job = _book_wake(seat, work, _inject_prompt(row, repo, num, author),
                               f"issue {ref} → {seat}", at=at, resume=sid)
    con.execute("UPDATE messages SET delivery = ?, wake_job = ? WHERE id = ?",
                (delivery, job, mid))
    con.commit()
    if delivery:
        when = delivery.split(":", 1)[1]
        print(f"#{mid} → {seat} — comment bound to session {sid[:8]}. It "
              f"reaches them at their next stop, or resumes that conversation "
              f"at {when} {_tz_label(when)}, whichever comes first.")
    else:
        print(f"#{mid} → {seat} — comment bound to session {sid[:8]}; no "
              f"resume wake could be booked, so it lands only if that session "
              f"stops again. The comment itself is safe on {ref}.",
              file=sys.stderr)
    return 0


def cmd_inbox(args) -> int:
    """Recent traffic for a seat — a report, never a work queue.

    Reading an inbox does not make anything yours. A task is yours only when
    it was handed to your session; everything else here is news."""
    con = connect()
    cutoff = (datetime.now() - timedelta(days=UPDATE_TTL_DAYS)).isoformat(timespec="seconds")
    where, params = "created_at >= ?", [cutoff]
    if args.agent:
        where += " AND to_agent = ?"
        params.append(args.agent.lstrip("@").lower())
    elif not args.all:
        seat = args.seat or sender_seat()
        if not seat:
            _fail("not in an agent seat — pass --seat agent/seat, --agent NAME, or --all")
        where += " AND to_seat = ?"
        params.append(seat)
    rows = con.execute(f"SELECT * FROM messages WHERE {where} AND state <> 'answered' "
                       f"ORDER BY created_at, id", params).fetchall()
    if not args.json and rows:
        tasks = sum(1 for r in rows if r["state"] == "task")
        note = f"{len(rows)} in the last {UPDATE_TTL_DAYS} days"
        print(f"{note} — {tasks} unanswered task(s), the rest are notes.\n"
              if tasks else f"{note}, all notes — nothing is waiting on anyone.\n")
    _dump(rows, args.json)
    return 0


def cmd_read(args) -> int:
    con = connect()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not row:
        _fail(f"no message #{args.id}")
    if args.json:
        print(json.dumps(dict(row), indent=2))
        return 0
    print(_render(row, full=True))
    sibs = con.execute(
        "SELECT COUNT(*) c FROM messages WHERE thread_id = ?", (row["thread_id"],)).fetchone()
    if sibs and sibs["c"] > 1:
        print(f"\n  ({sibs['c']} in this thread — msg thread {row['thread_id']})")
    return 0


def cmd_thread(args) -> int:
    con = connect()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not row:
        _fail(f"no message #{args.id}")
    rows = con.execute("SELECT * FROM messages WHERE thread_id = ? ORDER BY created_at, id",
                       (row["thread_id"],)).fetchall()
    _dump(rows, args.json, full=True)
    return 0


def cmd_sent(args) -> int:
    con = connect()
    frm = args.frm or sender_seat()
    if not frm:
        _fail("not in an agent seat — pass --from agent/seat")
    rows = con.execute(
        "SELECT * FROM messages WHERE from_seat = ? ORDER BY created_at DESC, id DESC "
        "LIMIT ?", (frm, args.n)).fetchall()
    _dump(list(reversed(rows)), args.json, full=True)
    return 0


def cmd_pending(args) -> int:
    """Hook helper: what this session must take before it stops. Exit 1 = none.

    Two ways something is addressed to a session: it was spawned for it (the
    run's prompt carries the id, and `--woken` is how the hook passes that
    along), or it is bound to the session id directly — a reply to what this
    session sent. Nothing else qualifies.

    A woken task is STAMPED here with the session that actually turned up for
    it, which is the tie between the two ends of a channel. Until it lands the
    sender knows only which wake it booked; after it lands they know the
    session, and `msg check` can say where the work went. A retried wake
    restamps: the answer to "who is doing this" is the session doing it now."""
    con = connect()
    sid = args.session or session_id()
    if sid and args.woken:
        con.execute("UPDATE messages SET bound_session = ? WHERE id = ? "
                    "AND state = 'task'", (sid, args.woken))
        con.commit()
    rows = list(for_session(con, sid))
    if args.woken and not any(str(r["id"]) == str(args.woken) for r in rows):
        extra = con.execute("SELECT * FROM messages WHERE id = ? AND state = 'task'",
                            (args.woken,)).fetchone()
        if extra:
            rows.append(extra)
    print(json.dumps([dict(r) for r in rows]))
    return 0 if rows else 1


def cmd_deliver(args) -> int:
    """Hook helper: record that a session was shown what was addressed to it.

    A `reply` (and an `inject` — same lifecycle, GitHub-shaped) is consumed by
    being shown — nothing is owed back, so being shown is its whole lifecycle,
    and the resume wake booked as its fallback is cancelled here because the
    faster path won the race.

    A `task` is NOT consumed. Only its answer closes it; this just stamps that
    it reached the session, so an unanswered task cannot be mistaken for an
    undelivered one."""
    con = connect()
    ids = [int(i) for i in args.ids]
    if not ids:
        return 1
    rows = con.execute(
        f"SELECT * FROM messages WHERE id IN ({','.join('?' * len(ids))})", ids).fetchall()
    for r in rows:
        con.execute("UPDATE messages SET consumed_at = ? WHERE id = ?",
                    (now_iso(), r["id"]))
        if r["state"] in ("reply", "inject"):
            con.execute("UPDATE messages SET state = 'seen' WHERE id = ?", (r["id"],))
            if r["wake_job"]:
                _cancel_wake(r["wake_job"])
    con.commit()
    return 0 if rows else 1


def cmd_check(args) -> int:
    """Where something you sent has got to — the sender's end of the channel.

    Answers three things a sender cannot otherwise see: which session took the
    task, whether it is still running, and whether the answer is back. It reads
    the scheduler's own state rather than inferring from the message row, so
    "their session finished and never answered" is a state it can actually
    report instead of showing an open task forever."""
    con = connect()
    row = con.execute("SELECT * FROM messages WHERE id = ?", (args.id,)).fetchone()
    if not row:
        _fail(f"no message #{args.id}")
    run = _run_state(row["wake_job"] or "")
    theirs = row["bound_session"] or run.get("session") or ""
    replies = con.execute(
        "SELECT * FROM messages WHERE reply_to = ? ORDER BY created_at, id",
        (row["id"],)).fetchall()

    if args.json:
        print(json.dumps({
            "id": row["id"], "to": row["to_seat"], "from": row["from_seat"],
            "state": row["state"], "subject": row["subject"],
            "your_session": row["origin_session"] or "",
            "their_session": theirs, "wake_job": row["wake_job"] or "",
            "wake": row["delivery"] or "", "run": run,
            "answer": row["resolution"] or "",
            "replies": [{"id": r["id"], "at": r["created_at"], "subject": r["subject"],
                         "delivered": bool(r["consumed_at"])} for r in replies],
        }, indent=2))
        return 0

    print(_render(row, full=True))
    print()
    print(f"  your session   {(row['origin_session'] or '(none recorded)')[:8]}")
    print(f"  their session  {theirs[:8] if theirs else '(not booted yet)'}"
          f"{'  — running now' if run.get('running') else ''}")
    if row["wake_job"]:
        when = (row["delivery"] or "").split(":", 1)[-1]
        print(f"  wake           job {row['wake_job'][:8]}"
              f"{f', booked {when} {_tz_label(when)}' if when else ''}")
    if row["state"] == "task":
        if not run.get("known"):
            print("  → not started yet. Nothing has run for it; the wake is still ahead.")
        elif run.get("running"):
            print("  → running now. The answer comes back to your session when it lands.")
        else:
            print(f"  → their session finished ({run.get('status') or 'unknown'}) and "
                  f"no answer came back. That is a real gap, not a slow reply — "
                  f"`msg read {row['id']}` and chase it or drop it.")
    elif row["state"] == "answered":
        got = [r for r in replies if r["state"] in ("reply", "seen")]
        shown = "delivered" if got and got[-1]["consumed_at"] else "on its way to you"
        print(f"  → answered. The reply is {shown} — msg thread {row['thread_id']}")
    return 0


def cmd_updates(args) -> int:
    """Hook helper: this seat's unseen updates, then mark them seen.

    Delivered exactly once. `--peek` reads without consuming, so a failed
    injection does not silently eat the news."""
    con = connect()
    rows = unseen_updates(con, args.seat)
    print(json.dumps([dict(r) for r in rows]))
    if rows and not args.peek:
        mark_seen(con, rows)
    return 0 if rows else 1


# ---------------------------------------------------------------------- parse


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="msg", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def _send_flags(sp):
        sp.add_argument("--file", action="append", metavar="PATH",
                        help="attach a file (copied into the receiver's pad)")
        sp.add_argument("--from", dest="frm", metavar="SEAT",
                        help="sending seat (default: inferred from cwd)")

    s = sub.add_parser("send", help="send a message to a seat")
    s.add_argument("to", metavar="@agent[-seat]")
    s.add_argument("content")
    s.add_argument("--reply-to", type=int, metavar="ID")
    s.add_argument("--wake", action="store_true",
                   help="a task: spawn them a session, tied to this one, and open a channel")
    _send_flags(s)
    s.set_defaults(func=cmd_send)

    # No --wake on a reply: every reply reaches the other end's session. That
    # is what a channel is, and a flag would imply it could be opted out of.
    r = sub.add_parser("reply", help="the next turn in a channel (and the close of a task)")
    r.add_argument("id", type=int)
    r.add_argument("content")
    _send_flags(r)
    r.set_defaults(func=cmd_reply, wake=False)

    i = sub.add_parser("inbox", help="open items for this seat")
    i.add_argument("--seat", metavar="agent/seat")
    i.add_argument("--agent", metavar="NAME", help="every seat of one agent")
    i.add_argument("--all", action="store_true", help="every seat, every agent")
    i.add_argument("--json", action="store_true")
    i.set_defaults(func=cmd_inbox)

    rd = sub.add_parser("read", help="one message in full")
    rd.add_argument("id", type=int)
    rd.add_argument("--json", action="store_true")
    rd.set_defaults(func=cmd_read)

    t = sub.add_parser("thread", help="the whole conversation")
    t.add_argument("id", type=int)
    t.add_argument("--json", action="store_true")
    t.set_defaults(func=cmd_thread)

    st = sub.add_parser("sent", help="what this seat sent, and what came of it")
    st.add_argument("-n", type=int, default=10)
    st.add_argument("--from", dest="frm", metavar="SEAT")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_sent)

    ck = sub.add_parser("check", help="where something you sent has got to")
    ck.add_argument("id", type=int)
    ck.add_argument("--json", action="store_true")
    ck.set_defaults(func=cmd_check)

    inj = sub.add_parser("inject", help="plumbing: deliver a GitHub issue "
                         "comment to the session that created the issue")
    inj.add_argument("session", metavar="SESSION_ID",
                     help="the creator session, from the issue-body marker")
    inj.add_argument("content", help="the comment body")
    inj.add_argument("--issue", required=True, metavar="OWNER/REPO#N")
    inj.add_argument("--author", default="", metavar="LOGIN")
    inj.add_argument("--seat", default="", metavar="agent/seat",
                     help="fallback seat when the transcript is gone "
                     "(the marker's creator-seat)")
    inj.set_defaults(func=cmd_inject)

    pd = sub.add_parser("pending-for",
                        help="hook helper: what this session must take before it stops")
    pd.add_argument("seat", nargs="?", default="")
    pd.add_argument("--session", metavar="SID", default="",
                    help="the asking session — a message binds to one session only")
    pd.add_argument("--woken", metavar="ID", default="",
                    help="the task this session was spawned for")
    pd.set_defaults(func=cmd_pending)

    dl = sub.add_parser("deliver", help="hook helper: mark ids as shown to a session")
    dl.add_argument("ids", nargs="+", metavar="ID")
    dl.set_defaults(func=cmd_deliver)

    up = sub.add_parser("updates-for", help="hook helper: a seat's unseen updates (consumes them)")
    up.add_argument("seat")
    up.add_argument("--peek", action="store_true", help="read without marking seen")
    up.set_defaults(func=cmd_updates)

    return p


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
