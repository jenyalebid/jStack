#!/usr/bin/env python3
"""log_event — the timeline: a single sqlite store, no rendered files.

Write:
    log_event <agent[/submode]> "<headline>" [--at HH:MM] [--date YYYY-MM-DD]
              [--detail "..."]... [--context "..."] [--origin direct|indirect]
              [--commit <sha>[@<repo>]]... [--pipeline-task <repo>#<issue>]
              [--session <id>]

Query / admin (first positional is the subcommand):
    log_event tail <agent[/submode]> [-n N | --sessions N] [--tag <name>] [--json]
    log_event tail --tag <name> [--sessions N]
        A seat's recent history, oldest→newest. -n counts ENTRIES; --sessions
        counts SESSIONS and returns every entry those sessions wrote (the
        window seat injection uses — one sitting is one unit, however many
        entries it logged). Seat form filters agent+submode; bare agent
        matches all its submodes. Human format includes verdict lines.
        With --tag and NO seat it is the same window over a subject instead
        of a seat — the last N sittings anyone had on X, seat named on each
        line. That is what a tagged session boots on.
    log_event grep "<substring>" [--seat <seat>] [--since YYYY-MM-DD] [--json]
    log_event recall <YYYY-MM-DD[..YYYY-MM-DD]> [<seat>|all] [--full] [--json]
    log_event show <id>
    log_event verdict <agent[/submode]> <shipped|drift|blocked|empty> --note "..."
        Stamp the seat's LATEST entry with an independent verdict (meta review's
        "do not repeat" loop). Verdicts ride tail/injection output.
    log_event tag list [--session <id>] | show <name> |
              new <name> --description "..." | set <name>... | unset <name>...
        A small shared vocabulary of subjects, related to SESSIONS. One seat
        spans several subjects and one subject spans several seats, so neither
        the seat nor the date answers "everything we did on X" — the tag does.
        Whoever writes the entry picks from `tag list`; minting is rare. `list`
        marks with `●` what the session in hand already carries.
        `--tag <name>` filters tail / grep / recall.

Origin marks who drove the session the entry came from: `direct` (a human at
the wheel) or `indirect` (cron/gateway/spawned work). Resolution: --origin
flag > JSTACK_TIMELINE_ORIGIN env > direct. Pre-origin rows read back as ''.

`--commit` links the entry to what it shipped. The entry says why the sitting
happened; the commit says what changed — the two halves of one event, kept in
the store that owns each. The sha is the link and the subject rides beside it,
read from git rather than retyped, so the timeline's own `grep` can find work
by what its commits said.

Store: {timeline_dir}/timeline.db (sqlite, WAL — concurrent writers safe).
Timeline dir: $JSTACK_TIMELINE_DIR, else root.timeline_dir() — {root}/Logs/
Timeline, which is ~/Logs/Timeline on an install that declares no root. Format
spec lives in the jstack rule `timeline.md`. Source is `agent` or
`agent/submode` — always pass the submode when the seat is known (e.g.
alpha/chat).

Self-contained: python3 stdlib only. No venv, no host imports.
"""
# PEP 604 annotations (str | None) are evaluated at def time without this —
# which crashes on the python3 a launchd/cron caller gets (macOS system 3.9),
# even though every interactive shell here resolves a modern one. Any host
# process may shell out to this binary; it must run on the old one.
from __future__ import annotations

import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
try:
    import root as _root
except ImportError:
    # Older install without root.py — the literal pre-root default still
    # answers, and answers identically on any machine that declares no root.
    _root = None

_VALID_VERDICTS = {"shipped", "drift", "blocked", "empty"}
_VALID_ORIGINS = {"direct", "indirect"}
_SUBCOMMANDS = {"tail", "verdict", "grep", "show", "recall", "tag"}

_SCHEMA = """
CREATE TABLE IF NOT EXISTS entries (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    date          TEXT NOT NULL,
    time          TEXT NOT NULL,
    agent         TEXT NOT NULL,
    submode       TEXT NOT NULL DEFAULT '',
    headline      TEXT NOT NULL,
    details       TEXT NOT NULL DEFAULT '[]',
    pipeline_task TEXT,
    session_id    TEXT,
    verdict       TEXT,
    verdict_note  TEXT,
    context       TEXT NOT NULL DEFAULT '',
    origin        TEXT NOT NULL DEFAULT '',
    commits       TEXT NOT NULL DEFAULT '[]',
    created_at    TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_entries_seat ON entries(agent, submode, date, time);
CREATE INDEX IF NOT EXISTS idx_entries_date ON entries(date, time);

CREATE TABLE IF NOT EXISTS tags (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL DEFAULT '',
    created_at  TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS session_tags (
    session_id  TEXT NOT NULL,
    tag_id      INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
    created_at  TEXT NOT NULL,
    PRIMARY KEY (session_id, tag_id)
);
CREATE INDEX IF NOT EXISTS idx_session_tags_tag ON session_tags(tag_id);
"""


def timeline_dir() -> Path:
    """The db's home, asked of root so every writer gets the same answer.

    No config file is read here on purpose: this tool is shelled out to by
    hooks, crons and spawns, and a second opinion about which config is
    authoritative is what forked the location in the first place. A host that
    moves the timeline exports JSTACK_TIMELINE_DIR (or JSTACK_ROOT) to the
    processes that write it — which the session-end engine already does.
    """
    env = os.environ.get("JSTACK_TIMELINE_DIR", "").strip()
    if env:
        return Path(env).expanduser()
    if _root is not None:
        return _root.timeline_dir()
    return Path.home() / "Logs" / "Timeline"


def db_path() -> Path:
    root = timeline_dir()
    root.mkdir(parents=True, exist_ok=True)
    return root / "timeline.db"


def connect() -> sqlite3.Connection:
    con = sqlite3.connect(db_path(), timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.executescript(_SCHEMA)
    # in-place upgrade for dbs created before a column existed
    cols = {r[1] for r in con.execute("PRAGMA table_info(entries)")}
    if "context" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN context TEXT NOT NULL DEFAULT ''")
    if "origin" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN origin TEXT NOT NULL DEFAULT ''")
    if "commits" not in cols:
        con.execute("ALTER TABLE entries ADD COLUMN commits TEXT NOT NULL DEFAULT '[]'")
    return con


def default_origin() -> str:
    """Env default for unattended plumbing; anything unrecognized → direct.
    A bad env value must never block a write — origin is metadata."""
    env = os.environ.get("JSTACK_TIMELINE_ORIGIN", "").strip().lower()
    return env if env in _VALID_ORIGINS else "direct"


def parse_source(source: str) -> tuple[str, str]:
    """'alpha/chat' → ('alpha', 'chat'); 'alpha' → ('alpha', '')."""
    source = source.strip().strip("/")
    if "/" in source:
        agent, submode = source.split("/", 1)
        return agent.strip(), submode.strip()
    return source, ""


_WRITE_VERBS = {"add", "append", "write", "log", "record", "entry", "new"}
_SEAT_RE = re.compile(r"[a-z][a-z0-9_.-]*(/[a-z0-9][a-z0-9_./-]*)?")


def _seat_error(source: str, rest: list[str]) -> str | None:
    """Reject a non-seat first positional before it becomes a timeline agent.

    Every observed corruption shape lands here: a hallucinated write verb
    ('log_event add alpha/chat ...' — the verb becomes the agent and the real
    seat is swallowed into the headline), a flag promoted to agent
    ('log_event --at ...'), or a token outside the seat charset."""
    if source.startswith("-"):
        return (f"log_event: '{source}' is not a seat — a write starts with "
                f"agent[/submode], flags come after.\n{_write_usage()}")
    if source in _WRITE_VERBS:
        hint = ""
        if rest:
            tok = rest[0].split()[0] if rest[0].split() else ""
            if _SEAT_RE.fullmatch(tok):
                hint = f'\n  did you mean: log_event {tok} "<headline>" ...'
        return (f"log_event: no '{source}' subcommand — a write has no verb, "
                f"it starts with the seat itself.{hint}\n{_write_usage()}")
    if not _SEAT_RE.fullmatch(source.strip().strip("/")):
        return (f"log_event: '{source}' is not a valid seat "
                f"(agent[/submode], lowercase).\n{_write_usage()}")
    return None


def format_source(agent: str, submode: str) -> str:
    return f"{agent}/{submode}" if submode else agent


def _clean_details(details: list[str] | None) -> list[str]:
    out = []
    for d in details or []:
        d = d.strip()
        if not d:
            continue
        if d.startswith("- "):
            d = d[2:].strip()
        out.append(" ".join(d.split()))
    return out


# ------------------------------------------------------------------- commits
#
# An entry and a commit are two halves of one event. The entry says why the
# sitting happened and what it means for the next one; the commit says what
# changed. Neither belongs inside the other — a timeline that carried diffs
# would stop being readable, and a commit message cannot explain a sitting that
# shipped nothing. So the entry carries the LINK, and just enough of the commit
# to be findable: its sha and its subject.
#
# The subject is read from git, never taken from the caller. A writer retyping
# its own commit message drifts from what the commit actually says the moment
# either is edited, and a link whose text disagrees with its target is worse
# than a bare sha. Git is on the same disk; asking it costs one subprocess on a
# path that runs a few times a session.

#: Absolute — a hook or launchd caller has no useful PATH, and resolving the
#: wrong `git` would be a silent wrong answer rather than a missing one.
_GIT = "/usr/bin/git"

#: A local `git show` on a warm repo is milliseconds. The bound exists so a
#: wedged git (a lock held by a concurrent session in the shared tree) costs
#: the link and not the entry.
_GIT_TIMEOUT = 10


def _git(repo: str, *args: str) -> str | None:
    try:
        proc = subprocess.run([_GIT, "-C", repo, *args], capture_output=True,
                              text=True, timeout=_GIT_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    return proc.stdout.strip() if proc.returncode == 0 else None


def resolve_commit(ref: str) -> dict | None:
    """One `--commit` value → `{sha, repo, subject}`, read out of git.

    `<sha>` resolves in the current directory; `<sha>@<repo>` in that checkout
    — the form `/jstack:push` uses, since it commits with `git -C <root>` and
    already knows which root each sha belongs to.

    An unresolvable ref keeps its sha with an empty subject and warns on
    stderr. It must never fail the write: the link is metadata, and the same
    rule origin follows applies — losing the entry to save the link inverts
    which one matters. A bare sha still points at something a person can look
    up; a lost entry is gone.
    """
    ref = (ref or "").strip()
    if not ref:
        return None
    sha, _, repo = ref.partition("@")
    sha = sha.strip()
    repo = repo.strip() or os.getcwd()
    if not sha:
        return None

    out = _git(repo, "show", "-s", "--format=%H%x1f%s", sha)
    if out is None or "\x1f" not in out:
        print(f"log_event: could not resolve commit {ref!r} — storing the sha "
              f"alone, with no subject", file=sys.stderr)
        return {"sha": sha, "repo": "", "subject": ""}
    full, _, subject = out.partition("\x1f")
    top = _git(repo, "rev-parse", "--show-toplevel") or ""
    return {"sha": full.strip(), "repo": Path(top).name if top else "",
            "subject": " ".join(subject.split())}


def _clean_commits(refs: list[str] | None) -> list[dict]:
    """Resolve each ref once, in the order given, first mention winning.

    Deduped on the resolved sha rather than the ref as typed: the same commit
    reached as a short sha and as a full one is one commit, and an entry
    claiming it twice would double-count in every reader downstream."""
    out: list[dict] = []
    seen = set()
    for ref in refs or []:
        c = resolve_commit(ref)
        if c is None or c["sha"] in seen:
            continue
        seen.add(c["sha"])
        out.append(c)
    return out


def _load_commits(raw: str) -> list[dict]:
    """Read the column back. Defensive because a store predating the column
    reads as '' through any connection that did not go through `connect()`."""
    try:
        val = json.loads(raw or "[]")
    except (json.JSONDecodeError, TypeError):
        return []
    return [c for c in val if isinstance(c, dict) and c.get("sha")]


def format_commits(commits: list[dict]) -> list[str]:
    """One line per commit — short sha, repo, subject. The display shape for
    `show` and `recall --full`; deliberately absent from `format_tail`, which
    is what every session boots on and stays prose."""
    lines = []
    for c in commits:
        where = f" {c['repo']}" if c.get("repo") else ""
        what = f" {c['subject']}" if c.get("subject") else ""
        lines.append(f"{c['sha'][:8]}{where}{what}".rstrip())
    return lines


# --------------------------------------------------------------------- writes

def _clamp_future(day: str, ts: str) -> tuple[str, str]:
    """The timeline records what happened — a stamp in the future is always a
    writer error (the classic: HH:MM or date copied from a UTC transcript
    timestamp). Future date → today, stamped now. Same-day future time (2-min
    grace) → now. Past days pass through untouched (legit late logging)."""
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    if day > today:
        return today, now.strftime("%H:%M")
    if day == today:
        h, m = ts.split(":")
        if int(h) * 60 + int(m) > now.hour * 60 + now.minute + 2:
            return day, now.strftime("%H:%M")
    return day, ts


def append_timeline(source: str, text: str, day: str | None = None,
                    timestamp: str | None = None,
                    details: list[str] | None = None,
                    session_id: str | None = None,
                    context: str | None = None,
                    origin: str | None = None,
                    commits: list[dict] | None = None) -> None:
    if not source or not text:
        return
    d = day or datetime.now().strftime("%Y-%m-%d")
    ts = timestamp or datetime.now().strftime("%H:%M")
    d, ts = _clamp_future(d, ts)
    agent, submode = parse_source(source)
    con = connect()
    with con:
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, origin, commits, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, NULL, ?, ?, ?, ?, ?)",
            (d, ts, agent, submode, " ".join(text.split()),
             json.dumps(_clean_details(details), ensure_ascii=False),
             session_id, (context or "").strip(), origin or default_origin(),
             json.dumps(commits or [], ensure_ascii=False),
             datetime.now().isoformat(timespec="seconds")),
        )
    con.close()


def consolidate_pipeline_entry(source: str, task_tag: str, text: str,
                               day: str | None = None,
                               timestamp: str | None = None,
                               details: list[str] | None = None,
                               session_id: str | None = None,
                               context: str | None = None,
                               origin: str | None = None,
                               commits: list[dict] | None = None) -> None:
    """One live entry per pipeline task: replace all rows carrying the tag
    (tagged column, or legacy tag-in-text) with one block, earliest ts kept.

    Commits ACCUMULATE across the replacements, for the same reason the
    earliest timestamp survives them: a task's shipped work is the whole of it,
    not whatever the last session happened to touch. A replacement that dropped
    the earlier links would quietly unship them."""
    if not source or not task_tag or not text:
        return
    headline = " ".join(text.split())
    if task_tag not in headline:
        headline = f"{task_tag} — {headline}"
    d = day or datetime.now().strftime("%Y-%m-%d")
    d, _ = _clamp_future(d, "00:00")   # day first — the tag match below runs on it
    agent, submode = parse_source(source)

    con = connect()
    with con:
        matched = con.execute(
            "SELECT id, time, commits FROM entries WHERE date = ? AND"
            " (pipeline_task = ? OR headline LIKE ? OR details LIKE ?)",
            (d, task_tag, f"%{task_tag}%", f"%{task_tag}%"),
        ).fetchall()
        earliest = min((t for _, t, _ in matched), default=None)
        carried: list[dict] = []
        seen = set()
        for _, _, raw in matched:
            for c in _load_commits(raw):
                if c["sha"] not in seen:
                    seen.add(c["sha"])
                    carried.append(c)
        for c in commits or []:
            if c["sha"] not in seen:
                seen.add(c["sha"])
                carried.append(c)
        if matched:
            con.executemany("DELETE FROM entries WHERE id = ?",
                            [(i,) for i, _, _ in matched])
        final_ts = timestamp or earliest or datetime.now().strftime("%H:%M")
        _, final_ts = _clamp_future(d, final_ts)
        con.execute(
            "INSERT INTO entries (date, time, agent, submode, headline, details,"
            " pipeline_task, session_id, context, origin, commits, created_at)"
            " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (d, final_ts, agent, submode, headline,
             json.dumps(_clean_details(details), ensure_ascii=False),
             task_tag, session_id, (context or "").strip(),
             origin or default_origin(),
             json.dumps(carried, ensure_ascii=False),
             datetime.now().isoformat(timespec="seconds")),
        )
    con.close()


def set_verdict(seat: str, verdict: str, note: str) -> str | None:
    """Stamp the seat's latest entry. Returns the stamped headline, or None."""
    agent, submode = parse_source(seat)
    con = connect()
    with con:
        where = "agent = ?" + (" AND submode = ?" if submode else "")
        params: tuple = (agent, submode) if submode else (agent,)
        row = con.execute(
            f"SELECT id, headline FROM entries WHERE {where}"
            " ORDER BY date DESC, time DESC, id DESC LIMIT 1", params,
        ).fetchone()
        if row is None:
            return None
        con.execute("UPDATE entries SET verdict = ?, verdict_note = ? WHERE id = ?",
                    (verdict, note, row[0]))
    con.close()
    return row[1]


# -------------------------------------------------------------------- queries

_ENTRY_COLS = ("id, date, time, agent, submode, headline, details, verdict,"
               " verdict_note, session_id, context, origin, commits")

# A row with no session_id is its own session — legacy (pre-session) rows and
# any writer that omitted --session must not collapse into one giant bucket
# that eats the whole window.
_SESSION_KEY = "COALESCE(NULLIF(session_id, ''), 'entry:' || id)"


def _seat_filter(seat: str | None) -> tuple[str, tuple]:
    """(where, params) selecting a seat's rows — everything when seat is None.

    Seats are directories: a seat query matches its own dir plus every
    ancestor dir (social/chat also pulls social), never siblings — a chat
    seat's tail can't pick up a neighboring work dir's lineage. It also
    matches the agent's submode-less rows — entries migrated from the
    pre-seat era (and any bare-source writes). Bare agent = all submodes."""
    if seat is None:
        return "1 = 1", ()
    agent, submode = parse_source(seat)
    if not submode:
        return "agent = ?", (agent,)
    lineage = [submode]
    while "/" in lineage[-1]:
        lineage.append(lineage[-1].rsplit("/", 1)[0])
    lineage.append("")
    marks = ",".join("?" * len(lineage))
    return f"agent = ? AND submode IN ({marks})", (agent, *lineage)


def _entry_row(row: tuple) -> dict:
    eid, date, ts, a, s, h, dt, v, vn, sid, ctx, org, cms = row
    return {"id": eid, "date": date, "time": ts, "agent": a, "submode": s,
            "headline": h, "details": json.loads(dt),
            "verdict": v, "verdict_note": vn,
            "session_id": sid, "context": ctx, "origin": org,
            "commits": _load_commits(cms)}


def tail_entries(seat: str | None, n: int, origin: str | None = None,
                 tag: str | None = None) -> list[dict]:
    """Last n entries for a seat, oldest→newest.

    Broader (submode-less) rows age out of the last-n window as seat-tagged
    entries accrue; without them a seat would boot blind right after
    migration.

    `seat=None` drops the seat filter entirely — only meaningful with `tag`,
    and then it is the subject read: everything the op did on X, whichever
    agent did it.

    origin='direct' keeps only human-driven entries (auto/cron rows are
    origin='indirect'; pre-origin legacy '' rows count as direct). This is
    the injection view — a person sitting down reads the seat's worked
    narrative, not the auto flood's publish log."""
    where, params = _seat_filter(seat)
    if origin == "direct":
        where += " AND origin != 'indirect'"
    if tag:
        frag, tp = _tag_clause(tag)
        where += f" AND {frag}"; params = params + tp
    con = connect()
    rows = con.execute(
        f"SELECT {_ENTRY_COLS} FROM entries WHERE {where}"
        " ORDER BY date DESC, time DESC, id DESC LIMIT ?", params + (n,),
    ).fetchall()
    con.close()
    return [_entry_row(r) for r in reversed(rows)]


def tail_session_window(seat: str | None, sessions: int,
                        origin: str | None = None,
                        tag: str | None = None) -> list[dict]:
    """Every entry the seat's last `sessions` sessions wrote, oldest→newest.

    The window unit is the SESSION, not the entry — what a person sitting
    down wants is "the last ten times I sat here", and a session that wrote
    three entries is still one sitting. An entry-counted window silently
    shortens the recalled history whenever a session logs more than once
    (pipeline consolidations, multi-topic days), which is exactly when the
    history matters most. Rows with no session_id count as one session each
    (see _SESSION_KEY).

    `seat=None` with a `tag` is the same window over a SUBJECT instead of a
    seat: the last N sittings anyone had on X. That read is what a tagged
    session boots on, and it is deliberately not seat-bounded — two agents
    working one subject are one thread, not two.

    Session recency is its newest entry's timestamp; all of a chosen
    session's entries ride, and the returned entries stay in chronological
    order across sessions."""
    where, params = _seat_filter(seat)
    if origin == "direct":
        where += " AND origin != 'indirect'"
    if tag:
        frag, tp = _tag_clause(tag)
        where += f" AND {frag}"; params = params + tp
    con = connect()
    keys = [r[0] for r in con.execute(
        f"SELECT {_SESSION_KEY} AS skey FROM entries WHERE {where}"
        " GROUP BY skey ORDER BY MAX(date || ' ' || time) DESC, MAX(id) DESC"
        " LIMIT ?", params + (max(sessions, 0),),
    )]
    if not keys:
        con.close()
        return []
    marks = ",".join("?" * len(keys))
    rows = con.execute(
        f"SELECT {_ENTRY_COLS} FROM entries WHERE {where}"
        f" AND {_SESSION_KEY} IN ({marks}) ORDER BY date, time, id",
        params + tuple(keys),
    ).fetchall()
    con.close()
    return [_entry_row(r) for r in rows]


def format_tail(entries: list[dict], show_seat: bool = False) -> str:
    """Default tail text — what seat injection boots on. Lean by design:
    headline + bullets + verdict only; `context` never rides (on-demand via
    --json or `show`).

    `show_seat` names the seat on every line. Off for a seat read, where it
    would repeat the seat the caller just asked for; ON for a subject read,
    where "who did this" is the one thing the rows no longer have in common
    and an unlabelled block would read as one agent's own history."""
    lines = []
    for e in entries:
        who = f" [{format_source(e['agent'], e['submode'])}]" if show_seat else ""
        lines.append(f"{e['date']} {e['time']}{who} — {e['headline']}")
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
    return "\n".join(lines)


def grep_entries(pattern: str, seat: str | None = None,
                 since: str | None = None, tag: str | None = None) -> list[dict]:
    """Substring search (case-insensitive) over headline + details + context +
    linked commit subjects, across all days and seats — the recall surface for
    'when did we do X?'.

    Commit subjects are in scope because they are the half of the record that
    names the code: "when did we touch the lockout?" is answered by the commit
    that says so, and an entry findable only by its own prose would miss it."""
    esc = (pattern.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_"))
    like = f"%{esc}%"
    where = ["(headline LIKE ? ESCAPE '\\' OR details LIKE ? ESCAPE '\\'"
             " OR context LIKE ? ESCAPE '\\' OR commits LIKE ? ESCAPE '\\')"]
    params: list = [like, like, like, like]
    if tag:
        frag, tp = _tag_clause(tag)
        where.append(frag); params.extend(tp)
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode = ?"); params.append(submode)
    if since:
        where.append("date >= ?"); params.append(since)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, origin FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    return [{"id": i, "date": d, "time": t, "source": format_source(a, s),
             "headline": h, "origin": o} for i, d, t, a, s, h, o in rows]


def recall_entries(day_from: str, day_to: str, seat: str | None = None,
                   tag: str | None = None) -> list[dict]:
    """A day (or range) replayed — the recall surface for date questions
    ('what happened Monday?'), optionally narrowed to one seat. Same store,
    same seat semantics as tail (bare agent = all its seats).

    With `tag` and no seat this is the cross-agent question — "everything we
    did on X last month", however many agents and seats it took."""
    where = ["date >= ?", "date <= ?"]
    params: list = [day_from, day_to]
    if tag:
        frag, tp = _tag_clause(tag)
        where.append(frag); params.extend(tp)
    if seat:
        agent, submode = parse_source(seat)
        where.append("agent = ?"); params.append(agent)
        if submode:
            where.append("submode IN (?, '')"); params.append(submode)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, details, verdict,"
        " verdict_note, session_id, context, origin, commits FROM entries"
        f" WHERE {' AND '.join(where)} ORDER BY date, time, id", params,
    ).fetchall()
    con.close()
    out = []
    for i, d, t, a, s, h, dt, v, vn, sid, ctx, org, cms in rows:
        out.append({"id": i, "date": d, "time": t,
                    "source": format_source(a, s), "headline": h,
                    "details": json.loads(dt), "verdict": v,
                    "verdict_note": vn, "session_id": sid, "context": ctx,
                    "origin": org, "commits": _load_commits(cms)})
    return out


def format_recall(entries: list[dict], full: bool = False) -> str:
    """Block-shaped replay plus what tail never shows: ids, seat verdicts,
    and (with full) each entry's context."""
    blocks = []
    for e in entries:
        lines = [f"#{e['id']} {e['date']} {e['time']} [{e['source']}]",
                 e["headline"]]
        for d in e["details"]:
            lines.append(f"- {d}")
        if e["verdict"]:
            note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
            lines.append(f"  ↳ verdict: {e['verdict']}{note}")
        for c in format_commits(e.get("commits") or []):
            lines.append(f"  ▸ {c}")
        if full and e["context"]:
            lines.append(f"context:\n{e['context']}")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def show_entry(entry_id: int) -> dict | None:
    """Everything one entry holds — the on-demand loader behind a grep/tail hit."""
    con = connect()
    row = con.execute(
        "SELECT id, date, time, agent, submode, headline, details,"
        " pipeline_task, session_id, verdict, verdict_note, context, origin,"
        " commits FROM entries WHERE id = ?", (entry_id,),
    ).fetchone()
    con.close()
    if row is None:
        return None
    i, d, t, a, s, h, dt, pt, sid, v, vn, ctx, org, cms = row
    return {"id": i, "date": d, "time": t, "source": format_source(a, s),
            "headline": h, "details": json.loads(dt), "pipeline_task": pt,
            "session_id": sid, "verdict": v, "verdict_note": vn,
            "context": ctx, "origin": org, "commits": _load_commits(cms)}


# ---------------------------------------------------------------------- tags

# A tag is a coarse subject — what a stretch of work was ABOUT, across seats.
# One seat spans several subjects (a chat seat works the app, the infra, and
# the plugin in one week) and one subject spans several seats (two agents on
# the same app), so neither the seat nor the date answers "show me everything
# we did on X". The tag does.
#
# The relation is session→tag, not entry→tag. A session is one sitting with one
# subject; tagging each entry separately would ask the same question twice and
# let one sitting's entries disagree about what it was. Entries resolve their
# tags through `entries.session_id`.
_TAG_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


def normalize_tag(name: str) -> str:
    return name.strip().lower().lstrip("#")


def list_tags(session_id: str = "") -> list[dict]:
    """Every tag with its description, the seats that carry it, and how many
    sessions do.

    This is the vocabulary a writer reads before picking one, so the order IS
    the decision: the tags that already mean something are the ones seen first.
    "Mean something" is breadth, not depth — a tag is by definition a subject
    several sessions share ACROSS seats, so the rank is the number of distinct
    seats that have filed under it, session count only breaking a tie.

    Depth alone would let one recurring job own the top of the list. A nightly
    reuses its subject tag every run — by design, that IS the tag — so ranking
    on raw session count grows that one tag without bound and buries the
    cross-cutting subjects a picker most needs to see. Breadth is immune to
    cadence: a job hammering one tag from its single seat counts once, however
    many nights it runs. The session count is still carried and shown; it just
    no longer decides the order (issue #3).

    With `session_id`, each row also says whether THAT session already carries
    the tag (`carried`). The vocabulary and the session's own membership are
    the same question asked at the same moment — a picker that shows the list
    without saying which is already on invites re-setting what is set."""
    con = connect()
    rows = con.execute(
        "SELECT t.name, t.description,"
        " COUNT(DISTINCT e.agent || '/' || e.submode) AS seats,"
        " COUNT(DISTINCT st.session_id) AS sessions, t.created_at"
        " FROM tags t"
        " LEFT JOIN session_tags st ON st.tag_id = t.id"
        " LEFT JOIN entries e ON e.session_id = st.session_id"
        " GROUP BY t.id"
        " ORDER BY seats DESC, sessions DESC, t.name",
    ).fetchall()
    mine: set[str] = set()
    if session_id:
        mine = {r[0] for r in con.execute(
            "SELECT t.name FROM session_tags st JOIN tags t ON t.id = st.tag_id"
            " WHERE st.session_id = ?", (session_id,)).fetchall()}
    con.close()
    return [{"name": n, "description": d, "seats": seats, "sessions": sess,
             "created_at": ca, "carried": n in mine}
            for n, d, seats, sess, ca in rows]


def create_tag(name: str, description: str) -> str | None:
    """Mint a tag. Returns an error string, or None on success.

    The description is required and that is the whole point of the gate: a
    tag nobody can read is a tag nobody else will match against, so the
    vocabulary splits into synonyms and the relation stops answering the
    question it exists for. Minting should be rare; it costs a sentence."""
    name = normalize_tag(name)
    if not _TAG_RE.fullmatch(name):
        return (f"'{name}' is not a tag name — lowercase letters, digits and "
                "hyphens, starting with a letter or digit")
    description = " ".join(description.split())
    if not description:
        return (f"'{name}' needs --description: one line saying what work "
                "belongs under it, so the next writer can match against it")
    con = connect()
    try:
        with con:
            con.execute(
                "INSERT INTO tags (name, description, created_at) VALUES (?,?,?)",
                (name, description, datetime.now().isoformat(timespec="seconds")))
    except sqlite3.IntegrityError:
        con.close()
        return f"tag '{name}' already exists"
    con.close()
    return None


def describe_tag(name: str, description: str) -> str | None:
    """Rewrite what a tag is for. Returns an error string, or None.

    The description is the part of a tag that was always meant to move. A
    subject's boundary is learned by working it, so the sentence written at
    mint time is a first guess — and leaving a wrong one standing costs more
    than a typo, because it is what every later session matches against."""
    name = normalize_tag(name)
    description = " ".join(description.split())
    if not description:
        return (f"'{name}' needs --description: a tag whose description is "
                "blank is one nobody can match against")
    con = connect()
    with con:
        changed = con.execute("UPDATE tags SET description = ? WHERE name = ?",
                              (description, name)).rowcount
    con.close()
    return None if changed else f"no tag '{name}'"


def rename_tag(old: str, new: str) -> str | None:
    """Move a tag's name, keeping every session filed under it.

    Sessions reach a tag through `tag_id`, never its name, so the whole
    relation rides a rename untouched. That is the reason renaming is the
    safe repair for a misnamed subject and deleting is not — a delete throws
    the filings away, a rename carries them."""
    old, new = normalize_tag(old), normalize_tag(new)
    if not _TAG_RE.fullmatch(new):
        return (f"'{new}' is not a tag name — lowercase letters, digits and "
                "hyphens, starting with a letter or digit")
    if old == new:
        return None
    con = connect()
    try:
        with con:
            changed = con.execute("UPDATE tags SET name = ? WHERE name = ?",
                                  (new, old)).rowcount
    except sqlite3.IntegrityError:
        con.close()
        return f"tag '{new}' already exists"
    con.close()
    return None if changed else f"no tag '{old}'"


def delete_tag(name: str, force: bool = False) -> tuple[int, str | None]:
    """Retire a tag. Returns (sessions it unfiles, error string or None).

    This is the one tag edit that destroys something. The sittings filed
    under it lose the filing and nothing anywhere remembers they carried it,
    so a carried tag refuses without `force` and reports the count it would
    unfile — the caller decides holding the number, which is the same bargain
    a confirmation dialog strikes.

    `session_tags.tag_id` declares ON DELETE CASCADE, but sqlite honors that
    only under `PRAGMA foreign_keys=ON`, which `connect` does not set.
    Membership goes explicitly here; trusting the declaration would leave
    rows pointing at a tag id that no longer exists."""
    name = normalize_tag(name)
    con = connect()
    row = con.execute("SELECT id FROM tags WHERE name = ?", (name,)).fetchone()
    if not row:
        con.close()
        return 0, f"no tag '{name}'"
    tag_id = row[0]
    carried = con.execute("SELECT COUNT(*) FROM session_tags WHERE tag_id = ?",
                          (tag_id,)).fetchone()[0]
    if carried and not force:
        con.close()
        return carried, (f"tag '{name}' is carried by {carried} session"
                         f"{'' if carried == 1 else 's'} — pass --force to "
                         "delete it and unfile them")
    with con:
        con.execute("DELETE FROM session_tags WHERE tag_id = ?", (tag_id,))
        con.execute("DELETE FROM tags WHERE id = ?", (tag_id,))
    con.close()
    return carried, None


def tag_session(session_id: str, names: list[str]) -> tuple[list[str], list[str]]:
    """Attach existing tags to a session. Returns (attached, unknown).

    Unknown names are NOT auto-created. Picking from the list is the common
    path and minting is the rare one; a `set` that silently mints inverts
    that within a week."""
    wanted = [normalize_tag(n) for n in names if normalize_tag(n)]
    con = connect()
    known = {n: i for n, i in con.execute("SELECT name, id FROM tags")}
    attached, unknown = [], []
    now = datetime.now().isoformat(timespec="seconds")
    with con:
        for n in wanted:
            if n not in known:
                unknown.append(n)
                continue
            con.execute("INSERT OR IGNORE INTO session_tags (session_id, tag_id,"
                        " created_at) VALUES (?,?,?)", (session_id, known[n], now))
            attached.append(n)
    con.close()
    return attached, unknown


def untag_session(session_id: str, names: list[str]) -> list[str]:
    """Detach tags from a session. A mistag with no way back is a debt."""
    removed = []
    con = connect()
    with con:
        for n in [normalize_tag(x) for x in names if normalize_tag(x)]:
            cur = con.execute(
                "DELETE FROM session_tags WHERE session_id = ? AND tag_id ="
                " (SELECT id FROM tags WHERE name = ?)", (session_id, n))
            if cur.rowcount:
                removed.append(n)
    con.close()
    return removed


def session_tags(session_id: str) -> list[str]:
    con = connect()
    rows = con.execute(
        "SELECT t.name FROM session_tags st JOIN tags t ON t.id = st.tag_id"
        " WHERE st.session_id = ? ORDER BY t.name", (session_id,)).fetchall()
    con.close()
    return [r[0] for r in rows]


def _tag_clause(tag: str) -> tuple[str, tuple]:
    """(where-fragment, params) keeping only entries whose session carries `tag`.

    Entries with no session_id can never match — there is nothing to resolve
    through. That is why writes fall back to the session env var."""
    return ("session_id IN (SELECT st.session_id FROM session_tags st"
            " JOIN tags t ON t.id = st.tag_id WHERE t.name = ?)",
            (normalize_tag(tag),))


def tag_exists(tag: str) -> bool:
    con = connect()
    row = con.execute("SELECT 1 FROM tags WHERE name = ?",
                      (normalize_tag(tag),)).fetchone()
    con.close()
    return row is not None


def tag_entries(tag: str, since: str | None = None) -> list[dict]:
    """Every entry under a tag, across seats and agents — the cross-agent
    surface ('all the payments work last month'), unbounded by seat or day."""
    where, params = _tag_clause(tag)
    clauses, ps = [where], list(params)
    if since:
        clauses.append("date >= ?"); ps.append(since)
    con = connect()
    rows = con.execute(
        "SELECT id, date, time, agent, submode, headline, session_id, origin"
        f" FROM entries WHERE {' AND '.join(clauses)} ORDER BY date, time, id",
        ps).fetchall()
    con.close()
    return [{"id": i, "date": d, "time": t, "source": format_source(a, s),
             "headline": h, "session_id": sid, "origin": o}
            for i, d, t, a, s, h, sid, o in rows]


# ------------------------------------------------------------------------ CLI

def _write_usage() -> str:
    return ('usage: log_event <agent[/submode]> "<headline>" [--at HH:MM] '
            '[--date YYYY-MM-DD] [--detail "..."]... [--context "..."] '
            '[--origin direct|indirect] [--commit <sha>[@<repo>]]... '
            '[--pipeline-task <tag>] [--session <id>]\n'
            '       (--at/--date default to now/today, machine-local — omit '
            'unless logging an earlier event;\n'
            '        --origin defaults from $JSTACK_TIMELINE_ORIGIN, else direct;\n'
            '        --commit repeats, one per sha shipped — subject is read '
            'from git, repo defaults to $PWD)\n'
            '   or: log_event tail <agent[/submode]> [-n N | --sessions N] '
            '[--tag <name>] [--json]\n'
            '   or: log_event tail --tag <name> [--sessions N]   '
            '(one subject, every seat)\n'
            '   or: log_event grep "<substring>" [--seat <agent[/submode]>] '
            '[--since YYYY-MM-DD] [--json]\n'
            '   or: log_event recall <YYYY-MM-DD[..YYYY-MM-DD]> '
            '[<agent[/submode]>|all] [--full] [--json]\n'
            '   or: log_event show <id>\n'
            '   or: log_event verdict <agent[/submode]> '
            '<shipped|drift|blocked|empty> --note "..."')


def _cmd_tail(rest: list[str]) -> int:
    seat, n, sessions, as_json, origin, tag = None, 10, None, False, None, None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "-n":
            n = int(rest[i + 1]); i += 2
        elif a == "--sessions":
            sessions = int(rest[i + 1]); i += 2
        elif a == "--tag":
            tag = rest[i + 1]; i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a == "--origin":
            origin = rest[i + 1]; i += 2
            if origin != "direct":
                print("log_event tail: --origin accepts only 'direct' "
                      "(the human-driven view; omit for all origins)",
                      file=sys.stderr)
                return 2
        elif a.startswith("-"):
            print(f"log_event tail: unknown flag {a}", file=sys.stderr)
            return 2
        elif seat is not None:
            print(f"log_event tail: one seat only (got {seat!r} and {a!r})",
                  file=sys.stderr)
            return 2
        else:
            seat = a; i += 1
    if not seat and not tag:
        # A seatless tail with no tag is "everything, ever" — never what
        # anyone meant, and on a real db it is thousands of rows.
        print("log_event tail: seat required (agent or agent/submode), or "
              "--tag <name> for a subject across seats", file=sys.stderr)
        return 2
    if tag and not tag_exists(tag):
        # Silence here reads as "that seat never worked on it", which is a
        # different and much more misleading answer than "no such tag".
        print(f"log_event tail: no tag '{normalize_tag(tag)}' — see "
              "`log_event tag list`", file=sys.stderr)
        return 2
    if sessions is not None:
        entries = tail_session_window(seat, sessions, origin=origin, tag=tag)
    else:
        entries = tail_entries(seat, n, origin=origin, tag=tag)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_tail(entries, show_seat=seat is None))
    return 0


def _cmd_grep(rest: list[str]) -> int:
    pattern, seat, since, as_json, tag = None, None, None, False, None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--seat":
            seat = rest[i + 1]; i += 2
        elif a == "--since":
            since = rest[i + 1]; i += 2
        elif a == "--tag":
            tag = rest[i + 1]; i += 2
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event grep: unknown flag {a}", file=sys.stderr)
            return 2
        elif pattern is not None:
            print(f"log_event grep: one pattern only (got {pattern!r} and {a!r})"
                  " — quote multi-word patterns", file=sys.stderr)
            return 2
        else:
            pattern = a; i += 1
    if not pattern:
        print('log_event grep: pattern required (for a tag alone, '
              '`log_event tag show <name>`)', file=sys.stderr)
        return 2
    if tag and not tag_exists(tag):
        print(f"log_event grep: no tag '{normalize_tag(tag)}' — see "
              "`log_event tag list`", file=sys.stderr)
        return 2
    hits = grep_entries(pattern, seat=seat, since=since, tag=tag)
    if as_json:
        print(json.dumps(hits, ensure_ascii=False, indent=2))
    else:
        for h in hits:
            print(f"#{h['id']} {h['date']} {h['time']} [{h['source']}] {h['headline']}")
    return 0 if hits else 1


def _cmd_recall(rest: list[str]) -> int:
    dates, seat, full, as_json, tag = None, None, False, False, None
    pos: list[str] = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--tag":
            tag = rest[i + 1]; i += 2
        elif a == "--full":
            full = True; i += 1
        elif a == "--json":
            as_json = True; i += 1
        elif a.startswith("-"):
            print(f"log_event recall: unknown flag {a}", file=sys.stderr)
            return 2
        else:
            pos.append(a); i += 1
    if len(pos) > 2:
        print(f"log_event recall: too many arguments: {' '.join(pos[2:])}",
              file=sys.stderr)
        return 2
    if pos:
        dates = pos[0]
    if len(pos) >= 2 and pos[1] != "all":
        seat = pos[1]
    if not dates:
        print("log_event recall: date required (YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    day_from, _, day_to = dates.partition("..")
    day_to = day_to or day_from
    if not (re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_from)
            and re.fullmatch(r"\d{4}-\d{2}-\d{2}", day_to)):
        print(f"log_event recall: bad date '{dates}' (expected YYYY-MM-DD or "
              "YYYY-MM-DD..YYYY-MM-DD)", file=sys.stderr)
        return 2
    if tag and not tag_exists(tag):
        print(f"log_event recall: no tag '{normalize_tag(tag)}' — see "
              "`log_event tag list`", file=sys.stderr)
        return 2
    entries = recall_entries(day_from, day_to, seat=seat, tag=tag)
    if as_json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
    elif entries:
        print(format_recall(entries, full=full))
    return 0 if entries else 1


def _cmd_show(rest: list[str]) -> int:
    try:
        entry_id = int(rest[0])
    except (IndexError, ValueError):
        print("log_event show: numeric entry id required (from grep/tail --json)",
              file=sys.stderr)
        return 2
    e = show_entry(entry_id)
    if e is None:
        print(f"log_event show: no entry #{entry_id}", file=sys.stderr)
        return 1
    print(f"#{e['id']} {e['date']} {e['time']} [{e['source']}]")
    print(e["headline"])
    for d in e["details"]:
        print(f"- {d}")
    if e["pipeline_task"]:
        print(f"pipeline-task: {e['pipeline_task']}")
    if e["session_id"]:
        print(f"session: {e['session_id']}")
        tags = session_tags(e["session_id"])
        if tags:
            print(f"tags: {', '.join(tags)}")
    if e["origin"]:
        print(f"origin: {e['origin']}")
    if e["verdict"]:
        note = f" — {e['verdict_note']}" if e["verdict_note"] else ""
        print(f"↳ verdict: {e['verdict']}{note}")
    if e["commits"]:
        print("commits:")
        for line in format_commits(e["commits"]):
            print(f"  {line}")
    if e["context"]:
        print(f"context:\n{e['context']}")
    return 0


def _env_session() -> str:
    return (os.environ.get("CODEX_THREAD_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")).strip()


def _tag_usage() -> str:
    return ('usage: log_event tag list [--session <id>] [--json]\n'
            '       (with a session, `●` marks what that session carries)\n'
            '   or: log_event tag show <name> [--since YYYY-MM-DD] [--json]\n'
            '   or: log_event tag new <name> --description "what belongs here"\n'
            '   or: log_event tag describe <name> --description "..."\n'
            '   or: log_event tag rename <old> <new>   (sessions come along)\n'
            '   or: log_event tag delete <name> [--force]\n'
            '       (--force is required once any session carries it)\n'
            '   or: log_event tag set <name> [<name>...] [--session <id>]\n'
            '   or: log_event tag unset <name> [<name>...] [--session <id>]\n'
            '       (--session defaults to $CLAUDE_CODE_SESSION_ID)')


def _cmd_tag(rest: list[str]) -> int:
    if not rest:
        print(_tag_usage(), file=sys.stderr)
        return 2
    verb, rest = rest[0], rest[1:]
    as_json, since, description, session = False, None, "", None
    force = False
    pos: list[str] = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--json":
            as_json = True; i += 1
        elif a == "--force":
            force = True; i += 1
        elif a == "--since":
            since = rest[i + 1]; i += 2
        elif a in ("--description", "--desc"):
            description = rest[i + 1]; i += 2
        elif a == "--session":
            session = rest[i + 1]; i += 2
        elif a.startswith("-"):
            print(f"log_event tag: unknown flag {a}\n{_tag_usage()}", file=sys.stderr)
            return 2
        else:
            pos.append(a); i += 1

    if verb == "list":
        # The vocabulary, and — when a session is in hand — which of it that
        # session already carries. `●` is "already on this session"; a picker
        # reading the list needs both halves or it offers what is set.
        sid = (session or _env_session()).strip()
        tags = list_tags(sid)
        if as_json:
            print(json.dumps(tags, ensure_ascii=False, indent=2))
        elif not tags:
            print("no tags yet — log_event tag new <name> --description \"...\"")
        else:
            w = max(len(t["name"]) for t in tags)
            for t in tags:
                mark = ("● " if t["carried"] else "  ") if sid else ""
                print(f"{mark}{t['name']:<{w}}  {t['seats']:>2} seats  "
                      f"{t['sessions']:>4} sessions  {t['description']}")
        return 0

    if verb == "new":
        if len(pos) != 1:
            print(f"log_event tag new: one name\n{_tag_usage()}", file=sys.stderr)
            return 2
        err = create_tag(pos[0], description)
        if err:
            print(f"log_event tag new: {err}", file=sys.stderr)
            return 2
        print(f"tag '{normalize_tag(pos[0])}' created — {' '.join(description.split())}")
        return 0

    if verb == "describe":
        if len(pos) != 1:
            print(f"log_event tag describe: one name\n{_tag_usage()}", file=sys.stderr)
            return 2
        err = describe_tag(pos[0], description)
        if err:
            print(f"log_event tag describe: {err}", file=sys.stderr)
            return 2
        print(f"tag '{normalize_tag(pos[0])}' — {' '.join(description.split())}")
        return 0

    if verb == "rename":
        if len(pos) != 2:
            print(f"log_event tag rename: <old> <new>\n{_tag_usage()}", file=sys.stderr)
            return 2
        err = rename_tag(pos[0], pos[1])
        if err:
            print(f"log_event tag rename: {err}", file=sys.stderr)
            return 2
        print(f"tag '{normalize_tag(pos[0])}' is now '{normalize_tag(pos[1])}'")
        return 0

    if verb == "delete":
        if len(pos) != 1:
            print(f"log_event tag delete: one name\n{_tag_usage()}", file=sys.stderr)
            return 2
        unfiled, err = delete_tag(pos[0], force=force)
        if err:
            print(f"log_event tag delete: {err}", file=sys.stderr)
            return 2
        tail = (f" — {unfiled} session{'' if unfiled == 1 else 's'} unfiled"
                if unfiled else "")
        print(f"tag '{normalize_tag(pos[0])}' deleted{tail}")
        return 0

    if verb in ("set", "unset"):
        sid = (session or _env_session()).strip()
        if not sid:
            print("log_event tag: no session — pass --session <id> "
                  "($CLAUDE_CODE_SESSION_ID is unset, and a tag attached to "
                  "nothing is a tag nobody can query)", file=sys.stderr)
            return 2
        if not pos:
            print(f"log_event tag {verb}: at least one tag name\n{_tag_usage()}",
                  file=sys.stderr)
            return 2
        if verb == "unset":
            removed = untag_session(sid, pos)
            print(f"untagged {sid[:8]}: {', '.join(removed) or '<nothing matched>'}")
            return 0 if removed else 1
        attached, unknown = tag_session(sid, pos)
        if attached:
            print(f"tagged {sid[:8]}: {', '.join(attached)}")
        for u in unknown:
            print(f"log_event tag set: no tag '{u}' — pick one from "
                  "`log_event tag list`, or mint it with `log_event tag new "
                  f"{u} --description \"...\"` if nothing fits", file=sys.stderr)
        return 0 if attached and not unknown else 2

    if verb == "show":
        if len(pos) != 1:
            print(f"log_event tag show: one name\n{_tag_usage()}", file=sys.stderr)
            return 2
        name = normalize_tag(pos[0])
        if not tag_exists(name):
            print(f"log_event tag show: no tag '{name}'", file=sys.stderr)
            return 1
        hits = tag_entries(name, since=since)
        if as_json:
            print(json.dumps(hits, ensure_ascii=False, indent=2))
        else:
            for h in hits:
                print(f"#{h['id']} {h['date']} {h['time']} [{h['source']}] {h['headline']}")
        return 0 if hits else 1

    print(f"log_event tag: no '{verb}' verb\n{_tag_usage()}", file=sys.stderr)
    return 2


def _cmd_verdict(rest: list[str]) -> int:
    note = ""
    pos: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] == "--note":
            note = rest[i + 1]; i += 2
        else:
            pos.append(rest[i]); i += 1
    if len(pos) != 2 or pos[1] not in _VALID_VERDICTS:
        print(f"log_event verdict: need <agent[/submode]> <{'|'.join(sorted(_VALID_VERDICTS))}> --note",
              file=sys.stderr)
        return 2
    stamped = set_verdict(pos[0], pos[1], note)
    if stamped is None:
        print(f"log_event verdict: no entries for {pos[0]}", file=sys.stderr)
        return 1
    print(f"verdict[{pos[1]}] → {pos[0]}: {stamped[:80]}")
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(_write_usage(), file=sys.stderr)
        return 2

    if argv[0] in _SUBCOMMANDS:
        cmd, rest = argv[0], argv[1:]
        if cmd == "tail":
            return _cmd_tail(rest)
        if cmd == "grep":
            return _cmd_grep(rest)
        if cmd == "recall":
            return _cmd_recall(rest)
        if cmd == "show":
            return _cmd_show(rest)
        if cmd == "verdict":
            return _cmd_verdict(rest)
        if cmd == "tag":
            return _cmd_tag(rest)

    if len(argv) < 2:
        print(_write_usage(), file=sys.stderr)
        return 2

    source = argv[0]
    rest = argv[1:]
    seat_err = _seat_error(source, rest)
    if seat_err:
        print(seat_err, file=sys.stderr)
        return 2
    timestamp = day = pipeline_task = session_id = context = origin = None
    details: list[str] = []
    commit_refs: list[str] = []
    words: list[str] = []

    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--at":
            timestamp = rest[i + 1]; i += 2
        elif a == "--date":
            day = rest[i + 1]; i += 2
        elif a == "--pipeline-task":
            pipeline_task = rest[i + 1]; i += 2
        elif a == "--detail":
            details.append(rest[i + 1]); i += 2
        elif a == "--context":
            context = rest[i + 1]; i += 2
        elif a == "--session":
            session_id = rest[i + 1]; i += 2
        elif a == "--origin":
            origin = rest[i + 1]; i += 2
        elif a == "--commit":
            commit_refs.append(rest[i + 1]); i += 2
        elif a.startswith("-") and len(a) > 1:
            print(f"log_event: unknown flag {a} — supported: --at --date "
                  "--detail --context --origin --commit --pipeline-task "
                  "--session", file=sys.stderr)
            return 2
        else:
            words.append(a); i += 1

    text = " ".join(words)
    if timestamp and not re.fullmatch(r"\d{2}:\d{2}", timestamp):
        print(f"log_event: bad --at '{timestamp}' (expected HH:MM)", file=sys.stderr)
        return 2
    if day and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day):
        print(f"log_event: bad --date '{day}' (expected YYYY-MM-DD)", file=sys.stderr)
        return 2
    if origin and origin not in _VALID_ORIGINS:
        print(f"log_event: bad --origin '{origin}' (expected direct|indirect)",
              file=sys.stderr)
        return 2

    # A write with no session_id can never be reached by a tag — the relation
    # resolves entries through it — and 16% of a recent month's entries had
    # none, because an agent typing the write by hand does not think to pass
    # a uuid. The env var is the same session either way; the explicit flag
    # still wins, since a caller writing on behalf of another session knows
    # better than its own environment does.
    if not session_id:
        session_id = _env_session() or None

    commits = _clean_commits(commit_refs)

    label = day if day else "today"
    if pipeline_task:
        consolidate_pipeline_entry(source, pipeline_task, text, day=day,
                                   timestamp=timestamp, details=details,
                                   session_id=session_id, context=context,
                                   origin=origin, commits=commits)
        print(f"consolidated: {source} ({label}) [{pipeline_task}] {text[:80]}")
    else:
        append_timeline(source, text, day=day, timestamp=timestamp,
                        details=details, session_id=session_id, context=context,
                        origin=origin, commits=commits)
        print(f"logged: {source} ({label}) {text[:80]}")
    for line in format_commits(commits):
        print(f"  ▸ {line}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
